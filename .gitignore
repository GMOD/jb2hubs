# upload change-detection flags written by uploadAll.sh
*/.upload-changed

# converter-source stamps: which code built the tree that is on this machine.
# Not committed, because they describe a local built tree -- a checkout whose
# stamp disagreed with its own hubs/ would either skip a rebuild it needs or
# force one it does not. The ucsc equivalents live under UCSC_BUILT_DIR and are
# outside the repo already.
*/.pipeline_hash
*/.derivation_hash

# pending-deploy marker written by run.sh
/.deploy-pending

# vendored bed2gff Rust build output (source is committed, binary is not)
/bed2gff/target/

# astro sync artifacts at the repo root (website/ has its own rule)
.astro/
