{
  "semi": false,
  "singleQuote": true,
  "singleAttributePerLine": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "proseWrap": "always",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/",
    "**/.astro/",
    "**/.aws-sam/",
    "website/hubJson/",
    "website/processedHubJson/",
    "website/public/",
    "pangenome-build/build/",
    "genark2jbrowse/gff/",
    "bed2gff/",
    "pnpm-lock.yaml",
    "**/*.csi",
    "**/*.gz",
    "**/*.gff",
    "**/*.fa",
    "**/*.fasta",
    "**/*.over"
  ],
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react"],
        "modifiers": ["value"]
      }
    ],
    "groups": [
      ["side_effect", "side_effect_style"],
      "react",
      "value-builtin",
      "value-external",
      ["value-parent", "value-sibling", "value-index"],
      "type",
      "unknown"
    ],
    "newlinesBetween": true,
    "ignoreCase": false
  }
}
