{
  "name": "jbrowse-config-merger",
  "version": "1.0.0",
  "license": "MIT",
  "description": "AWS Lambda function to merge multiple JBrowse config files",
  "main": "index.js",
  "scripts": {
    "prebuild": "pnpm run clean",
    "clean": "rimraf dist",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.mjs",
    "test": "vitest",
    "precopy": "pnpm build",
    "copy": "cat dist/index.mjs | xclip -selection clipboard"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.13.2",
    "esbuild": "^0.27.7",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
