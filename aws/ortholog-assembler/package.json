{
  "name": "jbrowse-ortholog-assembler",
  "version": "1.0.0",
  "license": "MIT",
  "description": "AWS Lambda that assembles a gene's cross-species ortholog neighborhood (NCBI) and caches each result to S3",
  "main": "index.js",
  "scripts": {
    "prebuild": "pnpm run clean",
    "clean": "rimraf dist",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
