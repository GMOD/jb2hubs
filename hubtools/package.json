{
  "name": "hubtools",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./commonName": "./src/commonName.ts",
    "./lanePitch": "./src/lanePitch.ts",
    "./hubPath": "./src/hubPath.ts",
    "./guards": "./src/guards.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
      ".": "./dist/index.mjs",
      "./commonName": "./dist/commonName.mjs",
      "./lanePitch": "./dist/lanePitch.mjs",
      "./hubPath": "./dist/hubPath.mjs",
      "./guards": "./dist/guards.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "pnpm clean",
    "build": "tsdown --dts src/index.ts src/commonName.ts src/lanePitch.ts src/hubPath.ts src/guards.ts",
    "prepack": "pnpm build",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test src/*.test.ts",
    "preversion": "pnpm build",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@gmod/ucsc-hub": "^2.0.13"
  },
  "devDependencies": {
    "rimraf": "^6.1.4",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  }
}
