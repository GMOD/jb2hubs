{
  "name": "root",
  "type": "module",
  "license": "MIT",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fast": "oxlint --deny-warnings",
    "lint:sh": "find . -name '*.sh' -not -path '*/node_modules/*' -print0 | xargs -0 shellcheck",
    "format": "oxfmt . && prettier --write --log-level warn \"**/*.astro\"",
    "check-format": "oxfmt --check . && prettier --check \"**/*.astro\"",
    "format:sh": "find . -name '*.sh' -not -path '*/node_modules/*' -print0 | xargs -0 shfmt -w -i 2",
    "typecheck": "pnpm --filter website2 exec astro sync && tsc --noEmit",
    "check-config-compat": "node scripts/checkConfigCompat.mjs",
    "check-ucsc-outage": "node scripts/checkConfigCompat.mjs --offline-ucsc",
    "check-orphan-configs": "node scripts/checkOrphanConfigs.mjs",
    "check-plugin-urls": "node scripts/checkPluginUrls.mjs",
    "check-sidecar-urls": "node scripts/checkSidecarUrls.mjs",
    "check-tabix-indexes": "node scripts/checkTabixIndexes.mjs",
    "check-track-urls": "node scripts/checkTrackUrls.mjs",
    "check-pangenome-assets": "node scripts/checkPangenomeAssets.mjs",
    "build:bed2gff": "cargo build --release --manifest-path bed2gff/Cargo.toml",
    "check-pangenome-launches": "node scripts/checkPangenomeLaunches.mjs",
    "check-protein-launches": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/checkProteinLaunches.ts",
    "check-display-types": "node scripts/checkDisplayTypes.mjs"
  },
  "dependencies": {
    "@gmod/ucsc-hub": "^2.0.13",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "glob": "^13.0.6",
    "node-sql-parser": "^5.4.0",
    "p2s_mapper": "^1.2.0",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@jbrowse/cli": "5.0.0-beta.7",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier-plugin-astro": "^1.0.1",
    "puppeteer-core": "^25.11.0"
  }
}
