    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "fast-deep-equal": "^3.1.3",
    "glob": "^13.0.6",
    "node-sql-parser": "^5.4.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
