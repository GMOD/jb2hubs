{
  "name": "root",
  "type": "module",
  "license": "MIT",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "lint:sh": "find . -name '*.sh' -not -path '*/node_modules/*' -print0 | xargs -0 shellcheck",
    "format": "PRETTIER_EXPERIMENTAL_CLI=1 prettier --write .",
    "format:sh": "find . -name '*.sh' -not -path '*/node_modules/*' -print0 | xargs -0 shfmt -w -i 2",
    "typecheck": "tsc --noEmit",
    "build:bed2gff": "cargo build --release --manifest-path bed2gff/Cargo.toml"
  },
  "dependencies": {
    "@gmod/ucsc-hub": "^2.0.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "fast-deep-equal": "^3.1.3",
    "glob": "^13.0.6",
    "node-sql-parser": "^5.4.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier-plugin-astro": "^0.14.1"
  }
}
