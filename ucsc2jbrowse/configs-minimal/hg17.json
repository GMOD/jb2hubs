    {
      "type": "FeatureTrack",
      "trackId": "hg17-vegaPseudoGene",
      "name": "Vega Pseudogenes",
      "assemblyNames": ["hg17"],
      "adapter": {
        "type": "Gff3TabixAdapter",
        "gffGzLocation": {
          "uri": "vegaPseudoGene.gff.gz"
        },
        "index": {
          "indexType": "CSI",
