      "trackId": "loxAfr3-rmsk",
      "name": "RepeatMasker",
      "assemblyNames": ["loxAfr3"],
      "adapter": {
        "type": "BedTabixAdapter",
        "bedGzLocation": {
          "uri": "rmsk.bed.gz"
        },
        "index": {
          "indexType": "CSI",
