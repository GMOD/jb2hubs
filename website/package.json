{
  "name": "website2",
  "license": "MIT",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf dist",
    "generate-taxonomy": "./taxonomyBuilder/generate_taxonomy.sh",
    "generate-recently-updated": "node generateRecentlyUpdated.ts",
    "generate-search-index": "node generateSearchIndex.ts",
    "generate-hub-data": "node generateHubData.ts",
    "generate-taxonomy-filter": "node generateTaxonomyFilter.ts",
    "generate-synteny-accessions": "node generateSyntenyAccessions.ts",
    "generate-ortholog-index": "node generateOrthologIndex.ts",
    "generate-synteny-pair-index": "node generateSyntenyPairIndex.ts",
    "generate-synteny-stars": "node generateSyntenyStars.ts",
    "generate": "pnpm generate-recently-updated && pnpm generate-hub-data && pnpm generate-search-index && pnpm generate-taxonomy-filter && pnpm generate-synteny-accessions && pnpm generate-ortholog-index && pnpm generate-synteny-pair-index && pnpm generate-synteny-stars",
    "prebuild": "pnpm clean && pnpm generate-taxonomy && pnpm generate",
    "predev": "aws s3 sync s3://jbrowse.org/processedHubJson/ processedHubJson/ && pnpm generate",
    "dev": "astro dev",
    "build": "./astroBuild.sh",
    "build:fast": "./astroBuild.sh",
    "build:staging": "pnpm prebuild && ./astroBuild.sh --mode staging",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test 'src/**/*.test.ts'",
    "deploy": "pnpm sync",
    "predeploy": "pnpm build",
    "sync": "./deploy.sh",
    "deploy:staging": "pnpm sync:staging",
    "rollback": "./deploy.sh --rollback",
    "rollback:staging": "./deploy.sh --staging --rollback",
    "predeploy:staging": "pnpm build:staging",
    "sync:staging": "./deploy.sh --staging",
    "format": "oxfmt . && prettier --write --log-level warn \"**/*.astro\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@gmod/bgzf-filehandle": "^6.8.2",
    "@gmod/tabix": "^3.12.0",
    "@jbrowse/bandage-core": "11.7.0",
    "@jbrowse/graph-walks": "4.0.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@types/react": "^19.3.0",
    "astro": "^7.4.0",
    "generic-filehandle2": "^2.5.1",
    "hubtools": "workspace:*",
    "lucide-react": "^1.59.0",
    "node-sql-parser": "^5.4.0",
    "p2s_mapper": "^2.4.0",
    "pako-esm2": "^2.0.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@jbrowse/core": "^4.3.0",
    "oxc-transform-react": "^0.154.0"
  }
}
