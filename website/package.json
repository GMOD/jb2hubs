{
  "name": "website2",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf dist",
    "generate-taxonomy": "cd taxonomyBuilder && ./generate_taxonomy.sh && yarn format",
    "generate-recently-updated": "node generateRecentlyUpdated.ts",
    "generate-search-index": "node generateSearchIndex.ts",
    "generate-taxonomy-filter": "node generateTaxonomyFilter.ts",
    "generate-synteny-accessions": "node generateSyntenyAccessions.ts",
    "generate": "yarn generate-recently-updated && yarn generate-search-index && yarn generate-taxonomy-filter && yarn generate-synteny-accessions",
    "prebuild": "yarn clean && yarn generate-taxonomy && yarn generate",
    "predev": "aws s3 sync s3://jbrowse.org/processedHubJson/ processedHubJson/ && yarn generate",
    "dev": "astro dev",
    "typecheck": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test 'src/**/*.test.ts'",
    "deploy": "yarn sync",
    "predeploy": "yarn build",
    "sync": "tar czf - -C dist . | ssh myserver 'tar xzf - -C /var/www/html' && aws cloudfront create-invalidation --distribution-id E12EBG02P68TDO --paths '/*'",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/react": "5.0.4",
    "@floating-ui/react": "^0.27.19",
    "@fontsource/roboto": "^5.2.10",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@types/react": "^19.2.14",
    "astro": "6.2.1",
    "date-fns": "^4.1.0",
    "hubtools": "workspace:*",
    "lucide-react": "^1.14.0",
    "node-sql-parser": "^5.4.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}
