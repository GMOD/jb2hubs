{
  "name": "website2",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf dist",
    "generate-taxonomy": "cd taxonomyBuilder && ./generate_taxonomy.sh && pnpm format",
    "generate-recently-updated": "node generateRecentlyUpdated.ts",
    "generate-search-index": "node generateSearchIndex.ts",
    "generate-hub-data": "node generateHubData.ts",
    "generate-taxonomy-filter": "node generateTaxonomyFilter.ts",
    "generate-synteny-accessions": "node generateSyntenyAccessions.ts",
    "generate-ortholog-index": "node generateOrthologIndex.ts",
    "generate-protein-examples": "node generateBroadPanel.ts --genes TP53,BRCA2,NOTCH1,DMD,EGFR,COL1A1,PAX6,SOD1",
    "generate-synteny-pair-index": "node generateSyntenyPairIndex.ts",
    "generate": "pnpm generate-recently-updated && pnpm generate-hub-data && pnpm generate-search-index && pnpm generate-taxonomy-filter && pnpm generate-synteny-accessions && pnpm generate-ortholog-index && pnpm generate-synteny-pair-index",
    "prebuild": "pnpm clean && pnpm generate-taxonomy && pnpm generate",
    "predev": "aws s3 sync s3://jbrowse.org/processedHubJson/ processedHubJson/ && pnpm generate",
    "dev": "astro dev",
    "build": "astro build",
    "build:fast": "astro build",
    "build:staging": "pnpm prebuild && astro build --mode staging",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test 'src/**/*.test.ts'",
    "deploy": "pnpm sync",
    "predeploy": "pnpm build",
    "sync": "./deploy.sh",
    "deploy:staging": "pnpm sync:staging",
    "rollback": "./deploy.sh --rollback",
    "rollback:staging": "./deploy.sh --staging --rollback",
    "predeploy:staging": "pnpm build:staging",
    "sync:staging": "./deploy.sh --staging",
    "format": "oxfmt . && prettier --write \"**/*.astro\""
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@floating-ui/react": "^0.27.20",
    "@gmod/bgzf-filehandle": "^6.6.0",
    "@jbrowse/core": "^4.3.0",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@types/react": "^19.2.18",
    "astro": "^7.2.7",
    "generic-filehandle2": "^2.4.0",
    "hubtools": "workspace:*",
    "lucide-react": "^1.34.0",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "node-sql-parser": "^5.4.0",
    "pako-esm2": "^2.0.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-msaview": "^6.2.0",
    "swr": "^2.5.1",
    "tss-react": "^4.9.21"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "^1.0.0"
  }
}
