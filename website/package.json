{
  "name": "website2",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf dist",
    "generate-taxonomy": "cd taxonomyBuilder && ./generate_taxonomy.sh",
    "prebuild": "yarn clean && yarn generate-taxonomy",
    "dev": "astro dev",
    "build": "astro build",
    "buildonly": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "yarn sync",
    "predeploy": "yarn build",
    "sync": "tar czf - -C dist . | ssh myserver \"rm -rf /var/www/html/* && tar xzf - -C /var/www/html\"",
    "invalidate-all": "AWS_PAGER=\"\" yarn invalidate \"/*\"",
    "invalidate": "aws cloudfront  create-invalidation --distribution-id E12EBG02P68TDO --paths",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@floating-ui/react": "^0.27.16",
    "@fontsource/roboto": "^5.2.8",
    "@leeoniya/ufuzzy": "^1.0.18",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "astro": "5.16.4",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.555.0",
    "node-sql-parser": "^5.2.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
