{
  "name": "website2",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf dist",
    "generate-taxonomy": "cd taxonomyBuilder && ./generate_taxonomy.sh",
    "generate-recently-updated": "node generateRecentlyUpdated.ts",
    "prebuild": "yarn clean && yarn generate-taxonomy && yarn generate-recently-updated",
    "predev": "aws s3 sync s3://jbrowse.org/processedHubJson/ processedHubJson/",
    "dev": "astro dev",
    "build": "astro build",
    "buildonly": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "yarn sync",
    "predeploy": "yarn build",
    "sync": "tar czf - -C dist . | ssh myserver 'tar xzf - -C /var/www/html'",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/react": "5.0.2",
    "@floating-ui/react": "^0.27.19",
    "@fontsource/roboto": "^5.2.10",
    "@leeoniya/ufuzzy": "^1.0.18",
    "@types/react": "^19.2.14",
    "astro": "6.1.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "node-sql-parser": "^5.4.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "typescript": "^6.0.2"
  }
}
