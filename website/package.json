{
  "name": "website2",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf dist",
    "generate-taxonomy": "cd taxonomyBuilder && ./generate_taxonomy.sh",
    "generate-recently-updated": "node generateRecentlyUpdated.ts",
    "prebuild": "yarn clean && yarn generate-taxonomy && yarn generate-recently-updated",
    "dev": "astro dev",
    "build": "astro build",
    "buildonly": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "yarn sync",
    "predeploy": "yarn build",
    "sync": "tar czf - -C dist . | ssh myserver \"tar xzf - -C /var/www/html\"",
    "invalidate-all": "AWS_PAGER=\"\" yarn invalidate \"/*\"",
    "invalidate": "aws cloudfront  create-invalidation --distribution-id E12EBG02P68TDO --paths",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/react": "5.0.1",
    "@floating-ui/react": "^0.27.19",
    "@fontsource/roboto": "^5.2.10",
    "@leeoniya/ufuzzy": "^1.0.18",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.2.14",
    "astro": "6.0.8",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "node-sql-parser": "^5.4.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
