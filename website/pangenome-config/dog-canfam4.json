{
  "plugins": [
    {
      "name": "GraphGenomeView",
      "esmUrl": "https://jbrowse.org/plugins/jbrowse-plugin-graphgenomeviewer/latest/dist/jbrowse-plugin-graphgenomeviewer.esm.js"
    }
  ],
  "assemblies": [
    {
      "name": "canFam4",
      "aliases": ["UU_Cfam_GSD_1.0"],
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "canFam4-refseq",
        "adapter": {
          "type": "TwoBitAdapter",
          "uri": "https://hgdownload.soe.ucsc.edu/goldenPath/canFam4/bigZips/canFam4.2bit",
          "chromSizes": "https://jbrowse.org/ucsc/canFam4/canFam4.chrom.sizes"
        }
      },
      "refNameAliases": {
        "adapter": {
          "type": "RefNameAliasAdapter",
          "uri": "https://jbrowse.org/ucsc/canFam4/canFam4.chromAlias.txt"
        }
      }
    }
  ],
  "aggregateTextSearchAdapters": [
    {
      "type": "TrixTextSearchAdapter",
      "ixFilePath": {
        "uri": "https://jbrowse.org/ucsc/canFam4/trix/canFam4.ix"
      },
      "ixxFilePath": {
        "uri": "https://jbrowse.org/ucsc/canFam4/trix/canFam4.ixx"
      },
      "assemblyNames": ["canFam4"]
    }
  ],
  "tracks": [
    {
      "type": "FeatureTrack",
      "trackId": "canFam4_ncbiRefSeq_ucsc",
      "name": "NCBI RefSeq genes (canFam4)",
      "assemblyNames": ["canFam4"],
      "adapter": {
        "type": "Gff3TabixAdapter",
        "uri": "https://jbrowse.org/ucsc/canFam4/ncbiRefSeq.gff.gz",
        "csi": true
      }
    },
    {
      "type": "GraphTrack",
      "trackId": "dog_minigraph_segments",
      "name": "Dog pangenome (rGFA segments)",
      "assemblyNames": ["canFam4"],
      "adapter": {
        "type": "RgfaTabixAdapter",
        "uri": "https://jbrowse.org/demos/dog_pangenome/dog-canfam4-minigraph",
        "format": 2,
        "assemblyNameToPanSN": {
          "canFam4": "canFam4"
        },
        "coarse": {
          "uri": "https://jbrowse.org/demos/dog_pangenome/dog-canfam4-minigraph.fold10000",
          "format": 2,
          "aboveBpPerPx": 1000
        }
      },
      "displayDefaults": {
        "encoding": {
          "color": {
            "value": "jexl:get(feature,'rank')==0?'rgb(52,152,219)':'rgb(237,137,44)'"
          }
        }
      },
      "displays": [
        {
          "type": "LinearGraphDisplay",
          "displayId": "dog_minigraph_segments-LinearGraphDisplay",
          "layoutMode": "force"
        }
      ]
    },
    {
      "type": "GraphTrack",
      "trackId": "dog_minigraph_tier",
      "name": "Dog pangenome: variants under 10 kb folded (coarse tier)",
      "assemblyNames": ["canFam4"],
      "adapter": {
        "type": "RgfaTabixAdapter",
        "uri": "https://jbrowse.org/demos/dog_pangenome/dog-canfam4-minigraph.fold10000",
        "format": 2,
        "assemblyNameToPanSN": {
          "canFam4": "canFam4"
        }
      },
      "displays": [
        {
          "type": "LinearGraphDisplay",
          "displayId": "dog_minigraph_tier-LinearGraphDisplay",
          "layoutMode": "force"
        }
      ]
    },
    {
      "type": "FeatureTrack",
      "trackId": "dog_minigraph_bubbles",
      "name": "Dog pangenome bubbles",
      "assemblyNames": ["canFam4"],
      "adapter": {
        "type": "MinigraphBubbleAdapter",
        "uri": "https://jbrowse.org/demos/dog_pangenome/dog-canfam4-minigraph.bubbles.bed.gz",
        "assemblyNameToPanSN": {
          "canFam4": "canFam4"
        }
      },
      "displayDefaults": {
        "encoding": {
          "color": {
            "value": "rgb(130,130,130)"
          }
        }
      }
    },
    {
      "type": "QuantitativeTrack",
      "trackId": "dog_bubble_score",
      "name": "Dog pangenome: variability (segments per bubble)",
      "assemblyNames": ["canFam4"],
      "adapter": {
        "type": "MinigraphBubbleAdapter",
        "uri": "https://jbrowse.org/demos/dog_pangenome/dog-canfam4-minigraph.bubbles.bed.gz",
        "assemblyNameToPanSN": {
          "canFam4": "canFam4"
        }
      }
    }
  ]
}
