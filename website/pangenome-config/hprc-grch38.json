      "trackId": "hprc2_wave_grch38",
      "name": "HPRC2 pangenome callset (464 haplotypes)",
      "assemblyNames": ["hg38"],
      "adapter": {
        "type": "VcfTabixAdapter",
        "uri": "https://s3-us-west-2.amazonaws.com/human-pangenomics/pangenomes/freeze/release2/minigraph-cactus/v2.1/hprc-v2.1-mc-grch38/hprc-v2.1-mc-grch38.wave.vcf.gz"
      },
      "displays": [
        {
          "type": "LinearMultiSampleVariantDisplay",
          "displayId": "hprc2_wave_grch38_regular",
          "renderingMode": "phased"
        }
      ]
    },
    {
      "type": "SyntenyTrack",
      "trackId": "hprc_v2_1_gbz_lanes",
      "name": "HPRC release 2 haplotypes vs GRCh38, read from the graph (gbz-base)",
      "assemblyNames": [
        "hg38",
        "HG00097.1",
        "HG00099.1",
        "HG00128.1",
        "HG00133.1",
        "HG01109.1",
        "HG01123.1",
        "HG01960.1",
        "HG02055.1"
