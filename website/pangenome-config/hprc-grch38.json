          "uri": "https://jbrowse.org/demos/hprc/hprc-v2.1-mc-grch38.haplotype-index.anchored.db"
        },
        "assemblyNames": ["hg38"],
        "assemblyNameToPanSN": {
          "hg38": "GRCh38#0",
          "HG00097.1": "HG00097#1",
          "HG00099.1": "HG00099#1",
          "HG00128.1": "HG00128#1",
          "HG00133.1": "HG00133#1",
          "HG01109.1": "HG01109#1",
          "HG01123.1": "HG01123#1",
          "HG01960.1": "HG01960#1",
          "HG02055.1": "HG02055#1"
        },
        "context": 1000,
        "nodeLimit": 50000
      },
      "displays": [
        {
          "type": "MultiWaySyntenyDisplay",
          "displayId": "hprc_v2_1_gbz_lanes-MultiWaySyntenyDisplay",
