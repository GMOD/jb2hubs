---
import Breadcrumbs from './Breadcrumbs.astro'

interface Props {
  className?: string
  wide?: boolean
}

const { className, wide = false } = Astro.props
---

<div class:list={['container', { wide }]}>
  <div class:list={['content', className, { wide }]}>
    <Breadcrumbs />
    <slot />
  </div>
</div>

<style>
  .container {
    padding: 1rem;
  }

  .container.wide {
    padding: 0;
  }

  .content {
    max-width: 100%; /* Default for mobile */
    margin: 0 auto;
  }

  .content.wide {
    max-width: 100%;
    padding: 1rem;
  }

  @media (min-width: 768px) {
    .content:not(.wide) {
      max-width: 50%;
    }
  }
</style>
