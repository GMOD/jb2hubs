---
import HeaderSearch from './HeaderSearch.astro'
import Logo from '../logo.astro'
import { features } from '../config/features.ts'

// Every entry point lives under Explore, ordered the way you reach them: the
// two you start from with nothing in hand — an assembly (Assembly search) or a
// gene (Gene explorer, the /gene hub holding the ortholog table and the
// conserved-gene-order figure) — then the tools one of those hands you off to.
// Each staging feature appears when its flag does, and every label here is the
// page's own <h1>.
//
// One dropdown rather than a row of links because the row did not fit: the
// five labels are 799px of nowrap text, so on anything under ~1340px they
// painted over Blog/Demos/About and squeezed the header search to zero width.
const exploreItems = [
  { name: 'Assembly search', href: '/search' },
  { name: 'Gene explorer', href: '/gene' },
  ...(features.synteny ? [{ name: 'Synteny browser', href: '/synteny' }] : []),
  ...(features.proteinBrowser
    ? [{ name: 'Protein browser', href: '/protein-browser' }]
    : []),
  ...(features.pangenome ? [{ name: 'Pangenomes', href: '/pangenomes' }] : []),
]

const secondaryNavItems = [
  { name: 'Blog', href: '/blog' },
  { name: 'Demos', href: '/demos' },
  { name: 'About', href: '/about' },
]

const { pathname } = Astro.url
const isActive = (href: string) => pathname.startsWith(href)
const exploreActive = exploreItems.some(item => isActive(item.href))
---

<nav class="nav">
  <div class="container">
    <div class="left">
      <a
        href="/"
        class="logoLink"
      >
        <Logo
          alt="logo"
          width={30.8}
          height={32}
          class="logo"
        />
        JBrowse 2 Genomes
      </a>
      <div class="primary-nav desktop-nav">
        {/* <details>, so the menu opens with no JS and takes keyboard focus
            for free; the script below only closes it on an outside click or
            Escape. */}
        <details
          id="explore-dropdown"
          class="dropdown"
        >
          <summary
            class:list={[
              'navLink',
              'dropdownToggle',
              { active: exploreActive },
            ]}
          >
            Explore
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="chevron"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="dropdownMenu">
            {exploreItems.map(item => (
              <a
                href={item.href}
                class:list={['dropdownItem', { active: isActive(item.href) }]}
              >
                {item.name}
              </a>
            ))}
          </div>
        </details>
      </div>
      {/* A plain GET form, so search works with no JS and is one interaction
          away from every page rather than two clicks into a dropdown. The
          typeahead is layered on in headerSearch.ts. */}
      <div class="headerSearchSlot">
        <HeaderSearch />
      </div>
    </div>

    <div class="right">
      <div class="secondary-nav desktop-nav">
        {secondaryNavItems.map(item => (
          <a
            href={item.href}
            class:list={['navLink', { active: isActive(item.href) }]}
          >
            {item.name}
          </a>
        ))}
        <a
          href="https://jbrowse.org/jb2"
          class="externalLink"
          title="JBrowse 2 homepage"
        >
          JBrowse 2
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="1em"
            height="1em"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line
              x1="10"
              x2="21"
              y1="14"
              y2="3"
            ></line>
          </svg>
        </a>
        <a
          href="https://github.com/GMOD/jbrowse-components"
          class="socialLink"
          aria-label="JBrowse on GitHub"
        >
          <svg
            class="icon"
            aria-hidden="true"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
          </svg>
        </a>
      </div>
      <div class="mobile-nav">
        <button
          id="hamburger-button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line
              x1="3"
              y1="12"
              x2="21"
              y2="12"
            ></line>
            <line
              x1="3"
              y1="6"
              x2="21"
              y2="6"
            ></line>
            <line
              x1="3"
              y1="18"
              x2="21"
              y2="18"
            ></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div
    id="mobile-menu"
    class="mobile-menu"
  >
    {[...exploreItems, ...secondaryNavItems].map(item => (
      <a
        href={item.href}
        class:list={[
          'navLink',
          'mobile-navLink',
          { active: isActive(item.href) },
        ]}
      >
        {item.name}
      </a>
    ))}
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.getElementById('hamburger-button')
    const menu = document.getElementById('mobile-menu')

    if (button && menu) {
      const setOpen = (open: boolean) => {
        menu.classList.toggle('show', open)
        button.setAttribute('aria-expanded', String(open))
        button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
      }
      const isOpen = () => menu.classList.contains('show')

      button.addEventListener('click', () => {
        setOpen(!isOpen())
      })

      document.addEventListener('click', e => {
        if (
          isOpen() &&
          e.target instanceof Node &&
          !button.contains(e.target) &&
          !menu.contains(e.target)
        ) {
          setOpen(false)
        }
      })

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && isOpen()) {
          setOpen(false)
          button.focus()
        }
      })
    }

    const explore = document.getElementById('explore-dropdown')

    if (explore instanceof HTMLDetailsElement) {
      document.addEventListener('click', e => {
        if (
          explore.open &&
          e.target instanceof Node &&
          !explore.contains(e.target)
        ) {
          explore.open = false
        }
      })

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && explore.open) {
          explore.open = false
          explore.querySelector('summary')?.focus()
        }
      })
    }
  })
</script>

<style>
  .nav {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0 1rem;
    height: 60px;
    position: sticky;
    top: 0;
    z-index: 200;
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .left,
  .right {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .left {
    flex: 1;
  }

  /* Sizes the search slot; the form inside it fills this box and owns the rest
     of the search styling (headerSearch.css). */
  .headerSearchSlot {
    flex: 1;
    min-width: 0;
    max-width: 320px;
    margin-left: 1rem;
  }

  .logoLink {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    font-size: 1rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-right: 1rem;
  }

  .navLink {
    text-decoration: none;
    color: var(--text);
    font-size: 1rem;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .navLink:hover {
    background: var(--surface-alt);
  }

  .navLink.active {
    font-weight: 700;
    color: var(--accent);
  }

  .dropdown {
    position: relative;
  }

  .dropdownToggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .dropdownToggle::-webkit-details-marker {
    display: none;
  }

  .chevron {
    width: 14px;
    height: 14px;
  }

  .dropdown[open] .chevron {
    transform: rotate(180deg);
  }

  .dropdownMenu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 180px;
    padding: 4px 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.06);
  }

  .dropdownItem {
    display: block;
    padding: 6px 12px;
    text-decoration: none;
    color: var(--text);
    font-size: 1rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .dropdownItem:hover {
    background: var(--surface-alt);
  }

  .dropdownItem.active {
    font-weight: 700;
    color: var(--accent);
  }

  .externalLink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    text-decoration: none;
    color: var(--text);
    font-size: 1rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .socialLink {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    color: var(--muted);
  }

  .externalLink:hover,
  .socialLink:hover {
    color: var(--accent);
  }

  .icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .mobile-nav {
    display: none;
  }

  #hamburger-button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text);
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--surface);
    padding: 1rem;
    border-top: 1px solid var(--border);
    flex-direction: column;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.06);
  }

  .mobile-menu.show {
    display: flex;
  }

  .mobile-navLink {
    margin: 0.5rem 0;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    gap: 2px;
  }

  @media (max-width: 960px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }
</style>
