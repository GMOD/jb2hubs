---
import Logo from '../logo.astro'
import { features } from '../config/features.ts'

const exploreItems = [
  { name: 'Search', href: '/search' },
  ...(features.synteny ? [{ name: 'Synteny', href: '/synteny' }] : []),
  ...(features.multiSynteny
    ? [{ name: 'Multi-synteny', href: '/synteny-multi' }]
    : []),
  ...(features.orthologs ? [{ name: 'Orthologs', href: '/orthologs' }] : []),
  { name: 'Pangenomes', href: '/pangenomes' },
]

const secondaryNavItems = [
  { name: 'Blog', href: '/blog' },
  { name: 'Demos', href: '/demos' },
  { name: 'About', href: '/about' },
]

const { pathname } = Astro.url
const exploreActive = exploreItems.some(item => pathname.startsWith(item.href))
---

<nav class="nav">
  <div class="container">
    <div class="left">
      <a
        href="/"
        class="logoLink"
      >
        <Logo
          alt="logo"
          width={30.8}
          height={32}
          class="logo"
        />
        JBrowse 2 Genomes
      </a>
      <div class="primary-nav desktop-nav">
        <div class="dropdown">
          <span
            class:list={[
              'navLink',
              'dropdownToggle',
              { active: exploreActive },
            ]}>Explore ▾</span
          >
          <div class="dropdownMenu">
            {
              exploreItems.map(item => (
                <a
                  href={item.href}
                  class:list={[
                    'dropdownItem',
                    { active: pathname.startsWith(item.href) },
                  ]}
                >
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="right">
      <div class="secondary-nav desktop-nav">
        {
          secondaryNavItems.map(item => (
            <a
              href={item.href}
              class:list={[
                'navLink',
                { active: pathname.startsWith(item.href) },
              ]}
            >
              {item.name}
            </a>
          ))
        }
        <a
          href="https://jbrowse.org/jb2"
          class="externalLink"
          title="JBrowse 2 homepage"
          >JBrowse 2<svg
            xmlns="http://www.w3.org/2000/svg"
            width="1em"
            height="1em"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
            ></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line
              x1="10"
              x2="21"
              y1="14"
              y2="3"
            ></line>
          </svg></a
        >
        <a
          href="https://github.com/GMOD/jbrowse-components"
          class="socialLink"
        >
          <svg
            class="icon"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
        </a>
        <a
          href="https://genomic.social/@usejbrowse"
          class="socialLink"
        >
          <svg
            class="icon"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"
            ></path>
          </svg>
        </a>
        <a
          href="https://bsky.app/profile/jbrowse.org"
          class="socialLink"
        >
          <svg
            class="icon"
            width="24"
            height="24"
            fill="currentColor"
            viewBox="0 0 600 530"
          >
            <path
              d="m135.72 44.03c66.496 49.921 138.02 151.14 164.28 205.46 26.262-54.316 97.782-155.54 164.28-205.46 47.98-36.021 125.72-63.892 125.72 24.795 0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.3797-3.6904-10.832-3.7077-7.8964-0.0174-2.9357-1.1937 0.51669-3.7077 7.8964-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.26 82.697-152.22-67.108 11.421-142.55-7.4491-163.25-81.433-5.9562-21.282-16.111-152.36-16.111-170.07 0-88.687 77.742-60.816 125.72-24.795z"
            ></path>
          </svg>
        </a>
      </div>
      <div class="mobile-nav">
        <button
          id="hamburger-button"
          aria-label="Open menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line
              x1="3"
              y1="12"
              x2="21"
              y2="12"
            ></line>
            <line
              x1="3"
              y1="6"
              x2="21"
              y2="6"
            ></line>
            <line
              x1="3"
              y1="18"
              x2="21"
              y2="18"
            ></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div
    id="mobile-menu"
    class="mobile-menu"
  >
    <span class="navLink mobile-navLink mobile-groupLabel">Explore</span>
    {
      exploreItems.map(item => (
        <a
          href={item.href}
          class:list={[
            'navLink',
            'mobile-navLink',
            'mobile-subLink',
            { active: pathname.startsWith(item.href) },
          ]}
        >
          {item.name}
        </a>
      ))
    }
    {
      secondaryNavItems.map(item => (
        <a
          href={item.href}
          class:list={[
            'navLink',
            'mobile-navLink',
            { active: pathname.startsWith(item.href) },
          ]}
        >
          {item.name}
        </a>
      ))
    }
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hamburgerButton = document.getElementById('hamburger-button')
    const mobileMenu = document.getElementById('mobile-menu')

    if (hamburgerButton && mobileMenu) {
      hamburgerButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('show')
      })
    }

    const toggle = document.querySelector('.dropdownToggle')
    const menu = document.querySelector('.dropdownMenu')

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        menu.classList.toggle('open')
      })

      document.addEventListener('click', e => {
        if (
          !toggle.contains(e.target as Node) &&
          !menu.contains(e.target as Node)
        ) {
          menu.classList.remove('open')
        }
      })
    }
  })
</script>

<style>
  .nav {
    background: white;
    border-bottom: 1px solid #e7e7e7;
    padding: 0 1rem;
    height: 60px;
    position: sticky;
    top: 0;
    z-index: 200;
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .left,
  .right {
    display: flex;
    align-items: center;
  }

  .logoLink {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: black;
    font-size: 1rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-right: 1rem;
  }

  .navLink {
    text-decoration: none;
    color: black;
    font-size: 1rem;
    font-weight: 500;
    padding: 4px 12px;
    white-space: nowrap;
  }

  .navLink.active {
    font-weight: 700;
  }

  .externalLink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    text-decoration: none;
    color: black;
    white-space: nowrap;
  }

  .socialLink {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    color: black;
  }

  .icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .dropdown {
    position: relative;
  }

  .dropdownToggle {
    cursor: pointer;
    user-select: none;
  }

  .dropdownMenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: white;
    border: 1px solid #e7e7e7;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    min-width: 130px;
    z-index: 100;
    padding: 4px 0;
  }

  .dropdownMenu.open {
    display: block;
  }

  .dropdownItem {
    display: block;
    padding: 6px 12px;
    text-decoration: none;
    color: black;
    font-weight: 500;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .dropdownItem:hover {
    background: #f5f5f5;
  }

  .dropdownItem.active {
    font-weight: 700;
  }

  .mobile-nav {
    display: none;
  }

  #hamburger-button {
    background: none;
    border: none;
    cursor: pointer;
    color: black;
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    padding: 1rem;
    border-top: 1px solid #e7e7e7;
    flex-direction: column;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.06);
  }

  .mobile-menu.show {
    display: flex;
  }

  .mobile-navLink {
    margin: 0.5rem 0;
  }

  .mobile-groupLabel {
    color: rgba(0, 0, 0, 0.4);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
    margin-bottom: 0;
    cursor: default;
  }

  .mobile-subLink {
    padding-left: 1rem;
    margin-top: 0.25rem;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }
</style>
