---
import './headerSearch.css'
---

<form
  class="header-search"
  action="/search/"
  method="get"
  role="search"
>
  <label
    class="header-search-label"
    for="header-search-input"
  >
    Search genomes
  </label>
  <svg
    class="header-search-icon"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle
      cx="11"
      cy="11"
      r="8"
    ></circle>
    <line
      x1="21"
      y1="21"
      x2="16.65"
      y2="16.65"
    ></line>
  </svg>
  <input
    id="header-search-input"
    class="header-search-input"
    type="search"
    name="q"
    placeholder="Search genomes…"
    autocomplete="off"
    role="combobox"
    aria-expanded="false"
    aria-controls="header-search-listbox"
    aria-autocomplete="list"
  />
  <div
    id="header-search-popup"
    class="header-search-popup"
    hidden
  >
    <ul
      id="header-search-listbox"
      class="header-search-options"
      role="listbox"
      aria-label="Matching genomes"
    ></ul>
    <p
      class="header-search-empty"
      role="status"
    ></p>
    <button
      type="submit"
      class="header-search-all"
    ></button>
  </div>
</form>

<script>
  import { initHeaderSearch } from './headerSearch.ts'

  initHeaderSearch()
</script>
