---
// One dataset's section on /pangenomes, rendered from the dataset. All three
// graphs in this stack go through it: they publish the identical five projected
// files under the same suffixes, read them with the same adapters, and launch
// off the same builders, which is what makes a component possible at all.
//
// HPRC used to be hand-written beside it, for a 232-row sample table and a
// table of upstream release-2 downloads. `/hubs/HPRC` is a searchable version
// of the first and the HPRC resources repo is a maintained version of the
// second, so both became links and HPRC became the same shape as the others.
//
// What is genuinely per-dataset is the prose, and that comes in through the
// slots: the default one before the launches, `after` for anything that belongs
// under the same anchor.
import GraphRegionLauncher from './GraphRegionLauncher.tsx'
import { portalFiles } from './pangenomeDataset.ts'
import {
  externalGraphUrl,
  graphBrowserUrl,
  graphLocusUrl,
  locusRegionOf,
} from './pangenomeLinks.ts'
import { preferredLocus } from './pangenomeLoci.ts'

import type { PangenomeDataset } from './pangenomeDataset.ts'

interface Props {
  dataset: PangenomeDataset
}

const { dataset } = Astro.props
const { portal } = dataset

// The headline launch is the catalogue's own landing locus, the same one the
// explorer opens on, rather than a second constant that could disagree with it.
const landing = preferredLocus(dataset.loci)
const graphUrl = landing && graphLocusUrl(dataset, landing)
const externalUrl =
  !graphUrl && landing
    ? externalGraphUrl(dataset, locusRegionOf(landing))
    : undefined
const ext = dataset.externalGraphBrowser
// Offered only where the callset is a second thing to look at. Without one the
// linear lanes are already inside the graph launch above, so a "browse" button
// beside it would open a subset of it.
const callsetUrl = dataset.graphVcf ? graphBrowserUrl(dataset) : undefined

// Against the byte counts the bucket reports, so a number here can be compared
// with `curl -I` without an argument about units.
function humanBytes(bytes: number) {
  const scale = [
    { unit: 'GB', by: 1024 ** 3 },
    { unit: 'MB', by: 1024 ** 2 },
    { unit: 'KB', by: 1024 },
  ].find(s => bytes >= s.by)
  return scale
    ? `${(bytes / scale.by).toFixed(bytes / scale.by < 10 ? 1 : 0)} ${scale.unit}`
    : `${bytes} B`
}
---

<section id={dataset.id}>
  <h2>{portal.heading}</h2>

  <slot />

  <div class="portal-hero">
    <div class="portal-hero-text">
      <h3 class="portal-hero-title">Open it</h3>
      <p>
        The graph holds {dataset.panelDescription}, projected onto {
          dataset.reference.label
        }. Start from a locus where it varies most, or take the files below. <a
          href={portal.tutorialUrl}>The tutorial</a
        > walks what this graph can and cannot say.
      </p>
    </div>
    <div class="portal-hero-actions">
      <a
        class="portal-btn portal-btn-primary"
        href={`/pangenomes/explorer?dataset=${dataset.id}`}
      >
        Open the Pangenome Explorer &rarr;
      </a>
      {
        graphUrl && landing && (
          <a
            class="portal-btn"
            href={graphUrl}
            target="_blank"
            rel="noreferrer"
          >
            Draw {landing.gene} as a pangenome graph &rarr;
          </a>
        )
      }
      {
        externalUrl && ext && landing && (
          <a
            class="portal-btn"
            href={externalUrl}
            target="_blank"
            rel="noreferrer"
            title={`${ext.name} draws the ${ext.graphLabel} graph at this window`}
          >
            Draw {landing.gene} as a graph in {ext.name} &#8599;
          </a>
        )
      }
      {
        callsetUrl && (
          <a
            class="portal-btn"
            href={callsetUrl}
            target="_blank"
            rel="noreferrer"
          >
            Browse the callset on {dataset.reference.label} &rarr;
          </a>
        )
      }
      {
        portal.links.map(l =>
          l.url.startsWith('/') ? (
            <a
              class="portal-btn portal-btn-ghost"
              href={l.url}
            >
              {l.label} &rarr;
            </a>
          ) : (
            <a
              class="portal-btn portal-btn-ghost"
              href={l.url}
              target="_blank"
              rel="noreferrer"
            >
              {l.label} &#8599;
            </a>
          ),
        )
      }
    </div>
    {
      !dataset.graphBrowser && (
        <p class="portal-hero-note">
          <small>
            The in-browser graph needs the JBrowse build the staging site links:
            every adapter that reads these files ships in the GraphGenomeView
            plugin rather than in JBrowse core, and that plugin boots on v5
            only. The files below are downloadable either way.
          </small>
        </p>
      )
    }
  </div>

  <h3>Draw the graph</h3>
  <p>
    Any {dataset.reference.label} region, cut from the graph and drawn as nodes and
    edges beside a linear view of the same window. Hovering one panel highlights the
    other. Past 150 kb both switch to the coarse tier &mdash; one node per top-level
    bubble &mdash; which is what makes a whole chromosome drawable. Inside JBrowse
    the same view reopens from any region via the segments track&rsquo;s menu, <em
      >Launch &rarr; Graph genome view</em
    >, so the form is only the first cut.
  </p>
  <GraphRegionLauncher
    dataset={dataset}
    client:load
  />

  <h3>Published files</h3>
  <p>
    The tabix-indexed projections JBrowse queries a locus from without
    downloading the graph.
  </p>
  <table>
    <thead>
      <tr>
        <th>File</th>
        <th>What it holds</th>
        <th>Size</th>
      </tr>
    </thead>
    <tbody>
      {
        portalFiles(portal).map(f => (
          <tr>
            <td>
              <a href={`${portal.filePrefix}${f.suffix}`}>
                <code>{f.suffix}</code>
              </a>
            </td>
            <td>{f.what}</td>
            <td>{humanBytes(f.bytes)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <h3>What this graph can and cannot say</h3>
  <ul class="portal-notes">
    {portal.notes.map(n => <li>{n}</li>)}
    {dataset.noCallsetReason && <li>{dataset.noCallsetReason}</li>}
    {
      dataset.graphVcf && (
        <li>
          The callset beside the graph is a reference projection of its
          haplotype paths, so it answers which assembly carries which allele —
          which the graph lanes on their own cannot.
        </li>
      )
    }
  </ul>

  <slot name="after" />
</section>

<style is:global>
  .portal-notes {
    max-width: 80ch;
  }

  .portal-notes li {
    margin-bottom: 0.4rem;
  }
</style>
