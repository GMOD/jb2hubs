---
interface Props {
  message: string
}

const { message } = Astro.props
const target = new URL('/gene/', Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Gene explorer</title>
    <link
      rel="canonical"
      href={target.href}
    />
    <meta
      http-equiv="refresh"
      content="0; url=/gene/"
    />
    <script is:inline>
      location.replace('/gene/' + location.search)
    </script>
  </head>
  <body>
    <p>
      {message} moved to <a href="/gene">/gene</a>.
    </p>
  </body>
</html>
