---
import TreeNode from './TreeNode.astro'
import { getCachedTree, type TaxonomyNode } from '../utils/taxonomyCache'
import type { HubSource } from './DataTable/hubRow.ts'

interface Props {
  category?: string
  // The same rows the hub table gets, so the tree can annotate a leaf with its
  // common name and NCBI status.
  speciesData?: HubSource[]
  filterTaxonId?: string
  precomputedSubtree?: TaxonomyNode | null
  containerId?: string
}

const {
  category = 'all',
  speciesData = [],
  filterTaxonId,
  precomputedSubtree,
  containerId = 'taxonomy-tree-container',
} = Astro.props

// Accession -> row, for the leaf annotations. Pre-filtered to the subtree on a
// taxonomy-ID page, so this is small there and whole-category only on /taxonomy/<category>.
const speciesDataMap = new Map(
  speciesData.map(species => [species.accession, species]),
)

// A taxonomy-ID page hands its subtree down already extracted (the page indexes
// the tree once for all 74K of them); a category page names a whole tree of its
// own. getCachedTree reports a read/parse failure as null.
const tree: TaxonomyNode | null =
  precomputedSubtree === undefined
    ? getCachedTree(category)
    : precomputedSubtree
const error = tree
  ? null
  : filterTaxonId
    ? `No subtree found for taxonomy ID: ${filterTaxonId}`
    : `Failed to load taxonomy tree for category: ${category}`
---

<div id={containerId}>
  <div id="taxonomy-tree-content">
    {
      tree ? (
        <div>
          <TreeNode
            node={tree}
            speciesDataMap={speciesDataMap}
          />
        </div>
      ) : (
        <div style="padding: 16px; border: 1px solid #fca5a5; background-color: #fef2f2; border-radius: 4px;">
          <h3 style="color: #991b1b; font-weight: 600; margin-bottom: 8px;">
            Error loading taxonomy
          </h3>
          <p style="color: #dc2626;">{error}</p>
        </div>
      )
    }
  </div>
</div>
