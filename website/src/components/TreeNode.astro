---
import OrangeStar from './OrangeStar.tsx'
import RedX from './RedX.tsx'
import type { TaxonomyNode } from '../utils/taxonomyCache'
import type { HubSource } from './DataTable/hubRow.ts'

// Both types are imported rather than restated. Astro frontmatter is not
// typechecked (tsc cannot parse .astro), so a local copy of either would drift
// from the real shape with nothing to catch it.
interface Props {
  node: TaxonomyNode
  speciesDataMap: Map<string, HubSource>
}

const { node, speciesDataMap } = Astro.props
const children = node.children ?? []
const indent = 20
const speciesInfo = node.accession
  ? speciesDataMap.get(node.accession)
  : undefined
---

{
  children.length > 0 ? (
    <details
      class="tree-node"
      open
      style={`padding-left: ${indent}px;`}
    >
      <summary
        class="tree-summary"
        style={`background-color: ${node.depth % 2 === 0 ? '#ffffff' : '#f9fafb'};`}
      >
        <div class="tree-content">
          {node.taxonId ? (
            <a
              href={`/taxonomy/${node.taxonId}`}
              class="tree-node-link"
            >
              {node.name || 'Unnamed'}
            </a>
          ) : (
            <span style="color: #1f2937;">{node.name || 'Unnamed'}</span>
          )}

          {speciesInfo?.commonName ? (
            <span style="color: #6b7280;">({speciesInfo.commonName})</span>
          ) : null}
          {node.accession ? (
            <>
              <a
                href={`/accession/${node.accession}`}
                class="tree-link tree-link-underline"
              >
                (info)
              </a>{' '}
              <span class="accession-badge">{node.accession}</span>
            </>
          ) : null}
          {speciesInfo?.ncbiRefSeqCategory === 'reference genome' ? (
            <OrangeStar />
          ) : null}
          {speciesInfo?.suppressed ? <RedX /> : null}
          {node.branchLength !== undefined && node.branchLength !== 1.0 ? (
            <span style="color: #6b7280;">
              [{node.branchLength.toFixed(4)}]
            </span>
          ) : null}
        </div>
      </summary>
      {children.map(child => (
        <Astro.self
          node={child}
          speciesDataMap={speciesDataMap}
        />
      ))}
    </details>
  ) : (
    <div
      class="tree-leaf"
      style={`padding-left: ${indent}px; background-color: ${node.depth % 2 === 0 ? '#ffffff' : '#f9fafb'};`}
    >
      <div class="tree-content">
        <span style="margin-right: 8px;">•</span>
        {node.taxonId ? (
          <a
            href={`/taxonomy/${node.taxonId}`}
            class="tree-node-link"
          >
            {node.name || 'Unnamed'}
          </a>
        ) : (
          <span style="color: #374151;">{node.name || 'Unnamed'}</span>
        )}

        {speciesInfo?.commonName ? (
          <span style="color: #6b7280;">({speciesInfo.commonName})</span>
        ) : null}
        {node.accession ? (
          <>
            {/* prettier-ignore */}
            <a href={`/accession/${node.accession}`} class="tree-link tree-link-underline">(info)</a>
            <span class="accession-badge">{node.accession}</span>
          </>
        ) : null}
        {speciesInfo?.ncbiRefSeqCategory === 'reference genome' ? (
          <OrangeStar />
        ) : null}
        {speciesInfo?.suppressed ? <RedX /> : null}
        {node.branchLength !== undefined && node.branchLength !== 1.0 ? (
          <span style="color: #6b7280;">[{node.branchLength.toFixed(4)}]</span>
        ) : null}
      </div>
    </div>
  )
}

<style>
  @media (max-width: 768px) {
    .tree-node {
      padding-left: 10px !important;
    }
    .tree-leaf {
      padding-left: 10px !important;
    }
  }
</style>
<style>
  .tree-node {
    margin: 0;
    padding-left: 0;
  }

  .tree-summary {
    display: flex;
    align-items: center;
    padding: 2px 8px;
    border-bottom: 1px solid #e5e7eb;
    cursor: pointer;
    list-style: none;
  }

  .tree-summary::-webkit-details-marker {
    display: none;
  }

  .tree-summary::marker {
    display: none;
  }

  .tree-summary:hover {
    background-color: #f3f4f6 !important;
  }

  .tree-content {
    display: inline;
  }

  .tree-content > * {
    display: inline;
    margin-right: 8px;
  }

  .tree-leaf {
    display: flex;
    align-items: center;
    padding: 2px 8px;
    border-bottom: 1px solid #e5e7eb;
  }

  .tree-leaf:hover {
    background-color: #f3f4f6 !important;
  }

  .tree-link {
    color: var(--accent);
    text-decoration: none;
  }

  .tree-link-underline {
    text-decoration: underline;
  }

  .tree-node-link {
    color: #1f2937;
    text-decoration: none;
    font-weight: 500;
  }

  .tree-node-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .accession-badge {
    color: var(--accent);
    background-color: #eff6ff;
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Add chevron indicator using CSS */
  .tree-summary::before {
    content: '▶';
    display: inline-block;
    margin-right: 8px;
    font-size: 10px;
    transition: transform 0.2s;
  }

  details[open] > .tree-summary::before {
    transform: rotate(90deg);
  }
</style>
