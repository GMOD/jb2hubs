---
import TreeNodeLabel from './TreeNodeLabel.astro'
import type { TaxonomyNode } from '../utils/taxonomyCache'
import type { HubSource } from './DataTable/hubRow.ts'

// Both types are imported rather than restated. Astro frontmatter is not
// typechecked (tsc cannot parse .astro), so a local copy of either would drift
// from the real shape with nothing to catch it.
interface Props {
  node: TaxonomyNode
  speciesDataMap: Map<string, HubSource>
}

const { node, speciesDataMap } = Astro.props
const children = node.children ?? []
const speciesInfo = node.accession
  ? speciesDataMap.get(node.accession)
  : undefined
const stripe = node.depth % 2 === 0 ? 'even' : 'odd'
---

{
  children.length > 0 ? (
    <details
      class="tree-node"
      open
    >
      <summary class:list={['tree-summary', stripe]}>
        <TreeNodeLabel
          node={node}
          speciesInfo={speciesInfo}
        />
      </summary>
      {children.map(child => (
        <Astro.self
          node={child}
          speciesDataMap={speciesDataMap}
        />
      ))}
    </details>
  ) : (
    <div class:list={['tree-leaf', stripe]}>
      <span class="tree-bullet">•</span>
      <TreeNodeLabel
        node={node}
        speciesInfo={speciesInfo}
      />
    </div>
  )
}

<style>
  .tree-node {
    margin: 0;
    padding-left: 20px;
  }

  .tree-summary {
    display: flex;
    align-items: center;
    padding: 2px 8px;
    border-bottom: 1px solid #e5e7eb;
    cursor: pointer;
    list-style: none;
  }

  .tree-summary::-webkit-details-marker {
    display: none;
  }

  .tree-summary::marker {
    display: none;
  }

  .tree-leaf {
    display: flex;
    align-items: center;
    padding: 2px 8px 2px 20px;
    border-bottom: 1px solid #e5e7eb;
  }

  .even {
    background-color: #ffffff;
  }

  .odd {
    background-color: #f9fafb;
  }

  .tree-summary:hover,
  .tree-leaf:hover {
    background-color: #f3f4f6;
  }

  .tree-bullet {
    margin-right: 8px;
  }

  /* Add chevron indicator using CSS */
  .tree-summary::before {
    content: '▶';
    display: inline-block;
    margin-right: 8px;
    font-size: 10px;
    transition: transform 0.2s;
  }

  details[open] > .tree-summary::before {
    transform: rotate(90deg);
  }

  @media (max-width: 768px) {
    .tree-node {
      padding-left: 10px;
    }
    .tree-leaf {
      padding-left: 10px;
    }
  }
</style>
