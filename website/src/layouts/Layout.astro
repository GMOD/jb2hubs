---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { features } from '../config/features.ts'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  // schema.org JSON-LD for the page.
  jsonLd?: object
}

const { title, description, jsonLd } = Astro.props
const pageTitle = title ?? 'JBrowse 2 genome browser hubs'
const pageDescription = description
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
// Inline script text has to be set:html here: inside a template expression the
// compiler would read it as JSX.
const GTAG_BOOTSTRAP = `
window.dataLayer = window.dataLayer || []
function gtag() {
  dataLayer.push(arguments)
}
gtag('js', new Date())
gtag('config', 'G-D9CD3J2V31')
`
// A JSON string is not HTML-safe: the parser ends a <script> at the first
// "</script" regardless of quoting, and the values here come from NCBI. \u003c
// is the same character to JSON, and no longer a tag to the parser.
const jsonLdScript = jsonLd
  ? JSON.stringify(jsonLd).replaceAll('<', '\\u003c')
  : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
    />
    {
      /* Staging is a preview: its traffic is not the site's, and its pages must
        not be indexed as duplicates of production. */
    }
    {
      !features.staging && (
        <>
          <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-D9CD3J2V31"
          />
          <script
            is:inline
            set:html={GTAG_BOOTSTRAP}
          />
        </>
      )
    }
    <title>{pageTitle}</title>
    <link
      rel="canonical"
      href={canonicalURL}
    />
    {
      features.staging && (
        <meta
          name="robots"
          content="noindex"
        />
      )
    }
    {
      pageDescription && (
        <meta
          name="description"
          content={pageDescription}
        />
      )
    }
    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:url"
      content={canonicalURL}
    />
    <meta
      property="og:title"
      content={pageTitle}
    />
    {
      pageDescription && (
        <meta
          property="og:description"
          content={pageDescription}
        />
      )
    }
    {
      /* Absolute: og:image is fetched by scrapers that have no page context to
        resolve a site-relative path against, so a bare "/1.png" yields no card
        on most of them. */
    }
    <meta
      property="og:image"
      content={new URL('/1.png', Astro.site)}
    />
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    {
      jsonLdScript && (
        <script
          type="application/ld+json"
          set:html={jsonLdScript}
        />
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
