---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
---

<Layout
  title="Not found"
  description="This page does not exist. The site is rebuilt periodically, so a very recently released genome may not have a page yet."
>
  <Container>
    <div class="notFound">
      <p class="notFoundCode">404</p>
      <p>
        We rebuild this site periodically to pick up new assemblies, so a page
        for a very recently released genome may not exist yet.
      </p>
      <p>
        <a href="https://jbrowse.org/jb2/contact/">Contact us</a> if a page you
        expected is missing.
      </p>
    </div>
  </Container>
</Layout>

<style>
  .notFound {
    text-align: center;
    padding: 3rem 0;
  }

  .notFoundCode {
    font-size: 6rem;
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1;
  }
</style>
