---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import OrangeStar from '../../components/OrangeStar.tsx'
import RedX from '../../components/RedX.tsx'
import { loadAccessionMap, tryAndReadJSON } from '../../utils/accessionData.ts'
import tooltipStyles from '../../components/Tooltip.module.css'
import styles from './accession.module.css'
import path from 'path'

export async function getStaticPaths() {
  const accessions = loadAccessionMap()
  return [...accessions.keys()]
    .filter(r => !!r)
    .map(r => ({ params: { id: r } }))
}

const { id } = Astro.params
const ret = loadAccessionMap().get(id as string)

if (!ret) {
  // Astro handles 404s for paths not returned by getStaticPaths
  // For direct access, you might want a custom 404 page or redirect
  // For now, we'll just show a message.
  throw new Error(`Accession not found: ${id}`)
}

const {
  accession,
  scientificName,
  ncbiAssemblyName,
  commonName,
  jbrowseLink,
  igvBrowserLink,
  ncbiBrowserLink,
  ucscBrowserLink,
  ucscDataLink,
  ncbiLink,
  taxonId,
  seqReleaseDate,
  assemblyStatus,
  assemblyType,
  submitterOrg,
  stats,
  ncbiRefSeqCategory,
  suppressed,
  pairedAccession,
  pairedAssemblyStatus,
  pairedAssemblyDifferences,
  genomeNotes,
  suppressionReason,
  infraspecificNames,
  comments,
  gcPercent,
  genomeCoverage,
  sequencingTech,
  bioprojectAccession,
  annotationInfo,
} = ret

const pairedAssemblyData = pairedAccession
  ? loadAccessionMap().get(pairedAccession)
  : undefined

// GCA = GenBank, GCF = RefSeq
const pairedLabel = pairedAccession?.startsWith('GCF')
  ? 'Paired RefSeq'
  : 'Paired GenBank'

const [basePrefix, restOfAccession] = accession.split('_')
const [part1, part2, part3] = restOfAccession.match(/.{1,3}/g)
const hubBasePath = `../hubs/${basePrefix}/${part1}/${part2}/${part3}/${accession}/image.json`

const { imageUrl, pageUrl } =
  (await tryAndReadJSON(path.join(process.cwd(), hubBasePath))) || {}
---

<Layout frontmatter={{ title: scientificName }}>
  <Container>
    <div>
      <h1>{scientificName}</h1>
      <div>
        <b>Accession:</b>
        {accession}
      </div>
      <div>
        <b>Assembly name:</b>
        {ncbiAssemblyName}
      </div>
      <div>
        <b>Common name:</b>
        {commonName}
      </div>
      <div>
        <b>TaxonID:</b>
        <a href={`/taxonomy/${taxonId}`}>{taxonId}</a>
      </div>
      {
        seqReleaseDate ? (
          <div>
            <b>Release date:</b> {seqReleaseDate}
          </div>
        ) : null
      }
      {
        assemblyStatus || assemblyType ? (
          <div>
            <b>Assembly:</b>{' '}
            {[assemblyStatus, assemblyType].filter(Boolean).join(', ')}
          </div>
        ) : null
      }
      {
        ncbiRefSeqCategory === 'reference genome' ? (
          <div>
            <b>NCBI assembly status:</b> Designated Reference{' '}
            <OrangeStar client:load />
          </div>
        ) : null
      }
      {
        suppressed ? (
          <div>
            <b>NCBI assembly status:</b> RefSeq Suppressed <RedX client:load />
            {suppressionReason ? (
              <div class={styles.note}>{suppressionReason}</div>
            ) : null}
          </div>
        ) : null
      }
      {
        genomeNotes?.length ? (
          <div class={styles.note}>{genomeNotes.join('; ')}</div>
        ) : null
      }
      {
        infraspecificNames && Object.keys(infraspecificNames).length ? (
          <div>
            <b>Specimen:</b>{' '}
            {Object.entries(infraspecificNames)
              .map(([k, v]) => `${k}: ${v}`)
              .join(', ')}
          </div>
        ) : null
      }
      {
        pairedAccession && pairedAssemblyData ? (
          <div>
            <b>
              {pairedLabel}
              <span
                class={tooltipStyles.tooltip}
                data-tooltip="Same assembly submitted to both GenBank and RefSeq"
                style="cursor:help;font-size:0.75em;color:#888;font-weight:normal"
              >
                {' '}
                ?
              </span>
              :
            </b>{' '}
            <a href={`/accession/${pairedAccession}`}>{pairedAccession}</a>
            {pairedAssemblyStatus === 'suppressed' ? (
              <>
                {' '}
                <RedX client:load />
              </>
            ) : null}
            {pairedAssemblyDifferences ? (
              <> — {pairedAssemblyDifferences}</>
            ) : null}
          </div>
        ) : null
      }

      {
        submitterOrg ||
        stats ||
        comments ||
        gcPercent !== undefined ||
        genomeCoverage ||
        sequencingTech ||
        bioprojectAccession ||
        annotationInfo ? (
          <details class={styles.details}>
            <summary class={styles.summary}>More details</summary>
            <div class={styles.detailsContent}>
              {submitterOrg ? (
                <div>
                  <b>Submitter:</b> {submitterOrg}
                </div>
              ) : null}
              {stats ? (
                <div>
                  <b>Assembly stats:</b>
                  <div class={styles.geneCounts}>
                    {stats.total_length
                      ? `${Number(stats.total_length).toLocaleString()} bp total`
                      : null}
                    {stats.chromosome_count
                      ? ` — ${stats.chromosome_count} chromosomes`
                      : null}
                    {stats.scaffold_n50
                      ? ` — scaffold N50: ${Number(stats.scaffold_n50).toLocaleString()}`
                      : null}
                    {stats.contig_n50
                      ? ` — contig N50: ${Number(stats.contig_n50).toLocaleString()}`
                      : null}
                  </div>
                </div>
              ) : null}
              {comments ? (
                <div>
                  <b>Comments:</b> {comments}
                </div>
              ) : null}
              {gcPercent !== undefined ? (
                <div>
                  <b>GC content:</b> {gcPercent}%
                </div>
              ) : null}
              {genomeCoverage ? (
                <div>
                  <b>Coverage:</b> {genomeCoverage}x
                </div>
              ) : null}
              {sequencingTech ? (
                <div>
                  <b>Sequencing:</b> {sequencingTech}
                </div>
              ) : null}
              {bioprojectAccession ? (
                <div>
                  <b>BioProject:</b>{' '}
                  <a
                    href={`https://www.ncbi.nlm.nih.gov/bioproject/${bioprojectAccession}`}
                  >
                    {bioprojectAccession}
                  </a>
                </div>
              ) : null}
              {annotationInfo ? (
                <div>
                  <b>Annotation:</b> {annotationInfo.name}
                  {annotationInfo.provider
                    ? ` (${annotationInfo.provider})`
                    : null}
                  {annotationInfo.release_date
                    ? `, ${annotationInfo.release_date}`
                    : null}
                  {annotationInfo.stats?.gene_counts ? (
                    <div class={styles.geneCounts}>
                      {annotationInfo.stats.gene_counts.total?.toLocaleString()}{' '}
                      genes —{' '}
                      {annotationInfo.stats.gene_counts.protein_coding?.toLocaleString()}{' '}
                      protein-coding,{' '}
                      {annotationInfo.stats.gene_counts.non_coding?.toLocaleString()}{' '}
                      non-coding,{' '}
                      {annotationInfo.stats.gene_counts.pseudogene?.toLocaleString()}{' '}
                      pseudogenes
                    </div>
                  ) : null}
                </div>
              ) : null}
            </div>
          </details>
        ) : null
      }

      {
        imageUrl ? (
          <div class={styles.imageContainer}>
            <figure class={styles.figure}>
              <img src={imageUrl} class={styles.image} />
              <figcaption>
                {pageUrl ? <a href={pageUrl}>(source)</a> : 'no link'}
              </figcaption>
            </figure>
          </div>
        ) : (
          <div class={styles.imageContainer}>
            <div class={styles.placeholder}>No image</div>
          </div>
        )
      }
    </div>
    <div>
      <h2>Genome browsers</h2>
      <ul>
        <li>
          <a href={jbrowseLink}>JBrowse</a>
        </li>
        <li>
          <a href={igvBrowserLink}>IGV.js</a>
        </li>
        <li>
          <a href={ncbiBrowserLink}> NCBI browser (GDV) </a>
        </li>
        <li>
          <a href={ucscBrowserLink}>UCSC browser</a>
        </li>
      </ul>
    </div>
    <div>
      <h2>Portals/data downloads</h2>
      <ul>
        <li>
          <a href={ucscDataLink}>UCSC data folder</a>
        </li>
        <li>
          <a href={ncbiLink}>NCBI assembly page</a>
        </li>
        <li>
          <a
            href={`https://www.ncbi.nlm.nih.gov/datasets/taxonomy/${taxonId}/`}
          >
            NCBI taxonomy page
          </a>
        </li>
        <li>
          <a
            href={`https://www.google.com/search?q=${encodeURIComponent(scientificName)}`}
          >
            Google
          </a>
        </li>
        <li>
          <a
            href={`https://www.google.com/search?q=${encodeURIComponent(scientificName)}&udm=50`}
          >
            Google AI overview
          </a>
        </li>
      </ul>
    </div>
  </Container>
</Layout>
