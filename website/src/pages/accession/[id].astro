---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import UcscStatusBanner from '../../components/UcscStatusBanner.astro'
import OrangeStar from '../../components/OrangeStar.tsx'
import RedX from '../../components/RedX.tsx'
import {
  loadAccessionMap,
  loadSyntenyAssemblies,
  buildUcscMapping,
  buildSiblingIndex,
  loadHubImage,
  loadNcbiDetails,
  taxonomyPageIds,
} from '../../utils/accessionData.ts'
import {
  accessionHead,
  buscoSummary,
  geneCountSummary,
  hasAssemblyDetails,
  pairedLabel,
  retrievedDate,
  specimenSummary,
  speciesLabel,
  syntenyName,
} from '../../utils/accessionPage.ts'
import {
  jbrowseUrl,
  genarkConfigPath,
  ucscConfigPath,
} from '../../config/jbrowse.ts'
import { usefulComments } from '../../utils/comments.ts'
import {
  ncbiBioProjectUrl,
  ncbiGenomeUrl,
  ncbiTaxonomyUrl,
} from '../../lib/externalLinks.ts'
import { features } from '../../config/features.ts'
import tooltipStyles from '../../components/Tooltip.module.css'
import styles from './accession.module.css'

import '../../styles/common-table.css'

export async function getStaticPaths() {
  // Astro extracts getStaticPaths into its own module and tree-shakes the rest of
  // the frontmatter away, so everything it needs has to come from an import.
  const accessions = loadAccessionMap()
  const ucscMappings = buildUcscMapping(accessions)
  const siblingIndex = buildSiblingIndex(accessions)
  const syntenyAssemblies = loadSyntenyAssemblies()
  const taxonPages = taxonomyPageIds()
  const maxSiblings = 8

  return [...accessions.entries()]
    .filter(([id]) => !!id)
    .map(([id, data]) => {
      const { siblings = [], taxonCount = 1 } = siblingIndex.get(id) ?? {}
      const ucscDbName = ucscMappings.get(id)
      return {
        params: { id },
        props: {
          data,
          pairedHosted:
            !!data.pairedAccession && accessions.has(data.pairedAccession),
          ucscDbName,
          syntenyAssembly: syntenyName([ucscDbName, id], syntenyAssemblies),
          taxonomyPage: taxonPages.has(String(data.taxonId)),
          siblings: siblings.slice(0, maxSiblings),
          siblingCount: siblings.length,
          taxonCount,
        },
      }
    })
}

const {
  data,
  pairedHosted,
  ucscDbName,
  syntenyAssembly,
  taxonomyPage,
  siblings,
  siblingCount,
  taxonCount,
} = Astro.props

const {
  accession,
  scientificName,
  ncbiAssemblyName,
  igvBrowserLink,
  ncbiBrowserLink,
  ucscBrowserLink,
  ucscDataLink,
  taxonId,
  seqReleaseDate,
  assemblyStatus,
  assemblyType,
  submitterOrg,
  ncbiRefSeqCategory,
  suppressed,
  pairedAccession,
  ncbiMissing,
} = data

const details = loadNcbiDetails(accession)
const {
  stats,
  pairedAssemblyStatus,
  pairedAssemblyDifferences,
  genomeNotes,
  suppressionReason,
  gcPercent,
  genomeCoverage,
  sequencingTech,
  bioprojectAccession,
  annotationInfo,
  ncbiDownloadedAt,
} = details

const imageData = loadHubImage(accession)
const imageUrl = imageData?.imageUrl
const pageUrl = imageData?.pageUrl

const comments = usefulComments(details.comments)
const taxonomyUrl = ncbiTaxonomyUrl(taxonId)
const ncbiUrl = ncbiGenomeUrl(accession)

const {
  organism,
  title: pageTitle,
  description: pageDescription,
  jsonLd,
} = accessionHead(data, new URL(Astro.url.pathname, Astro.site).href)
const busco = buscoSummary(annotationInfo?.busco)
const geneCounts = geneCountSummary(annotationInfo?.stats?.gene_counts)
const specimen = specimenSummary(details.infraspecificNames)
const showAssemblyDetails = hasAssemblyDetails(details, data)
const showAnnotation = !!(annotationInfo?.name || busco || geneCounts)
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
>
  <Container>
    <UcscStatusBanner />
    <h1>{scientificName}</h1>
    {ncbiMissing ? (
      <p>
        <em>
          NCBI metadata not yet available for this assembly. Some details may be
          missing.
        </em>
      </p>
    ) : null}
    <div class={styles.identity}>
      <dl class={styles.statsTable}>
        <dt>Accession</dt>
        <dd>{accession}</dd>
        <dt>Assembly name</dt>
        <dd>{ncbiAssemblyName}</dd>
        {organism ? (
          <>
            <dt>Common name</dt>
            <dd>{organism}</dd>
          </>
        ) : null}
        <dt>TaxonID</dt>
        <dd>
          {taxonomyPage ? (
            <a href={`/taxonomy/${taxonId}`}>{taxonId}</a>
          ) : (
            taxonId
          )}{' '}
          — <a href={taxonomyUrl}>NCBI taxonomy</a>
        </dd>
        {seqReleaseDate ? (
          <>
            <dt>Release date</dt>
            <dd>{seqReleaseDate}</dd>
          </>
        ) : null}
        {assemblyStatus || assemblyType ? (
          <>
            <dt>Assembly</dt>
            <dd>{[assemblyStatus, assemblyType].filter(Boolean).join(', ')}</dd>
          </>
        ) : null}
        {ncbiRefSeqCategory === 'reference genome' ? (
          <>
            <dt>NCBI assembly status</dt>
            <dd>
              Designated Reference <OrangeStar />
            </dd>
          </>
        ) : null}
        {suppressed ? (
          <>
            <dt>NCBI assembly status</dt>
            <dd>
              RefSeq Suppressed <RedX />
              {suppressionReason ? <> — {suppressionReason}</> : null}
            </dd>
          </>
        ) : null}
        {genomeNotes?.length ? (
          <>
            <dt>NCBI quality notes</dt>
            <dd>{genomeNotes.join('; ')}</dd>
          </>
        ) : null}
      </dl>
      {imageUrl ? (
        <figure class={styles.figure}>
          <img
            src={imageUrl}
            alt={speciesLabel(scientificName, organism)}
            class={styles.image}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            {pageUrl ? <a href={pageUrl}>(source)</a> : null}
          </figcaption>
        </figure>
      ) : null}
    </div>
    <div>
      <h2>Genome browsers</h2>
      {ucscDbName && (
        <p>
          See <a href={`/ucsc/${ucscDbName}`}>{ucscDbName}</a> for our full
          JBrowse instance of this assembly.
        </p>
      )}
      <ul>
        <li>
          <a
            href={jbrowseUrl(
              ucscDbName
                ? ucscConfigPath(ucscDbName)
                : genarkConfigPath(accession),
            )}
          >
            JBrowse
          </a>
        </li>
        <li>
          <a href={igvBrowserLink}>IGV.js</a>
        </li>
        <li>
          <a href={ncbiBrowserLink}>NCBI browser (GDV)</a>
        </li>
        <li>
          <a href={ucscBrowserLink}>UCSC browser</a>
        </li>
      </ul>
    </div>
    <div>
      <h2>Compare with other genomes</h2>
      <ul>
        {features.synteny && syntenyAssembly ? (
          <li>
            <a href={`/synteny/?assembly=${syntenyAssembly}`}>
              Open a synteny view against an aligned assembly
            </a>
          </li>
        ) : null}
        <li>
          <a href="/gene">Look up a gene across the hosted genomes</a>
        </li>
        {taxonomyPage ? (
          <li>
            <a href={`/taxonomy/${taxonId}`}>
              Browse every assembly we host for this taxon
            </a>
          </li>
        ) : null}
      </ul>
      {siblings.length ? (
        <details class={styles.disclosure}>
          <summary>
            Other assemblies for {scientificName}
            {siblingCount > siblings.length
              ? ` (${siblings.length} of ${siblingCount} shown)`
              : ` (${siblingCount})`}
          </summary>
          <table>
            <thead>
              <tr>
                <th scope="col">Accession</th>
                <th scope="col">Assembly name</th>
                <th scope="col">Assembly status</th>
                <th scope="col">Release date</th>
                <th scope="col">NCBI status</th>
              </tr>
            </thead>
            <tbody>
              {siblings.map(sibling => (
                <tr>
                  <td>
                    <a href={`/accession/${sibling.accession}`}>
                      {sibling.accession}
                    </a>
                  </td>
                  <td>{sibling.ncbiAssemblyName}</td>
                  <td>{sibling.assemblyStatus}</td>
                  <td>{sibling.seqReleaseDate}</td>
                  <td>
                    {sibling.isReference ? <OrangeStar /> : null}
                    {sibling.suppressed ? <RedX /> : null}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          {taxonomyPage && siblingCount > siblings.length ? (
            <p>
              <a href={`/taxonomy/${taxonId}`}>
                See all {taxonCount} assemblies for this taxon
              </a>
            </p>
          ) : null}
        </details>
      ) : null}
    </div>
    {showAssemblyDetails ? (
      <details class={styles.disclosure}>
        <summary>Assembly details</summary>
        <dl class={styles.statsTable}>
          {stats?.total_length ? (
            <>
              <dt>Total length</dt>
              <dd>{Number(stats.total_length).toLocaleString()} bp</dd>
            </>
          ) : null}
          {stats?.chromosome_count ? (
            <>
              <dt>Chromosomes</dt>
              <dd>{stats.chromosome_count}</dd>
            </>
          ) : null}
          {stats?.scaffold_count ? (
            <>
              <dt>Scaffolds</dt>
              <dd>{stats.scaffold_count}</dd>
            </>
          ) : null}
          {stats?.scaffold_n50 ? (
            <>
              <dt>Scaffold N50</dt>
              <dd>
                {Number(stats.scaffold_n50).toLocaleString()}
                {stats.scaffold_l50
                  ? ` (L50 ${Number(stats.scaffold_l50).toLocaleString()})`
                  : null}
              </dd>
            </>
          ) : null}
          {stats?.contig_count ? (
            <>
              <dt>Contigs</dt>
              <dd>{stats.contig_count}</dd>
            </>
          ) : null}
          {stats?.contig_n50 ? (
            <>
              <dt>Contig N50</dt>
              <dd>
                {Number(stats.contig_n50).toLocaleString()}
                {stats.contig_l50
                  ? ` (L50 ${Number(stats.contig_l50).toLocaleString()})`
                  : null}
              </dd>
            </>
          ) : null}
          {gcPercent !== undefined ? (
            <>
              <dt>GC content</dt>
              <dd>{gcPercent}%</dd>
            </>
          ) : null}
          {genomeCoverage ? (
            <>
              <dt>Coverage</dt>
              <dd>{genomeCoverage}x</dd>
            </>
          ) : null}
          {sequencingTech ? (
            <>
              <dt>Sequencing</dt>
              <dd>{sequencingTech}</dd>
            </>
          ) : null}
          {specimen ? (
            <>
              <dt>Specimen</dt>
              <dd>{specimen}</dd>
            </>
          ) : null}
          {submitterOrg ? (
            <>
              <dt>Submitter</dt>
              <dd>{submitterOrg}</dd>
            </>
          ) : null}
          {bioprojectAccession ? (
            <>
              <dt>BioProject</dt>
              <dd>
                <a href={ncbiBioProjectUrl(bioprojectAccession)}>
                  {bioprojectAccession}
                </a>
              </dd>
            </>
          ) : null}
          {pairedAccession ? (
            <>
              <dt>
                {pairedLabel(pairedAccession)}
                <span
                  class={tooltipStyles.tooltip}
                  data-tooltip="Same assembly submitted to both GenBank and RefSeq"
                  style="cursor:help;font-size:0.75em"
                >
                  {' '}
                  ?
                </span>
              </dt>
              <dd>
                {pairedHosted ? (
                  <a href={`/accession/${pairedAccession}`}>
                    {pairedAccession}
                  </a>
                ) : (
                  <>
                    {pairedAccession} (
                    <a href={ncbiGenomeUrl(pairedAccession)}>NCBI</a>)
                  </>
                )}
                {pairedAssemblyStatus === 'suppressed' ? (
                  <>
                    {' '}
                    <RedX />
                  </>
                ) : null}
                {pairedAssemblyDifferences ? (
                  <> — {pairedAssemblyDifferences}</>
                ) : null}
              </dd>
            </>
          ) : null}
        </dl>
      </details>
    ) : null}
    {annotationInfo && showAnnotation ? (
      <details class={styles.disclosure}>
        <summary>Annotation</summary>
        <dl class={styles.statsTable}>
          {annotationInfo.name ? (
            <>
              <dt>Name</dt>
              <dd>
                {annotationInfo.name}
                {annotationInfo.provider
                  ? ` (${annotationInfo.provider})`
                  : null}
                {annotationInfo.release_date
                  ? `, ${annotationInfo.release_date}`
                  : null}
              </dd>
            </>
          ) : null}
          {busco ? (
            <>
              <dt>BUSCO completeness</dt>
              <dd>{busco}</dd>
            </>
          ) : null}
          {geneCounts ? (
            <>
              <dt>Gene counts</dt>
              <dd>{geneCounts}</dd>
            </>
          ) : null}
        </dl>
      </details>
    ) : null}
    {comments ? (
      <details class={styles.disclosure}>
        <summary>Submitter comments</summary>
        <div class={styles.comments}>{comments}</div>
      </details>
    ) : null}
    <div>
      <small>
        Assembly data from the <a href={ncbiUrl}>NCBI assembly page</a> and the{' '}
        <a href={ucscDataLink}>UCSC GenArk data folder</a>.
        {ncbiDownloadedAt
          ? ` NCBI data retrieved ${retrievedDate(ncbiDownloadedAt)}.`
          : null}
      </small>
    </div>
  </Container>
</Layout>
