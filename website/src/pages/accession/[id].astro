---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import UcscStatusBanner from '../../components/UcscStatusBanner.astro'
import OrangeStar from '../../components/OrangeStar.tsx'
import RedX from '../../components/RedX.tsx'
import { loadHubImage, loadNcbiDetails } from '../../utils/accessionData.ts'
import {
  accessionHead,
  accessionPagePaths,
  moreAboutRows,
  retrievedDate,
  speciesLabel,
} from '../../utils/accessionPage.ts'
import type { AccessionPageProps } from '../../utils/accessionPage.ts'
import { genomeConfigPath, jbrowseUrl } from '../../config/jbrowse.ts'
import { usefulComments } from '../../utils/comments.ts'
import {
  ncbiBioProjectUrl,
  ncbiGenomeUrl,
  ncbiTaxonomyUrl,
} from '../../lib/externalLinks.ts'
import tooltipStyles from '../../components/Tooltip.module.css'
import styles from './accession.module.css'

import '../../styles/common-table.css'
import '../../styles/ui.css'

type Props = AccessionPageProps

export function getStaticPaths() {
  return accessionPagePaths()
}

const {
  data,
  pairedHosted,
  ucscDbName,
  syntenyAssembly,
  taxonomyPage,
  siblings,
  siblingCount,
  taxonCount,
} = Astro.props

const {
  accession,
  scientificName,
  ncbiAssemblyName,
  igvBrowserLink,
  ncbiBrowserLink,
  ucscBrowserLink,
  ucscDataLink,
  taxonId,
  seqReleaseDate,
  assemblyStatus,
  assemblyType,
  ncbiRefSeqCategory,
  suppressed,
  ncbiMissing,
} = data

const details = loadNcbiDetails(accession)
const {
  pairedAssemblyStatus,
  pairedAssemblyDifferences,
  genomeNotes,
  suppressionReason,
  ncbiDownloadedAt,
} = details

const imageData = loadHubImage(accession)
const imageUrl = imageData?.imageUrl
const pageUrl = imageData?.pageUrl

const comments = usefulComments(details.comments)
const taxonomyUrl = ncbiTaxonomyUrl(taxonId)
const ncbiUrl = ncbiGenomeUrl(accession)

const {
  organism,
  title: pageTitle,
  description: pageDescription,
  jsonLd,
} = accessionHead(data, new URL(Astro.url.pathname, Astro.site).href)
const moreAbout = moreAboutRows(details, data, comments)
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
>
  <Container>
    <UcscStatusBanner />
    <h1>{scientificName}</h1>
    {ncbiMissing ? (
      <p>
        <em>
          NCBI metadata not yet available for this assembly. Some details may be
          missing.
        </em>
      </p>
    ) : null}
    <div class={styles.identity}>
      <dl class={styles.statsTable}>
        <dt>Accession</dt>
        <dd>{accession}</dd>
        <dt>Assembly name</dt>
        <dd>{ncbiAssemblyName}</dd>
        {organism ? (
          <>
            <dt>Common name</dt>
            <dd>{organism}</dd>
          </>
        ) : null}
        <dt>TaxonID</dt>
        <dd>
          {taxonomyPage ? (
            <a href={`/taxonomy/${taxonId}/`}>{taxonId}</a>
          ) : (
            taxonId
          )}{' '}
          — <a href={taxonomyUrl}>NCBI taxonomy</a>
        </dd>
        {seqReleaseDate ? (
          <>
            <dt>Release date</dt>
            <dd>{seqReleaseDate}</dd>
          </>
        ) : null}
        {assemblyStatus || assemblyType ? (
          <>
            <dt>Assembly</dt>
            <dd>{[assemblyStatus, assemblyType].filter(Boolean).join(', ')}</dd>
          </>
        ) : null}
        {ncbiRefSeqCategory === 'reference genome' ? (
          <>
            <dt>NCBI assembly status</dt>
            <dd>
              Designated Reference <OrangeStar />
            </dd>
          </>
        ) : null}
        {suppressed ? (
          <>
            <dt>NCBI assembly status</dt>
            <dd>
              RefSeq Suppressed <RedX />
              {suppressionReason ? <> — {suppressionReason}</> : null}
            </dd>
          </>
        ) : null}
        {genomeNotes?.length ? (
          <>
            <dt>NCBI quality notes</dt>
            <dd>{genomeNotes.join('; ')}</dd>
          </>
        ) : null}
      </dl>
      {imageUrl ? (
        <figure class={styles.figure}>
          <img
            src={imageUrl}
            alt={speciesLabel(scientificName, organism)}
            class={styles.image}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            {pageUrl ? <a href={pageUrl}>(source)</a> : null}
          </figcaption>
        </figure>
      ) : null}
    </div>
    <div class={styles.launch}>
      <a
        class="ui-btn"
        href={jbrowseUrl(genomeConfigPath({ accession, ucscDb: ucscDbName }))}
      >
        Open in JBrowse
      </a>
      <span class={styles.otherBrowsers}>
        Also in <a href={igvBrowserLink}>IGV.js</a> ·{' '}
        <a href={ncbiBrowserLink}>NCBI GDV</a> ·{' '}
        <a href={ucscBrowserLink}>UCSC</a>
        {ucscDbName ? (
          <>
            {' · '}
            <a href={`/ucsc/${ucscDbName}/`}>{ucscDbName} page</a>
          </>
        ) : null}
        {syntenyAssembly ? (
          <>
            {' · '}
            <a href={`/synteny/?assembly=${syntenyAssembly}`}>Synteny</a>
          </>
        ) : null}
      </span>
    </div>
    <div>
      {siblings.length ? (
        <details class={styles.disclosure}>
          <summary>
            Other assemblies for {scientificName} ({siblingCount})
          </summary>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">Accession</th>
                  <th scope="col">Assembly name</th>
                  <th scope="col">Assembly status</th>
                  <th scope="col">Release date</th>
                  <th scope="col">NCBI status</th>
                </tr>
              </thead>
              <tbody>
                {siblings.map(sibling => (
                  <tr>
                    <td>
                      <a href={`/accession/${sibling.accession}/`}>
                        {sibling.accession}
                      </a>
                    </td>
                    <td>{sibling.ncbiAssemblyName}</td>
                    <td>{sibling.assemblyStatus}</td>
                    <td>{sibling.seqReleaseDate}</td>
                    <td>
                      {sibling.isReference ? <OrangeStar /> : null}
                      {sibling.suppressed ? <RedX /> : null}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {taxonomyPage && siblingCount > siblings.length ? (
            <p>
              <a href={`/taxonomy/${taxonId}/`}>
                See all {taxonCount} assemblies for this taxon
              </a>
            </p>
          ) : null}
        </details>
      ) : null}
    </div>
    {moreAbout.length > 0 ? (
      <details class={styles.disclosure}>
        <summary>More about this assembly</summary>
        <dl class={styles.statsTable}>
          {moreAbout.map(row =>
            row.kind === 'paired' ? (
              <>
                <dt>
                  {row.label}
                  <span
                    class={tooltipStyles.tooltip}
                    data-tooltip="Same assembly submitted to both GenBank and RefSeq"
                    role="img"
                    aria-label="Same assembly submitted to both GenBank and RefSeq"
                    tabindex="0"
                    style="cursor:help;font-size:0.75em"
                  >
                    {' '}
                    ?
                  </span>
                </dt>
                <dd>
                  {pairedHosted ? (
                    <a href={`/accession/${row.value}/`}>{row.value}</a>
                  ) : (
                    <>
                      {row.value} · <a href={ncbiGenomeUrl(row.value)}>NCBI</a>
                    </>
                  )}
                  {pairedAssemblyStatus === 'suppressed' ? (
                    <>
                      {' '}
                      <RedX />
                    </>
                  ) : null}
                  {pairedAssemblyDifferences ? (
                    <> — {pairedAssemblyDifferences}</>
                  ) : null}
                </dd>
              </>
            ) : (
              <>
                <dt>{row.label}</dt>
                {row.kind === 'bioproject' ? (
                  <dd>
                    <a href={ncbiBioProjectUrl(row.value)}>{row.value}</a>
                  </dd>
                ) : row.kind === 'comments' ? (
                  <dd class={styles.comments}>{row.value}</dd>
                ) : (
                  <dd>{row.value}</dd>
                )}
              </>
            ),
          )}
        </dl>
      </details>
    ) : null}
    <dl class={styles.statsTable}>
      <dt>Source data</dt>
      <dd>
        <a href={ncbiUrl}>NCBI</a> · <a href={ucscDataLink}>GenArk folder</a>
        {ncbiDownloadedAt
          ? `, NCBI retrieved ${retrievedDate(ncbiDownloadedAt)}`
          : null}
      </dd>
    </dl>
  </Container>
</Layout>
