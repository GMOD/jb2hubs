---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import OrangeStar from '../../components/OrangeStar.tsx'
import RedX from '../../components/RedX.tsx'
import {
  loadAccessionMap,
  buildUcscMapping,
  buildSiblingIndex,
  loadHubImage,
  loadNcbiDetails,
} from '../../utils/accessionData.ts'
import {
  jbrowseUrl,
  genarkConfigPath,
  ucscConfigPath,
} from '../../config/jbrowse.ts'
import { bareCommonName } from '../../utils/names.ts'
import { features } from '../../config/features.ts'
import tooltipStyles from '../../components/Tooltip.module.css'
import styles from './accession.module.css'
import syntenyAccessions from '../../syntenyAccessions.json'

import '../../styles/common-table.css'

// Accessions that participate in at least one launchable synteny track,
// precomputed by extractSyntenyTracks.ts so accession pages avoid loading the
// multi-megabyte syntenyTracks.json.
const syntenyAssemblies = new Set<string>(syntenyAccessions)

export async function getStaticPaths() {
  // Astro extracts getStaticPaths into its own module and tree-shakes the rest of
  // the frontmatter away, so everything it needs has to come from an import.
  const accessions = loadAccessionMap()
  const ucscMappings = buildUcscMapping(accessions)
  const siblingIndex = buildSiblingIndex(accessions)
  const maxSiblings = 8

  return [...accessions.entries()]
    .filter(([id]) => !!id)
    .map(([id, data]) => {
      const { siblings = [], taxonCount = 1 } = siblingIndex.get(id) ?? {}
      return {
        params: { id },
        props: {
          data,
          pairedAssemblyData: data.pairedAccession
            ? accessions.get(data.pairedAccession)
            : undefined,
          ucscDbName: ucscMappings.get(id),
          siblings: siblings.slice(0, maxSiblings),
          siblingCount: siblings.length,
          taxonCount,
        },
      }
    })
}

const {
  data,
  pairedAssemblyData,
  ucscDbName,
  siblings,
  siblingCount,
  taxonCount,
} = Astro.props

const {
  accession,
  scientificName,
  ncbiAssemblyName,
  commonName,
  igvBrowserLink,
  ncbiBrowserLink,
  ucscBrowserLink,
  ucscDataLink,
  ncbiLink,
  taxonId,
  seqReleaseDate,
  assemblyStatus,
  assemblyType,
  submitterOrg,
  ncbiRefSeqCategory,
  suppressed,
  pairedAccession,
  ncbiMissing,
} = data

const {
  stats,
  pairedAssemblyStatus,
  pairedAssemblyDifferences,
  genomeNotes,
  suppressionReason,
  infraspecificNames,
  comments,
  gcPercent,
  genomeCoverage,
  sequencingTech,
  bioprojectAccession,
  annotationInfo,
  ncbiDownloadedAt,
} = loadNcbiDetails(accession)

// GCA = GenBank, GCF = RefSeq
const pairedLabel = pairedAccession?.startsWith('GCF')
  ? 'Paired RefSeq'
  : 'Paired GenBank'

const imageData = loadHubImage(accession)
const imageUrl = imageData?.imageUrl
const pageUrl = imageData?.pageUrl

const buscoBreakdown = annotationInfo?.busco
  ? [
      annotationInfo.busco.single_copy !== undefined
        ? `${(annotationInfo.busco.single_copy * 100).toFixed(1)}% single-copy`
        : null,
      annotationInfo.busco.duplicated !== undefined
        ? `${(annotationInfo.busco.duplicated * 100).toFixed(1)}% duplicated`
        : null,
      annotationInfo.busco.fragmented !== undefined
        ? `${(annotationInfo.busco.fragmented * 100).toFixed(1)}% fragmented`
        : null,
      annotationInfo.busco.missing !== undefined
        ? `${(annotationInfo.busco.missing * 100).toFixed(1)}% missing`
        : null,
    ].filter(Boolean)
  : []

// These 50K pages are the site's main entry point from a search engine, and until
// now they carried only a bare scientific-name title — identical across every
// assembly of the same species — and no description at all.
const assemblyLabel = [ncbiAssemblyName, accession].filter(Boolean).join(' ')
const pageTitle = `${scientificName} — ${assemblyLabel}`
// The bare common name: GenArk's own already repeats the assembly and year, which
// the label beside it states outright.
const organism = bareCommonName(commonName)
const pageDescription = [
  `${scientificName}${organism ? ` (${organism})` : ''} genome assembly`,
  `${assemblyLabel}.`,
  'Open it in the JBrowse 2 genome browser, see assembly statistics and',
  'annotation, and follow links to NCBI and UCSC.',
].join(' ')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: pageTitle,
  description: pageDescription,
  identifier: accession,
  url: new URL(Astro.url.pathname, Astro.site).href,
  sameAs: ncbiLink,
  ...(seqReleaseDate ? { datePublished: seqReleaseDate } : {}),
  ...(submitterOrg
    ? { creator: { '@type': 'Organization', name: submitterOrg } }
    : {}),
  keywords: [scientificName, organism, accession, ncbiAssemblyName].filter(
    Boolean,
  ),
  about: {
    '@type': 'Taxon',
    name: scientificName,
    ...(organism ? { alternateName: organism } : {}),
    identifier: `NCBI:txid${taxonId}`,
    sameAs: `https://www.ncbi.nlm.nih.gov/datasets/taxonomy/${taxonId}/`,
  },
}

const hasAssemblyStats =
  stats?.total_length ||
  stats?.chromosome_count ||
  stats?.scaffold_count ||
  stats?.contig_count ||
  gcPercent !== undefined ||
  genomeCoverage ||
  sequencingTech
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
>
  <Container>
    <div>
      <h1>{scientificName}</h1>
      {
        ncbiMissing ? (
          <p>
            <em>
              NCBI metadata not yet available for this assembly. Some details
              may be missing.
            </em>
          </p>
        ) : null
      }
      <div>
        <b>Accession:</b>
        {accession}
      </div>
      <div>
        <b>Assembly name:</b>
        {ncbiAssemblyName}
      </div>
      <div>
        <b>Common name:</b>
        {commonName}
      </div>
      <div>
        <b>TaxonID:</b>
        <a href={`/taxonomy/${taxonId}`}>{taxonId}</a>
      </div>
      {
        seqReleaseDate ? (
          <div>
            <b>Release date:</b> {seqReleaseDate}
          </div>
        ) : null
      }
      {
        assemblyStatus || assemblyType ? (
          <div>
            <b>Assembly:</b>{' '}
            {[assemblyStatus, assemblyType].filter(Boolean).join(', ')}
          </div>
        ) : null
      }
      {
        ncbiRefSeqCategory === 'reference genome' ? (
          <div>
            <b>NCBI assembly status:</b> Designated Reference <OrangeStar />
          </div>
        ) : null
      }
      {
        suppressed ? (
          <div>
            <b>NCBI assembly status:</b> RefSeq Suppressed <RedX />
            {suppressionReason ? (
              <div>
                <b>Reason:</b> {suppressionReason}
              </div>
            ) : null}
          </div>
        ) : null
      }
      {genomeNotes?.length ? <div>{genomeNotes.join('; ')}</div> : null}
      {
        infraspecificNames && Object.keys(infraspecificNames).length ? (
          <div>
            <b>Specimen:</b>{' '}
            {Object.entries(infraspecificNames)
              .map(([k, v]) => `${k}: ${v}`)
              .join(', ')}
          </div>
        ) : null
      }
      {
        pairedAccession ? (
          <div>
            <b>
              {pairedLabel}
              <span
                class={tooltipStyles.tooltip}
                data-tooltip="Same assembly submitted to both GenBank and RefSeq"
                style="cursor:help;font-size:0.75em"
              >
                {' '}
                ?
              </span>
              :
            </b>{' '}
            {pairedAssemblyData ? (
              <a href={`/accession/${pairedAccession}`}>{pairedAccession}</a>
            ) : (
              <>
                {pairedAccession} (
                <a
                  href={`https://www.ncbi.nlm.nih.gov/datasets/genome/${pairedAccession}/`}
                >
                  NCBI
                </a>
                )
              </>
            )}
            {pairedAssemblyStatus === 'suppressed' ? (
              <>
                {' '}
                <RedX />
              </>
            ) : null}
            {pairedAssemblyDifferences ? (
              <> — {pairedAssemblyDifferences}</>
            ) : null}
          </div>
        ) : null
      }

      {
        submitterOrg ? (
          <div>
            <b>Submitter:</b> {submitterOrg}
          </div>
        ) : null
      }
      {
        bioprojectAccession ? (
          <div>
            <b>BioProject:</b>{' '}
            <a
              href={`https://www.ncbi.nlm.nih.gov/bioproject/${bioprojectAccession}`}
            >
              {bioprojectAccession}
            </a>
          </div>
        ) : null
      }
    </div>
    {
      hasAssemblyStats ? (
        <div>
          <h2>Assembly statistics</h2>
          <dl class={styles.statsTable}>
            {stats?.total_length ? (
              <>
                <dt>Total length</dt>
                <dd>{Number(stats.total_length).toLocaleString()} bp</dd>
              </>
            ) : null}
            {stats?.ungapped_length ? (
              <>
                <dt>Ungapped length</dt>
                <dd>{Number(stats.ungapped_length).toLocaleString()} bp</dd>
              </>
            ) : null}
            {stats?.chromosome_count ? (
              <>
                <dt>Chromosomes</dt>
                <dd>{stats.chromosome_count}</dd>
              </>
            ) : null}
            {stats?.scaffold_count ? (
              <>
                <dt>Scaffolds</dt>
                <dd>{stats.scaffold_count}</dd>
              </>
            ) : null}
            {stats?.scaffold_n50 ? (
              <>
                <dt>Scaffold N50</dt>
                <dd>{Number(stats.scaffold_n50).toLocaleString()}</dd>
              </>
            ) : null}
            {stats?.scaffold_l50 ? (
              <>
                <dt>Scaffold L50</dt>
                <dd>{Number(stats.scaffold_l50).toLocaleString()}</dd>
              </>
            ) : null}
            {stats?.contig_count ? (
              <>
                <dt>Contigs</dt>
                <dd>{stats.contig_count}</dd>
              </>
            ) : null}
            {stats?.contig_n50 ? (
              <>
                <dt>Contig N50</dt>
                <dd>{Number(stats.contig_n50).toLocaleString()}</dd>
              </>
            ) : null}
            {stats?.contig_l50 ? (
              <>
                <dt>Contig L50</dt>
                <dd>{Number(stats.contig_l50).toLocaleString()}</dd>
              </>
            ) : null}
            {gcPercent !== undefined ? (
              <>
                <dt>GC content</dt>
                <dd>{gcPercent}%</dd>
              </>
            ) : null}
            {genomeCoverage ? (
              <>
                <dt>Coverage</dt>
                <dd>{genomeCoverage}x</dd>
              </>
            ) : null}
            {sequencingTech ? (
              <>
                <dt>Sequencing</dt>
                <dd>{sequencingTech}</dd>
              </>
            ) : null}
          </dl>
        </div>
      ) : null
    }
    {
      annotationInfo ? (
        <div>
          <h2>Annotation</h2>
          <dl class={styles.statsTable}>
            {annotationInfo.name ? (
              <>
                <dt>Name</dt>
                <dd>
                  {annotationInfo.name}
                  {annotationInfo.provider
                    ? ` (${annotationInfo.provider})`
                    : null}
                  {annotationInfo.release_date
                    ? `, ${annotationInfo.release_date}`
                    : null}
                </dd>
              </>
            ) : null}
            {annotationInfo.busco?.complete !== undefined ? (
              <>
                <dt>BUSCO completeness</dt>
                <dd>
                  {`${(annotationInfo.busco.complete * 100).toFixed(1)}% complete`}
                  {buscoBreakdown.length
                    ? ` (${buscoBreakdown.join(', ')})`
                    : null}
                  {annotationInfo.busco.busco_lineage
                    ? ` — ${annotationInfo.busco.busco_lineage}`
                    : null}
                </dd>
              </>
            ) : null}
            {annotationInfo.stats?.gene_counts ? (
              <>
                <dt>Gene counts</dt>
                <dd>
                  {annotationInfo.stats.gene_counts.total?.toLocaleString()}{' '}
                  total —{' '}
                  {annotationInfo.stats.gene_counts.protein_coding?.toLocaleString()}{' '}
                  protein-coding,{' '}
                  {annotationInfo.stats.gene_counts.non_coding?.toLocaleString()}{' '}
                  non-coding,{' '}
                  {annotationInfo.stats.gene_counts.pseudogene?.toLocaleString()}{' '}
                  pseudogenes
                </dd>
              </>
            ) : null}
          </dl>
        </div>
      ) : null
    }
    <div>
      {
        comments ? (
          <div>
            <b>Comments:</b>
            <div class={styles.comments}>{comments}</div>
          </div>
        ) : null
      }
      {
        imageUrl ? (
          <div class={styles.imageContainer}>
            <figure class={styles.figure}>
              <img
                src={imageUrl}
                class={styles.image}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {pageUrl ? <a href={pageUrl}>(source)</a> : null}
              </figcaption>
            </figure>
          </div>
        ) : null
      }
    </div>
    <div>
      <h2>Genome browsers</h2>
      {
        ucscDbName && (
          <p>
            See{' '}
            <a href={`/ucsc/${ucscDbName}`}>
              <b>{ucscDbName}</b>
            </a>{' '}
            for our full JBrowse instance of this assembly.
          </p>
        )
      }
      <ul>
        <li>
          <a
            href={jbrowseUrl(
              ucscDbName
                ? ucscConfigPath(ucscDbName)
                : genarkConfigPath(accession),
            )}>JBrowse</a
          >
        </li>
        <li>
          <a href={igvBrowserLink}>IGV.js</a>
        </li>
        <li>
          <a href={ncbiBrowserLink}>NCBI browser (GDV)</a>
        </li>
        <li>
          <a href={ucscBrowserLink}>UCSC browser</a>
        </li>
      </ul>
    </div>
    <div>
      <h2>Compare with other genomes</h2>
      <ul>
        <li>
          <a href={`/orthologs?ref=${taxonId}`}>
            Find a gene and its orthologs
          </a> across the other species we host
        </li>
        {
          features.synteny && syntenyAssemblies.has(accession) ? (
            <li>
              <a href={`/synteny?assembly=${accession}`}>
                Open a synteny view against an aligned assembly
              </a>
            </li>
          ) : null
        }
        {
          features.multiSynteny ? (
            <li>
              <a href="/conserved-gene-order">
                Compare gene order around a gene across species
              </a>
            </li>
          ) : null
        }
        <li>
          <a href={`/taxonomy/${taxonId}`}>
            Browse every assembly we host for this taxon
          </a>
        </li>
      </ul>
      {
        siblings.length ? (
          <>
            <h3>
              Other assemblies for {scientificName}
              {siblingCount > siblings.length
                ? ` (${siblings.length} of ${siblingCount})`
                : null}
            </h3>
            <table>
              <thead>
                <tr>
                  <th scope="col">Accession</th>
                  <th scope="col">Assembly name</th>
                  <th scope="col">Assembly status</th>
                  <th scope="col">Release date</th>
                  <th scope="col">NCBI status</th>
                </tr>
              </thead>
              <tbody>
                {siblings.map(sibling => (
                  <tr>
                    <td>
                      <a href={`/accession/${sibling.accession}`}>
                        {sibling.accession}
                      </a>
                    </td>
                    <td>{sibling.ncbiAssemblyName}</td>
                    <td>{sibling.assemblyStatus}</td>
                    <td>{sibling.seqReleaseDate.replace('00:00', '')}</td>
                    <td>
                      {sibling.isReference ? <OrangeStar /> : null}
                      {sibling.suppressed ? <RedX /> : null}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {siblingCount > siblings.length ? (
              <p>
                <a href={`/taxonomy/${taxonId}`}>
                  See all {taxonCount} assemblies for this taxon
                </a>
              </p>
            ) : null}
          </>
        ) : null
      }
    </div>
    <div>
      <h2>Portals/data downloads</h2>
      <ul>
        <li>
          <a href={ucscDataLink}>UCSC data folder</a>
        </li>
        <li>
          <a href={ncbiLink}>NCBI assembly page</a>
        </li>
        <li>
          <a
            href={`https://www.ncbi.nlm.nih.gov/datasets/taxonomy/${taxonId}/`}
          >
            NCBI taxonomy page
          </a>
        </li>
        <li>
          <a
            href={`https://www.google.com/search?q=${encodeURIComponent(scientificName)}`}
          >
            Google
          </a>
        </li>
        <li>
          <a
            href={`https://www.google.com/search?q=${encodeURIComponent(scientificName)}&udm=50`}
          >
            Google AI overview
          </a>
        </li>
      </ul>
    </div>
    <div>
      <small>
        Assembly data from{' '}
        <a href={ncbiLink}>NCBI</a> and{' '}
        <a href={ucscDataLink}>UCSC GenArk</a>.
        {
          ncbiDownloadedAt
            ? ` NCBI data retrieved ${new Date(ncbiDownloadedAt * 1000).toLocaleDateString()}.`
            : null
        }
      </small>
    </div>
  </Container>
</Layout>
