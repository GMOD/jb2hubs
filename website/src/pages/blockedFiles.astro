---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import { readFile } from 'fs/promises'
import { join } from 'path'
import '../styles/common-table.css'

// Read blockedFiles.json from project root
const blockedFilesPath = join(process.cwd(), 'blockedFiles.json')
let files: Array<{ url: string; lastChecked: number }> = []

try {
  const content = await readFile(blockedFilesPath, 'utf-8')
  const blockedData = JSON.parse(content)

  // Filter only blocked files and include timestamp
  files = Object.entries(blockedData)
    .filter(([_, value]: [string, any]) => value.blocked)
    .map(([url, value]: [string, any]) => ({
      url,
      lastChecked: value.lastChecked,
    }))
    .sort((a, b) => b.lastChecked - a.lastChecked) // Sort by most recent first
} catch (error) {
  console.error('Error reading blocked files:', error)
}

// Read removedTracks.json from project root
const removedTracksPath = join(process.cwd(), 'removedTracks.json')
let removedTracks: Array<{
  trackId: string
  name: string
  reason: string
  assembly: string
}> = []

try {
  const content = await readFile(removedTracksPath, 'utf-8')
  removedTracks = JSON.parse(content)
} catch (error) {
  console.error('Error reading removed tracks:', error)
}

// Format timestamp for display
function formatDate(timestamp: number): string {
  return new Date(timestamp).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

<Layout>
  <Container>
    <h3>Unavailable tracks</h3>
    <p>
      This is a list of files that are available at UCSC, but which we were not
      able to ping. See <a href="https://genome.ucsc.edu/license/">
        https://genome.ucsc.edu/license/
      </a> for more info. Most of these fall under this restriction category: "Certain
      genome annotation data, mostly on the human genome and in the domain of clinical
      genetics, have specific restrictions. For some of these, we are not allowed
      to make the data available. Usually the data must be obtained from the source
      database directly in the original format or licensed, rather from UCSC. Examples
      are HGMD, LOVD, OMIM, Decipher, Genomenon, Genehancer and COSMIC." These generally
      have re-sharing restrictions and are (currently) unavailable in JBrowse, though
      we may be able to load them. Please get in touch if you are interested in seeing
      them
    </p>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>File Path</th>
          <th>Last Checked</th>
        </tr>
      </thead>
      <tbody>
        {
          files.map((file, index) => (
            <tr key={index}>
              <td>{index + 1}</td>
              <td>{file.url}</td>
              <td>{formatDate(file.lastChecked)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h3 style="margin-top: 3rem;">Removed tracks</h3>
    <p>
      These tracks were intentionally excluded from JBrowse because they are
      either too verbose, laborious to configure correctly, or require
      specialized handling that is not yet implemented. If you would like to see
      any of these tracks added, please{' '}
      <a href="https://github.com/GMOD/jbrowse-components/issues">
        contact us on GitHub
      </a>{' '}
      or reach out via our{' '}
      <a href="https://gitter.im/GMOD/jbrowse2">community chat</a>.
    </p>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Assembly</th>
          <th>Track ID</th>
          <th>Track Name</th>
          <th>Reason</th>
        </tr>
      </thead>
      <tbody>
        {
          removedTracks.map((track, index) => (
            <tr key={index}>
              <td>{index + 1}</td>
              <td>{track.assembly}</td>
              <td>{track.trackId}</td>
              <td>{track.name}</td>
              <td>{track.reason}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Container>
</Layout>
