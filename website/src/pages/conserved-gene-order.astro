---
// /conserved-gene-order is now a section of the /gene hub (shown there when
// features.multiSynteny is on). The site is static, so the redirect is
// client-side; the query string (?gene=&ref=&anchors=&flank=) is the same
// contract, and the inline script carries it across. The meta refresh is the
// fallback without JavaScript, where the query is lost but the page is not.
const target = new URL('/gene', Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Gene</title>
    <link
      rel="canonical"
      href={target.href}
    />
    <meta
      http-equiv="refresh"
      content="0; url=/gene"
    />
    <script is:inline>
      location.replace('/gene' + location.search)
    </script>
  </head>
  <body>
    <p>Conserved gene order moved to <a href="/gene">/gene</a>.</p>
  </body>
</html>
