---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
---

<Layout
  title="Demos"
  description="Example JBrowse 2 sessions built from these hubs, including a whole-genome alignment between human hg38 and the T2T hs1 assembly."
>
  <Container>
    <h1>Demos</h1>
    <div>
      <figure class="demo-figure">
        <img
          class="demo-image"
          width={1526}
          height={625}
          src="/1.png"
          alt="Alignment between Human hg38 and T2T hs1 genomes"
        />
        <figcaption>
          This figure shows the alignment between the Human 'hg38' and T2T 'hs1'
          genomes. This is similar to Fig 5c from the paper announcing the T2T
          genome: <a
            href="https://www.science.org/doi/10.1126/science.abl3533#F5"
            >"A complete reference genome improves analysis of human genetic
            variation"</a
          >
          (<a
            href="https://jbrowse.org/code/jb2/latest/?config=https%3A%2F%2Fjbrowse.org%2Fucsc%2Fhg38%2Fconfig.json&session=share-01OPaHI22f&password=qU31H"
            >link to jbrowse session</a
          >)
        </figcaption>
      </figure>
    </div>
  </Container>
</Layout>

<style>
  .demo-figure {
    margin: 0;
  }

  .demo-image {
    width: 100%;
    height: auto;
  }
</style>
