---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import GenePage from '../components/GenePage.tsx'
---

<Layout
  title="Gene explorer"
  description="Look up a gene in a reference species and see it across every genome we host: its orthologs with one-click JBrowse 2 launches, and the deep tools it opens into: the full ortholog table, conserved gene order, the protein browser and synteny."
>
  <Container>
    <h1>Gene explorer</h1>
    <GenePage client:load />
  </Container>
</Layout>
