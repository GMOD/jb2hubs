---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import DataTable from '../../components/DataTable.tsx'
import UcscStatusBanner from '../../components/UcscStatusBanner.tsx'
import { categoryTable } from '../../components/DataTable/hubRow.ts'
import type { HubSource } from '../../components/DataTable/hubRow.ts'
import { hubCategories } from 'hubtools'

// Only the first page is rendered into the document; the rest arrives from
// public/hubData/<slug>.json (generateHubData.ts). Serializing whole categories as
// island props made this page 43MB for bacteria and showed a spinner until all of
// it had parsed.
//
// One page per GenArk category. processedHubJson also holds all.json, their
// union, and ucsc.json, the UCSC genome list, whose rows are dbs rather than hubs.
export async function getStaticPaths() {
  const categories = new Set(hubCategories.map(c => c.id))
  const modules = import.meta.glob('../../../processedHubJson/*.json')
  return Promise.all(
    Object.entries(modules)
      .map(([filepath, resolver]) => ({
        slug: filepath.split('/').pop()!.replace('.json', ''),
        resolver,
      }))
      .filter(({ slug }) => categories.has(slug))
      .map(async ({ slug, resolver }) => {
        const { default: data } = (await resolver()) as { default: HubSource[] }
        return { params: { slug }, props: { table: categoryTable(slug, data) } }
      }),
  )
}

const { slug } = Astro.params
const { table } = Astro.props

const title = slug.charAt(0).toUpperCase() + slug.slice(1)
---

<Layout
  title={`GenArk hubs - ${title}`}
  description={`Every ${slug} genome assembly in the UCSC GenArk collection, searchable and sortable, each one openable in JBrowse 2.`}
>
  <Container wide>
    <UcscStatusBanner client:idle />
    <div class="page-header">
      <h1 class="page-title">GenArk hubs - {title}</h1>
      <a
        href={`/taxonomy/${slug}`}
        class="taxonomy-link"
      >
        View taxonomy tree for GenArk {title}
      </a>
    </div>
    <DataTable
      {...table}
      client:load
    />
  </Container>
</Layout>

<style>
  .page-header {
    margin-bottom: 16px;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .page-title {
    margin: 0;
  }

  .taxonomy-link {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
