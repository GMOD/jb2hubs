---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import DataTable from '../../components/DataTable.tsx'
import { categoryTable } from '../../components/DataTable/hubRow.ts'
import type { HubSource } from '../../components/DataTable/hubRow.ts'

// Only the first page is rendered into the document; the rest arrives from
// public/hubData/<slug>.json (generateHubData.ts). Serializing whole categories as
// island props made this page 43MB for bacteria and showed a spinner until all of
// it had parsed.
export async function getStaticPaths() {
  const modules = import.meta.glob('../../../processedHubJson/*.json')
  const paths = await Promise.all(
    Object.entries(modules).map(async ([filepath, resolver]) => {
      const { default: data } = (await resolver()) as { default: HubSource[] }
      const slug = filepath.split('/').pop()!.replace('.json', '')
      return slug !== 'all'
        ? { params: { slug }, props: { table: categoryTable(slug, data) } }
        : undefined
    }),
  )
  return paths.filter(f => !!f)
}

const { slug } = Astro.params
const { table } = Astro.props

const title = slug.charAt(0).toUpperCase() + slug.slice(1)
---

<Layout
  title={`GenArk hubs - ${title}`}
  description={`Every ${slug} genome assembly in the UCSC GenArk collection, searchable and sortable, each one openable in JBrowse 2.`}
>
  <Container wide>
    <div class="page-header">
      <h1 class="page-title">GenArk hubs - {title}</h1>
      <a
        href={`/taxonomy/${slug}`}
        class="taxonomy-link"
      >
        View taxonomy tree for GenArk {title}
      </a>
    </div>
    <DataTable
      {...table}
      client:load
    />
  </Container>
</Layout>

<style>
  .page-header {
    margin-bottom: 16px;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .page-title {
    margin: 0;
  }

  .taxonomy-link {
    color: #2563eb;
    text-decoration: underline;
  }
</style>
