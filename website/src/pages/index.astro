---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import { exploreItems } from '../config/explore.ts'
import { homePageData } from '../lib/homePage.ts'

import '../styles/common-table.css'
import '../styles/ui.css'

const { assemblyCount, ucscCount, featured, clades, projects } = homePageData()
---

<Layout description="Browse and search over 50,000 genome assemblies from UCSC GenArk and the UCSC genome browser, each converted into a JBrowse 2 instance you can open in one click.">
  <Container>
    <h1>JBrowse 2 Genomes</h1>
    <p class="ui-lede">
      {assemblyCount.toLocaleString()} genome assemblies from the UCSC genome
      browser and UCSC GenArk, each one click from JBrowse 2.
    </p>

    <h2>UCSC genome browsers</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Assembly</th>
            <th scope="col">Organism</th>
            <th scope="col">Description</th>
            <th scope="col">Open in</th>
          </tr>
        </thead>
        <tbody>
          {featured.map(row => (
            <tr>
              <td>
                <a href={`/ucsc/${row.name}/`}>{row.name}</a>
              </td>
              <td>
                {row.organism} <i>{row.scientificName}</i>
              </td>
              <td>{row.description}</td>
              <td>
                <div class="ui-browsers">
                  <a
                    class="primary"
                    href={row.jbrowseLink}
                  >
                    JBrowse
                  </a>
                  <a href={row.ucscLink}>UCSC</a>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="more">
      <a href="/ucsc/">All {ucscCount} UCSC assemblies</a> ·{' '}
      <a href="/unavailableTracks/">Tracks not carried over from UCSC</a>
    </p>

    <h2>UCSC GenArk</h2>
    <p>
      UCSC's bulk-built genome browsers for NCBI assemblies of plants, animals
      and microbes.
    </p>
    <p class="more">
      <a href="https://hgdownload.soe.ucsc.edu/hubs/">About GenArk</a> ·{' '}
      <a href="/recently-updated/">Recently added</a>
    </p>
    <div class="groups">
      <section>
        <h3>By clade</h3>
        <ul class="group-list">
          {clades.map(group => (
            <li>
              <a href={`/hubs/${group.id}/`}>{group.label}</a>
              <span class="count">{group.count.toLocaleString()}</span>
            </li>
          ))}
        </ul>
      </section>
      <section>
        <h3>By project</h3>
        <ul class="group-list">
          {projects.map(group => (
            <li>
              <span>
                <a href={`/hubs/${group.id}/`}>{group.label}</a>{' '}
                <span class="description">{group.description}</span>
              </span>
              <span class="count">{group.count.toLocaleString()}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <h2>Tools</h2>
    <ul>
      {exploreItems.map(item => (
        <li>
          <a href={item.href}>{item.name}</a>: {item.blurb}
        </li>
      ))}
    </ul>
  </Container>
</Layout>

<style>
  .more {
    font-size: var(--text-md);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 0.5rem 2rem;
  }

  .groups h3 {
    margin: 0.5rem 0;
    font-size: 1rem;
  }

  .group-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border);
  }

  .description {
    color: var(--muted);
    font-size: var(--text-md);
  }

  .count {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
