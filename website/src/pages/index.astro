---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import GenArk from '../components/GenArk.astro'
import { features } from '../config/features.ts'
import { jbrowseUrl, ucscConfigPath } from '../config/jbrowse.ts'
import { ucscBrowserUrl } from '../lib/externalLinks.ts'

import list from '../list.json'
import '../styles/common-table.css'

// The handful worth putting on the front page; /ucsc lists all ~250.
const FEATURED_DBS = new Set(['hg38', 'hg19', 'hs1', 'mm39', 'mm10'])
---

<Layout
  description="Browse and search over 50,000 genome assemblies from UCSC GenArk and the UCSC genome browser, each converted into a JBrowse 2 instance you can open in one click."
>
  <Container>
    <h1>JBrowse 2 genome hubs</h1>

    <div>
      <h2>Main genome browsers</h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Scientific name</th>
              <th scope="col">Organism</th>
              <th scope="col">Description</th>
              <th scope="col">JBrowse</th>
              <th scope="col">UCSC</th>
            </tr>
          </thead>
          <tbody>
            {
              Object.entries(list.ucscGenomes)
                .filter(([key]) => FEATURED_DBS.has(key))
                .map(([key, val]) => (
                  <tr>
                    <td>
                      {key} (<a href={`/ucsc/${key}`}>info</a>)
                    </td>
                    <td>{val.scientificName}</td>
                    <td>{val.organism}</td>
                    <td>{val.description}</td>
                    <td>
                      <a href={jbrowseUrl(ucscConfigPath(key))}>JBrowse</a>
                    </td>
                    <td>
                      <a href={ucscBrowserUrl(key)}>UCSC</a>
                    </td>
                  </tr>
                ))
            }
          </tbody>
        </table>
      </div>
      <ul>
        <li>
          <a href="/ucsc">Click here</a> for a more complete listing
        </li>
      </ul>
      <p>
        Note that some tracks that are available at UCSC are not yet available
        here, see <a href="/unavailableTracks">here</a> for more info.
      </p>
    </div>

    <div>
      <h2>GenArk browsers</h2>
      <p>
        <a href="/recently-updated">Recently updated list</a>
      </p>
      <p>
        We also created JBrowse 2 instances based on the UCSC GenArk browser
        resources, which is an effort to bulk create genome browsers for
        numerous plant, animal, and microbial species. See <a
          href="https://hgdownload.soe.ucsc.edu/hubs/"
          >https://hgdownload.soe.ucsc.edu/hubs/</a
        > for more info.
      </p>
      <GenArk />
    </div>

    <div>
      <h2>Ortholog browser</h2>
      <p>
        Search a gene symbol and see its orthologs across the species we host,
        with genomic locations and one-click links into JBrowse 2 — plus a
        pairwise synteny view wherever the two assemblies have an alignment.
        Ortholog relationships come from the NCBI Datasets API.
      </p>
      <ul>
        <li>
          <a href="/gene">Search for a gene</a>
        </li>
      </ul>
    </div>

    {
      features.pangenome && (
        <>
          <div>
            <h2>Human Pangenome Reference Consortium (HPRC)</h2>
            <p>
              232 diploid human genome assemblies (464 haplotypes) from HPRC
              release 2, representing diverse global populations, with the
              release 2 Minigraph-Cactus graph against GRCh38 and CHM13.
            </p>
            <ul>
              <li>
                <a href="/pangenomes#hprc">
                  Browse HPRC assemblies and pangenome graphs
                </a>
              </li>
            </ul>
          </div>

          <div>
            <h2>Mouse strain assemblies</h2>
            <p>
              JBrowse 2 instances for inbred mouse strain assemblies from the
              UCSC Mouse Strains Hub (16 strains, mm10-based) and the Ensembl
              Mouse Genomes Project (18 strains, newer assemblies including two
              T2T).
            </p>
            <ul>
              <li>
                <a href="/pangenomes#mouse">
                  Browse all mouse strain assemblies
                </a>
              </li>
            </ul>
          </div>
        </>
      )
    }
  </Container>
</Layout>
