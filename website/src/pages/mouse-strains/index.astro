---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import mouseStrains from '../../mouseStrains.json'
import ensemblMouseStrains from '../../ensemblMouseStrains.json'
import '../../styles/common-table.css'
---

<Layout title="Mouse Strain Assemblies">
  <Container>
    <h1>Mouse Strain Assemblies</h1>

    <h2>Ensembl Mouse Genomes Project</h2>
    <p>
      18 inbred mouse strain assemblies from the <a
        href="https://projects.ensembl.org/mouse_genomes/"
        >Ensembl Mouse Genomes Project</a
      >, including two T2T assemblies, with GENCODE M30 annotation.
    </p>
    <table>
      <thead>
        <tr>
          <th>Strain</th>
          <th>Year</th>
          <th>Accession</th>
          <th>JAX</th>
          <th>JBrowse</th>
        </tr>
      </thead>
      <tbody>
        {
          ensemblMouseStrains.map(strain => (
            <tr>
              <td>{strain.strain}</td>
              <td>{strain.assemblyYear}</td>
              <td>
                <a href={`https://genomes.jbrowse.org/accession/${strain.accession}/`}>
                  {strain.accession}
                </a>
              </td>
              <td>
                {strain.jaxUrl ? <a href={strain.jaxUrl}>JAX</a> : null}
              </td>
              <td>
                <a href={strain.jbrowseLink}>JBrowse</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2>UCSC Mouse Strains Hub (2016)</h2>
    <p>
      16 inbred mouse strain assemblies from the <a
        href="https://hgdownload.soe.ucsc.edu/hubs/mouseStrains/hubIndex.html"
        >UCSC Mouse Strains Hub</a
      >, aligned to mm10 via Cactus with RNA-seq and cross-strain alignment
      tracks.
    </p>
    <table>
      <thead>
        <tr>
          <th>Strain</th>
          <th>Year</th>
          <th>Organism</th>
          <th>JAX</th>
          <th>JBrowse</th>
        </tr>
      </thead>
      <tbody>
        {
          mouseStrains.map(strain => (
            <tr>
              <td>{strain.genomeName.replaceAll('_', '/')}</td>
              <td>{strain.assemblyYear}</td>
              <td>{strain.organism}</td>
              <td>
                {strain.jaxUrl ? <a href={strain.jaxUrl}>JAX</a> : null}
              </td>
              <td>
                <a href={strain.jbrowseLink}>JBrowse</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Container>
</Layout>
