---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import OrthologSearch from '../components/OrthologSearch.tsx'
---

<Layout title="Gene Ortholog Navigator">
  <Container>
    <h1>Gene Ortholog Navigator</h1>
    <OrthologSearch client:load />
  </Container>
</Layout>

<style is:global>
  .orthologs-controls {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: flex-end;
    margin-bottom: 1rem;
  }

  .orthologs-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .orthologs-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #666;
  }

  .orthologs-input {
    padding: 6px 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    width: 220px;
  }

  .orthologs-select {
    padding: 6px 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: white;
  }

  .orthologs-search-btn {
    padding: 6px 16px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: white;
    align-self: flex-end;
  }

  .orthologs-hint {
    color: #666;
    font-size: 14px;
  }

  .orthologs-error {
    color: #c00;
    font-size: 14px;
  }

  .orthologs-summary {
    font-size: 14px;
    color: #555;
    margin-bottom: 0.75rem;
  }

  .orthologs-table {
    border-collapse: collapse;
    font-size: 13px;
    width: 100%;
  }

  .orthologs-table thead tr {
    border-bottom: 2px solid #ddd;
  }

  .orthologs-table th {
    text-align: left;
    padding: 4px 8px;
  }

  .orthologs-table tbody tr {
    border-bottom: 1px solid #eee;
  }

  .orthologs-table td {
    padding: 4px 8px;
  }

  .orthologs-loc {
    font-family: monospace;
    white-space: nowrap;
  }

  .orthologs-ref-label {
    margin-left: 0.4em;
    font-size: 11px;
    color: #999;
  }

  .orthologs-divider td {
    padding: 0;
    border-bottom: 2px solid #ddd;
  }
</style>
