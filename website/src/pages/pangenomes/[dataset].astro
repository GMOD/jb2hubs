---
// One pangenome graph, one page: the chromosomes as graph links, the locus
// catalogue as a table of launches, and the published files. All three graphs
// go through this route, because they publish the same projections and launch
// off the same builders; what is per-dataset is the numbers the dataset
// carries. No client JavaScript: every url is built here.
import Container from '../../components/Container.astro'
import {
  PANGENOME_DATASETS,
  publishedFiles,
} from '../../components/pangenomeDataset.ts'
import { graphRegionUrl } from '../../components/pangenomeLinks.ts'
import PangenomeRegionForms from '../../components/PangenomeRegionForms.tsx'
import { lociColumns, lociRows } from '../../components/pangenomeLociRows.ts'
import { features } from '../../config/features.ts'
import Layout from '../../layouts/Layout.astro'
import '../../styles/common-table.css'

import type { PangenomeDataset } from '../../components/pangenomeDataset.ts'

interface Props {
  dataset: PangenomeDataset
}

export function getStaticPaths() {
  return PANGENOME_DATASETS.map(dataset => ({
    params: { dataset: dataset.id },
    props: { dataset },
  }))
}

// The pangenomes section is staging-only while in development.
if (!features.pangenome) {
  return Astro.redirect('/')
}

const { dataset } = Astro.props
const rows = lociRows(dataset)
const columns = lociColumns(rows)
const chromosomes = (dataset.graphBrowser?.chromosomes ?? []).flatMap(c => {
  const url = graphRegionUrl(dataset, {
    chrom: c.name,
    start: 0,
    end: c.length,
    label: c.name,
  })
  return url ? [{ name: c.name, url }] : []
})

function humanBytes(bytes: number) {
  const scale = [
    { unit: 'GB', by: 1024 ** 3 },
    { unit: 'MB', by: 1024 ** 2 },
    { unit: 'KB', by: 1024 },
  ].find(s => bytes >= s.by)
  return scale
    ? `${(bytes / scale.by).toFixed(bytes / scale.by < 10 ? 1 : 0)} ${scale.unit}`
    : `${bytes} B`
}
---

<Layout
  title={dataset.heading}
  description={`${dataset.panelDescription}, projected onto ${dataset.reference.label} and drawable as a pangenome graph at any region.`}
>
  <Container>
    <p>
      <a href="/pangenomes">Pangenomes</a>
    </p>
    <h1>{dataset.heading}</h1>
    <p>
      {dataset.panelDescription}, projected onto {dataset.reference.label}.
    </p>
    <p>
      <a href={dataset.tutorialUrl}>Tutorial</a>
      {dataset.links.map(l => (
        <>
          {' · '}
          <a href={l.url}>{l.label}</a>
        </>
      ))}
    </p>

    {chromosomes.length > 0 && (
      <>
        <h2>Graph</h2>
        <p>
          Whole chromosome:
          {chromosomes.map(c => (
            <>
              {' '}
              <a
                href={c.url}
                target="_blank"
                rel="noreferrer"
              >
                {c.name}
              </a>
            </>
          ))}
        </p>
      </>
    )}

    {rows.length > 0 && (
      <>
        <h2>Loci</h2>
        {columns.haplotypes && (
          <p>
            Haplotypes opens one lane per structural configuration the callset
            finds at the locus, commonest first, each read from the graph in its
            own assembly's coordinates.
          </p>
        )}
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Gene</th>
                {columns.description && <th>Description</th>}
                {columns.variation && <th>Variation</th>}
                <th>Window</th>
                {columns.segments && <th>Segments</th>}
                {columns.launches && <th>Open</th>}
              </tr>
            </thead>
            <tbody>
              {rows.map(r => (
                <tr>
                  <td>{r.gene}</td>
                  {columns.description && <td>{r.description}</td>}
                  {columns.variation && <td>{r.variation}</td>}
                  <td>
                    <code>{r.window}</code>
                  </td>
                  {columns.segments && <td>{r.segments?.toLocaleString()}</td>}
                  {columns.launches && (
                    <td>
                      {r.graphUrl && (
                        <a
                          href={r.graphUrl}
                          target="_blank"
                          rel="noreferrer"
                        >
                          graph
                        </a>
                      )}
                      {r.graphUrl && r.linearUrl && ' · '}
                      {r.linearUrl && (
                        <a
                          href={r.linearUrl}
                          target="_blank"
                          rel="noreferrer"
                        >
                          {dataset.graphVcf ? 'variants' : 'bubbles'}
                        </a>
                      )}
                      {(r.graphUrl || r.linearUrl) && r.haplotypesUrl && ' · '}
                      {r.haplotypesUrl && (
                        <a
                          href={r.haplotypesUrl}
                          target="_blank"
                          rel="noreferrer"
                        >
                          haplotypes
                        </a>
                      )}
                      {(r.graphUrl || r.linearUrl || r.haplotypesUrl) &&
                        r.geneHubUrl &&
                        ' · '}
                      {r.geneHubUrl && <a href={r.geneHubUrl}>gene hub</a>}
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    {dataset.svStatesUrl && (
      <>
        <h2>Any region</h2>
        <p>
          The rows above are examples. For any other window, the callset says
          which structural forms {dataset.panelDescription.split(',')[0]} carry
          there and how common each is, and the launches open on those.
        </p>
        <PangenomeRegionForms
          dataset={dataset}
          client:idle
        />
      </>
    )}

    <h2>Files</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>File</th>
            <th>Contents</th>
            <th>Size</th>
          </tr>
        </thead>
        <tbody>
          {publishedFiles(dataset).map(f => (
            <tr>
              <td>
                <a href={`${dataset.filePrefix}${f.suffix}`}>
                  <code>{f.suffix}</code>
                </a>
              </td>
              <td>{f.what}</td>
              <td>{humanBytes(f.bytes)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Container>
</Layout>

<style>
  /* A window or a row of launches is one value; the description column is
     the one that wraps. */
  td code,
  td:last-child {
    white-space: nowrap;
  }
</style>
