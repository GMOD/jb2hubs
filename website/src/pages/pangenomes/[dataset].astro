---
// One pangenome graph, one page: the region box with the dataset's loci as its
// examples, and the published files folded under it. Every graph goes through
// this route, because they publish the same projections and launch off the
// same builders; what is per-dataset is the numbers the dataset carries. The
// region box is the page's only client JavaScript.
import Container from '../../components/Container.astro'
import {
  PANGENOME_DATASETS,
  publishedFiles,
} from '../../pangenome/pangenomeDataset.ts'
import PangenomeRegionBox from '../../pangenome/PangenomeRegionBox.tsx'
import { features } from '../../config/features.ts'
import Layout from '../../layouts/Layout.astro'
import '../../styles/common-table.css'
import '../../styles/ui.css'
import '../../styles/pangenome.css'

import type { PangenomeDataset } from '../../pangenome/pangenomeDataset.ts'

interface Props {
  dataset: PangenomeDataset
}

export function getStaticPaths() {
  return PANGENOME_DATASETS.map(dataset => ({
    params: { dataset: dataset.id },
    props: { dataset },
  }))
}

if (!features.pangenome) {
  return Astro.redirect('/')
}

const { dataset } = Astro.props

function humanBytes(bytes: number) {
  const scale = [
    { unit: 'GB', by: 1024 ** 3 },
    { unit: 'MB', by: 1024 ** 2 },
    { unit: 'KB', by: 1024 },
  ].find(s => bytes >= s.by)
  return scale
    ? `${(bytes / scale.by).toFixed(bytes / scale.by < 10 ? 1 : 0)} ${scale.unit}`
    : `${bytes} B`
}
---

<Layout
  title={dataset.heading}
  description={`${dataset.panelDescription}, as one pangenome graph on ${dataset.reference.label}, drawable at any gene or region.`}
>
  <Container>
    <p class="ui-crumb">
      <a href="/pangenomes/">Pangenomes</a>
    </p>
    <div class="ui-page-head">
      <h1>{dataset.heading}</h1>
      <a href={dataset.tutorialUrl}>Tutorial ↗</a>
    </div>

    <PangenomeRegionBox
      dataset={dataset}
      client:load
    />

    <details class="ui-fold">
      <summary>Files</summary>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>File</th>
              <th>Contents</th>
              <th class="ui-num">Size</th>
            </tr>
          </thead>
          <tbody>
            {publishedFiles(dataset).map(f => (
              <tr>
                <td>
                  <a href={`${dataset.filePrefix}${f.suffix}`}>
                    <code>{f.suffix}</code>
                  </a>
                </td>
                <td>{f.what}</td>
                <td class="ui-num">{humanBytes(f.bytes)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </Container>
</Layout>
