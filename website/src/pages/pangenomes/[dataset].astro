---
// One pangenome graph, one page: the region box with the dataset's loci as its
// examples, the chromosomes as graph links, and the published files. Every
// graph goes through this route, because they publish the same projections and
// launch off the same builders; what is per-dataset is the numbers the dataset
// carries. The region box is the page's only client JavaScript.
import Container from '../../components/Container.astro'
import {
  PANGENOME_DATASETS,
  publishedFiles,
} from '../../components/pangenomeDataset.ts'
import { graphRegionUrl } from '../../components/pangenomeLinks.ts'
import PangenomeRegionBox from '../../components/PangenomeRegionBox.tsx'
import { pangenomeExamples } from '../../components/pangenomeExamples.ts'
import { features } from '../../config/features.ts'
import Layout from '../../layouts/Layout.astro'
import '../../styles/common-table.css'

import type { PangenomeDataset } from '../../components/pangenomeDataset.ts'

interface Props {
  dataset: PangenomeDataset
}

export function getStaticPaths() {
  return PANGENOME_DATASETS.map(dataset => ({
    params: { dataset: dataset.id },
    props: { dataset },
  }))
}

if (!features.pangenome) {
  return Astro.redirect('/')
}

const { dataset } = Astro.props
const examples = pangenomeExamples(dataset)
const chromosomes = dataset.graphBrowser.chromosomes.map(c => ({
  name: c.name,
  url: graphRegionUrl(dataset, {
    chrom: c.name,
    start: 0,
    end: c.length,
    label: c.name,
  }),
}))

function humanBytes(bytes: number) {
  const scale = [
    { unit: 'GB', by: 1024 ** 3 },
    { unit: 'MB', by: 1024 ** 2 },
    { unit: 'KB', by: 1024 },
  ].find(s => bytes >= s.by)
  return scale
    ? `${(bytes / scale.by).toFixed(bytes / scale.by < 10 ? 1 : 0)} ${scale.unit}`
    : `${bytes} B`
}
---

<Layout
  title={dataset.heading}
  description={`${dataset.panelDescription}, as one pangenome graph on ${dataset.reference.label}, drawable at any gene or region.`}
>
  <Container>
    <p>
      <a href="/pangenomes">Pangenomes</a>
    </p>
    <h1>{dataset.heading}</h1>
    <p>
      {dataset.panelDescription}, as one graph on {dataset.reference.label}.
    </p>
    <p>
      {dataset.links.map((l, i) => (
        <>
          {i > 0 && ' · '}
          <a href={l.url}>{l.label}</a>
        </>
      ))}
    </p>

    <PangenomeRegionBox
      dataset={dataset}
      examples={examples}
      examplesLabel={
        dataset.loci.some(l => l.derived) ? 'Most variable' : 'Examples'
      }
      client:load
    />

    <h2>Whole chromosomes</h2>
    <p>
      {chromosomes.map(c => (
        <>
          <a
            href={c.url}
            target="_blank"
            rel="noreferrer"
          >
            {c.name}
          </a>{' '}
        </>
      ))}
    </p>

    <h2>Files</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>File</th>
            <th>Contents</th>
            <th>Size</th>
          </tr>
        </thead>
        <tbody>
          {publishedFiles(dataset).map(f => (
            <tr>
              <td>
                <a href={`${dataset.filePrefix}${f.suffix}`}>
                  <code>{f.suffix}</code>
                </a>
              </td>
              <td>{f.what}</td>
              <td>{humanBytes(f.bytes)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Container>
</Layout>
