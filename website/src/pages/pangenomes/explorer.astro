---
// /pangenomes/explorer was the variable-loci explorer until 2026-09-16; each
// graph's page now tables its own loci. The `?dataset=<id>` it took is the
// page's route, and the inline script carries it across. The meta refresh is
// the fallback without JavaScript, where the dataset is lost but the page is
// not.
import { PANGENOME_DATASETS } from '../../components/pangenomeDataset.ts'

const ids = PANGENOME_DATASETS.map(d => d.id)
const fallback = `/pangenomes/${ids[0]}`
const target = new URL(fallback, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Pangenome explorer</title>
    <link
      rel="canonical"
      href={target.href}
    />
    <meta
      http-equiv="refresh"
      content={`0; url=${fallback}`}
    />
    <script
      is:inline
      define:vars={{ ids, fallback }}
    >
      const dataset = new URLSearchParams(location.search).get('dataset')
      location.replace(
        ids.includes(dataset) ? `/pangenomes/${dataset}` : fallback,
      )
    </script>
  </head>
  <body>
    <p>
      The variable loci are on each pangenome's own page:
      {ids.map(id => (
        <>
          {' '}
          <a href={`/pangenomes/${id}`}>/pangenomes/{id}</a>
        </>
      ))}
    </p>
  </body>
</html>
