---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import hprcSamples from '../../hprcSamples.json'
import { features } from '../../config/features.ts'
import { retargetJbrowseUrl } from '../../config/jbrowse.ts'
import { graphBrowserUrl } from '../../components/pangenomeLinks.ts'
import OpenInDesktop from '../../components/OpenInDesktop.tsx'
import { HPRC_DATASET } from '../../components/pangenomeDataset.ts'
import '../../styles/common-table.css'
import '../../styles/portal.css'

// The pangenomes section is staging-only while in development.
if (!features.pangenome) {
  return Astro.redirect('/')
}

const browserUrl = graphBrowserUrl(HPRC_DATASET)

const RELEASE2 =
  'https://s3-us-west-2.amazonaws.com/human-pangenomics/pangenomes/freeze/release2'

// Sizes are stated because the spread is four orders of magnitude: the
// base-level GFA is ~60 GB and the SV-resolution rGFA beside it is under one.
// Release 2 publishes no plain-minigraph graph, and its PGGB graph is
// per-chromosome under a different naming scheme, so neither has a row.
const pangenomeGraphs = [
  {
    name: 'Minigraph-Cactus v2.0',
    refs: [
      {
        ref: 'GRCh38',
        vcf: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-grch38.wave.vcf.gz`,
        vcfSize: '2.2 GB',
        gbz: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-grch38.gbz`,
        gbzSize: '5.1 GB',
        gfa: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-grch38.gfa.gz`,
        gfaSize: '59 GB',
        svGfa: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-grch38.sv.gfa.gz`,
        svGfaSize: '803 MB',
      },
      {
        ref: 'CHM13',
        vcf: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-chm13.wave.vcf.gz`,
        vcfSize: '2.3 GB',
        gbz: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-chm13.gbz`,
        gbzSize: '5.4 GB',
        gfa: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-chm13.gfa.gz`,
        gfaSize: '60 GB',
        svGfa: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-chm13.sv.gfa.gz`,
        svGfaSize: '856 MB',
      },
    ],
  },
]
---

<Layout title="HPRC Assemblies">
  <Container>
    <h1>Human Pangenome Reference Consortium</h1>
    <p>
      The <a href="https://humanpangenome.org/"
        >Human Pangenome Reference Consortium (HPRC)</a
      > released a draft human pangenome reference built from 47 diploid assemblies
      representing diverse human populations. See the
      <a href="https://www.nature.com/articles/s41586-023-05896-x"
        >Nature 2023 paper</a
      > and the <a
        href="https://github.com/human-pangenomics/hpp_pangenome_resources"
        >pangenome resources repository</a
      > for full details.
    </p>
    <div class="portal-hero">
      <div class="portal-hero-text">
        <h2 class="portal-hero-title">Explore the pangenome interactively</h2>
        <p>
          Skip the file downloads — open the HPRC pangenome in the genome
          browser and see structural variants, presence/absence, and
          hypervariable loci across haplotypes.
        </p>
      </div>
      <div class="portal-hero-actions">
        <a
          class="portal-btn portal-btn-primary"
          href="/pangenomes/explorer"
        >
          Open the Pangenome Explorer →
        </a>
        <a
          class="portal-btn"
          href={browserUrl}
          target="_blank"
          rel="noreferrer"
        >
          Browse the pangenome in JBrowse →
        </a>
        <OpenInDesktop
          className="portal-btn portal-btn-ghost"
          webUrl={browserUrl}
        />
        <a
          class="portal-btn portal-btn-ghost"
          href="https://humanpangenome.org/"
          target="_blank"
          rel="noreferrer"
        >
          HPRC data portal ↗
        </a>
      </div>
    </div>

    <p>
      This page also lists the 232 individual sample assemblies (464 haplotypes
      total) available in JBrowse. See <a href="/hubs/HPRC"
        >the full GenArk HPRC listing</a
      > for a searchable table of all assemblies.
    </p>

    <h2>Pangenome Graphs</h2>
    <p>
      Release 2's minigraph-cactus graph, against both references (<a
        href="https://github.com/human-pangenomics/hpp_pangenome_resources"
        >full file listing</a
      >).
    </p>
    <table>
      <thead>
        <tr>
          <th>Graph</th>
          <th>Reference</th>
          <th>VCF</th>
          <th>GBZ</th>
          <th>SV GFA</th>
          <th>GFA</th>
        </tr>
      </thead>
      <tbody>
        {
          pangenomeGraphs.flatMap(g =>
            g.refs.map(r => (
              <tr>
                <td>{g.name}</td>
                <td>{r.ref}</td>
                <td>
                  <a href={r.vcf}>VCF</a> <small>{r.vcfSize}</small>
                </td>
                <td>
                  <a href={r.gbz}>GBZ</a> <small>{r.gbzSize}</small>
                </td>
                <td>
                  <a href={r.svGfa}>SV GFA</a> <small>{r.svGfaSize}</small>
                </td>
                <td>
                  <a href={r.gfa}>GFA</a> <small>{r.gfaSize}</small>
                </td>
              </tr>
            )),
          )
        }
      </tbody>
    </table>

    <h2>Individual Sample Assemblies</h2>
    <p>
      232 samples with phased diploid assemblies (haplotype 1 and haplotype 2).
      Assemblies are from the UCSC Genomics Institute via the UCSC GenArk hub.
    </p>
    <table>
      <thead>
        <tr>
          <th>Sample</th>
          <th>Year</th>
          <th>Haplotype 1</th>
          <th>Haplotype 2</th>
        </tr>
      </thead>
      <tbody>
        {
          hprcSamples.map(s => (
            <tr>
              <td>{s.sampleId}</td>
              <td>{s.hap1?.year ?? s.hap2?.year ?? ''}</td>
              <td>
                {s.hap1 ? (
                  <a href={retargetJbrowseUrl(s.hap1.jbrowseLink)}>
                    {s.hap1.accession}
                  </a>
                ) : (
                  '—'
                )}
              </td>
              <td>
                {s.hap2 ? (
                  <a href={retargetJbrowseUrl(s.hap2.jbrowseLink)}>
                    {s.hap2.accession}
                  </a>
                ) : (
                  '—'
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Container>
</Layout>
