---
// The choice between the graphs. Each has its own page under
// /pangenomes/<id>, rendered by [dataset].astro.
import Container from '../../components/Container.astro'
import { PANGENOME_DATASETS } from '../../pangenome/pangenomeDataset.ts'
import { features } from '../../config/features.ts'
import Layout from '../../layouts/Layout.astro'
import '../../styles/pangenome.css'

if (!features.pangenome) {
  return Astro.redirect('/')
}
---

<Layout
  title="Pangenomes"
  description={`Pangenome graphs in JBrowse 2, each drawable by region: ${PANGENOME_DATASETS.map(d => d.heading).join(', ')}.`}
>
  <Container>
    <h1>Pangenomes</h1>
    <ul class="ui-catalog">
      {PANGENOME_DATASETS.map(dataset => (
        <li>
          <a href={`/pangenomes/${dataset.id}/`}>{dataset.heading}</a>
          <span>
            {dataset.panelDescription}, as one graph on{' '}
            {dataset.reference.label}
          </span>
        </li>
      ))}
    </ul>
  </Container>
</Layout>
