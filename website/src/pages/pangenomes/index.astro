---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import { features } from '../../config/features.ts'
import '../../styles/portal.css'

// The pangenomes section is staging-only while in development.
if (!features.pangenome) {
  return Astro.redirect('/')
}
---

<Layout
  title="Pangenomes"
  description="Pangenome resources in JBrowse 2: the HPRC human assemblies and graph, and the inbred mouse strain assemblies."
>
  <Container>
    <h1>Pangenomes</h1>
    <p>
      Pangenome resources — many assemblies and the structural variation between
      them.
    </p>

    <div class="portal-cards">
      <a
        class="portal-card"
        href="/pangenomes/explorer"
      >
        <h2>Variable human loci</h2>
        <p>
          Specific GRCh38 loci where structure varies between haplotypes — copy
          number, gene presence/absence, tandem repeats, inversions — each with
          its HPRC variation summary and JBrowse launches.
        </p>
      </a>
      <a
        class="portal-card"
        href="/pangenomes/hprc"
      >
        <h2>Human — HPRC</h2>
        <p>
          232 diploid assemblies (464 haplotypes) from the Human Pangenome
          Reference Consortium, the Minigraph-Cactus / Minigraph / PGGB graphs,
          and one-click browser launches.
        </p>
      </a>
      <a
        class="portal-card"
        href="/pangenomes/mouse"
      >
        <h2>Mouse strains</h2>
        <p>
          Inbred mouse strain assemblies from the Ensembl Mouse Genomes Project
          (18 strains, incl. two T2T) and the UCSC Mouse Strains Hub (16
          strains, mm10-based).
        </p>
      </a>
    </div>
  </Container>
</Layout>
