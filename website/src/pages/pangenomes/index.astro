---
// The choice between the graphs. Each has its own page under
// /pangenomes/<id>, rendered by [dataset].astro.
import Container from '../../components/Container.astro'
import { PANGENOME_DATASETS } from '../../components/pangenomeDataset.ts'
import { features } from '../../config/features.ts'
import Layout from '../../layouts/Layout.astro'

// The pangenomes section is staging-only while in development.
if (!features.pangenome) {
  return Astro.redirect('/')
}
---

<Layout
  title="Pangenomes"
  description="Pangenome graphs in JBrowse 2: the HPRC human graph, a mouse strain pangenome, the bovine super-pangenome and the Arabidopsis 1001 Genomes Plus pangenome, each drawable by region."
>
  <Container>
    <h1>Pangenomes</h1>
    <ul>
      {PANGENOME_DATASETS.map(dataset => (
        <li>
          <a href={`/pangenomes/${dataset.id}`}>{dataset.heading}</a>
          <br />
          {dataset.panelDescription}, on {dataset.reference.label}
        </li>
      ))}
    </ul>
  </Container>
</Layout>
