---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import hprcSamples from '../../hprcSamples.json'
import mouseStrains from '../../mouseStrains.json'
import ensemblMouseStrains from '../../ensemblMouseStrains.json'
import { features } from '../../config/features.ts'
import {
  HOST_HAS_MULTISAMPLE_VARIANT_DISPLAY,
  retargetJbrowseUrl,
} from '../../config/jbrowse.ts'
import {
  externalGraphUrl,
  graphBrowserUrl,
  graphLocusUrl,
} from '../../components/pangenomeLinks.ts'
import OpenInDesktop from '../../components/OpenInDesktop.tsx'
import GraphRegionLauncher from '../../components/GraphRegionLauncher.tsx'
import { HPRC_DATASET } from '../../components/pangenomeDataset.ts'
import { detailWindow } from '../../components/pangenomeLoci.ts'
import '../../styles/common-table.css'
import '../../styles/portal.css'

// The pangenomes section is staging-only while in development.
if (!features.pangenome) {
  return Astro.redirect('/')
}

const browserUrl = graphBrowserUrl(HPRC_DATASET)
// The hero's graph launch opens the catalog's headline locus, the MHC — in the
// hosted graph view where the dataset has one (staging, until core v5), else
// in the external browser at the same window.
const mhc = HPRC_DATASET.loci.find(l => l.id === 'mhc-hla')
const graphUrl = mhc && graphLocusUrl(HPRC_DATASET, mhc)
const mhcWindow = mhc && detailWindow(mhc)
const ext = HPRC_DATASET.externalGraphBrowser
const externalMhcUrl =
  !graphUrl && mhc && mhcWindow
    ? externalGraphUrl(HPRC_DATASET, { ...mhcWindow, chrom: mhc.chrom })
    : undefined
const hostedGraph = HPRC_DATASET.graphBrowser !== undefined

const RELEASE2 =
  'https://s3-us-west-2.amazonaws.com/human-pangenomics/pangenomes/freeze/release2'

// Sizes are stated because the spread is four orders of magnitude: the
// base-level GFA is ~60 GB and the SV-resolution rGFA beside it is under one.
// Release 2 publishes no plain-minigraph graph, and its PGGB graph is
// per-chromosome under a different naming scheme, so neither has a row.
const pangenomeGraphs = [
  {
    name: 'Minigraph-Cactus v2.0',
    refs: [
      {
        ref: 'GRCh38',
        vcf: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-grch38.wave.vcf.gz`,
        vcfSize: '2.2 GB',
        gbz: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-grch38.gbz`,
        gbzSize: '5.1 GB',
        gfa: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-grch38.gfa.gz`,
        gfaSize: '59 GB',
        svGfa: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-grch38.sv.gfa.gz`,
        svGfaSize: '803 MB',
      },
      {
        ref: 'CHM13',
        vcf: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-chm13.wave.vcf.gz`,
        vcfSize: '2.3 GB',
        gbz: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-chm13.gbz`,
        gbzSize: '5.4 GB',
        gfa: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-chm13.gfa.gz`,
        gfaSize: '60 GB',
        svGfa: `${RELEASE2}/minigraph-cactus/hprc-v2.0-mc-chm13.sv.gfa.gz`,
        svGfaSize: '856 MB',
      },
    ],
  },
]
---

<Layout
  title="Pangenomes"
  description="Pangenome resources in JBrowse 2: the HPRC human assemblies and graph, and the inbred mouse strain assemblies."
>
  <Container>
    <h1>Pangenomes</h1>
    <p>
      Pangenome resources — many assemblies and the structural variation between
      them.
    </p>
    <p class="portal-contents">
      On this page: <a href="#hprc">Human — HPRC</a> ·
      <a href="#mouse">Mouse strains</a> · and the
      <a href="/pangenomes/explorer">variable human loci explorer</a>.
    </p>

    <div class="portal-cards">
      <a
        class="portal-card"
        href="/pangenomes/explorer"
      >
        <h2>Variable human loci</h2>
        <p>
          Specific GRCh38 loci where structure varies between haplotypes — copy
          number, gene presence/absence, tandem repeats, inversions — each with
          its HPRC variation summary and JBrowse launches.
        </p>
      </a>
    </div>

    <section id="hprc">
      <h2>Human Pangenome Reference Consortium</h2>
      <p>
        The <a href="https://humanpangenome.org/"
          >Human Pangenome Reference Consortium (HPRC)</a
        > builds a human pangenome reference from phased diploid assemblies of diverse
        human populations: 47 in the <a
          href="https://www.nature.com/articles/s41586-023-05896-x"
          >Nature 2023 draft</a
        >, 232 in release 2, which is what this section links. See the <a
          href="https://github.com/human-pangenomics/hpp_pangenome_resources"
          >pangenome resources repository</a
        > for full details.
      </p>
      <div class="portal-hero">
        <div class="portal-hero-text">
          <h3 class="portal-hero-title">Explore the pangenome interactively</h3>
          <p>
            Skip the file downloads — draw the graph itself, or open the HPRC
            pangenome on GRCh38 and see structural variants, presence/absence,
            and hypervariable loci across haplotypes.
          </p>
        </div>
        <div class="portal-hero-actions">
          {
            graphUrl && (
              <a
                class="portal-btn portal-btn-primary"
                href={graphUrl}
                target="_blank"
                rel="noreferrer"
              >
                Draw the MHC as a graph →
              </a>
            )
          }
          {
            externalMhcUrl && ext && (
              <a
                class="portal-btn portal-btn-primary"
                href={externalMhcUrl}
                target="_blank"
                rel="noreferrer"
                title={`${ext.name} draws the ${ext.graphLabel} graph at this window`}
              >
                Draw the MHC as a graph in {ext.name} ↗
              </a>
            )
          }
          <a
            class="portal-btn"
            href="/pangenomes/explorer?dataset=hprc"
          >
            Open the Pangenome Explorer →
          </a>
          <a
            class="portal-btn"
            href={browserUrl}
            target="_blank"
            rel="noreferrer"
          >
            Browse the pangenome on GRCh38 →
          </a>
          <OpenInDesktop
            className="portal-btn portal-btn-ghost"
            webUrl={browserUrl}
          />
          <a
            class="portal-btn portal-btn-ghost"
            href="https://humanpangenome.org/"
            target="_blank"
            rel="noreferrer"
          >
            HPRC data portal ↗
          </a>
        </div>
        {
          !HOST_HAS_MULTISAMPLE_VARIANT_DISPLAY && (
            <p class="portal-hero-note">
              <small>
                On the current JBrowse release the 464-haplotype callset opens
                as a single row; the per-haplotype matrix display ships in the
                next release.
              </small>
            </p>
          )
        }
      </div>

      <p>
        This section also lists the 232 individual sample assemblies (464
        haplotypes total) available in JBrowse. See <a href="/hubs/HPRC"
          >the full GenArk HPRC listing</a
        > for a searchable table of all assemblies.
      </p>

      {
        (hostedGraph || ext) && (
          <>
            <h3>Draw the graph</h3>
            {hostedGraph ? (
              <p>
                The minigraph-cactus graph on GRCh38, cut to a window and drawn
                as nodes and edges beside a linear view of the same window:
                bubbles are the alternative haplotypes, node color runs along
                the reference, and hovering one panel highlights the other. Type
                any GRCh38 region, or start from a locus where structure is
                known to vary. Inside JBrowse the same view opens from any
                region via the segments track&rsquo;s menu,{' '}
                <em>Launch → Graph genome view</em>, so the form is only the
                first cut.
              </p>
            ) : (
              ext && (
                <p>
                  Drawing the graph inside JBrowse needs a release newer than
                  the one this site links (the GraphGenomeView plugin boots on
                  v5 only). Until then, {ext.name} draws its {ext.graphLabel}{' '}
                  graph at any GRCh38 region — type one, or start from a locus
                  where structure is known to vary.
                </p>
              )
            )}
            <GraphRegionLauncher
              dataset={HPRC_DATASET}
              client:load
            />
            {hostedGraph && (
              <p>
                <small>
                  Needs the JBrowse build the staging site links; the
                  GraphGenomeView plugin does not load on released v4 hosts.
                  Loci that minigraph collapses onto one path (SMN1/2, RHD/RHCE,
                  CYP2D6) draw as a bare thread and are left out of the presets.
                </small>
              </p>
            )}
          </>
        )
      }

      <h3>Pangenome Graphs</h3>
      <p>
        Release 2's minigraph-cactus graph, against both references (<a
          href="https://github.com/human-pangenomics/hpp_pangenome_resources"
          >full file listing</a
        >).
      </p>
      <table>
        <thead>
          <tr>
            <th>Graph</th>
            <th>Reference</th>
            <th>VCF</th>
            <th>GBZ</th>
            <th>SV GFA</th>
            <th>GFA</th>
          </tr>
        </thead>
        <tbody>
          {
            pangenomeGraphs.flatMap(g =>
              g.refs.map(r => (
                <tr>
                  <td>{g.name}</td>
                  <td>{r.ref}</td>
                  <td>
                    <a href={r.vcf}>VCF</a> <small>{r.vcfSize}</small>
                  </td>
                  <td>
                    <a href={r.gbz}>GBZ</a> <small>{r.gbzSize}</small>
                  </td>
                  <td>
                    <a href={r.svGfa}>SV GFA</a> <small>{r.svGfaSize}</small>
                  </td>
                  <td>
                    <a href={r.gfa}>GFA</a> <small>{r.gfaSize}</small>
                  </td>
                </tr>
              )),
            )
          }
        </tbody>
      </table>

      <h3>Individual Sample Assemblies</h3>
      <p>
        232 samples with phased diploid assemblies (haplotype 1 and haplotype
        2). Assemblies are from the UCSC Genomics Institute via the UCSC GenArk
        hub.
      </p>
      <table>
        <thead>
          <tr>
            <th>Sample</th>
            <th>Year</th>
            <th>Haplotype 1</th>
            <th>Haplotype 2</th>
          </tr>
        </thead>
        <tbody>
          {
            hprcSamples.map(s => (
              <tr>
                <td>{s.sampleId}</td>
                <td>{s.hap1?.year ?? s.hap2?.year ?? ''}</td>
                <td>
                  {s.hap1 ? (
                    <a href={retargetJbrowseUrl(s.hap1.jbrowseLink)}>
                      {s.hap1.accession}
                    </a>
                  ) : (
                    '—'
                  )}
                </td>
                <td>
                  {s.hap2 ? (
                    <a href={retargetJbrowseUrl(s.hap2.jbrowseLink)}>
                      {s.hap2.accession}
                    </a>
                  ) : (
                    '—'
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section id="mouse">
      <h2>Mouse Strain Assemblies</h2>

      <div class="portal-hero">
        <div class="portal-hero-text">
          <h3 class="portal-hero-title">Browse strains interactively</h3>
          <p>
            Open the strain assemblies in a genome browser rather than starting
            from the download tables. There is no published mouse pangenome
            graph yet, but cross-strain variation (MGP, ~52 strains vs GRCm39)
            is available as data.
          </p>
        </div>
        <div class="portal-hero-actions">
          <a
            class="portal-btn portal-btn-primary"
            href="https://projects.ensembl.org/mouse_genomes/"
            target="_blank"
            rel="noreferrer"
          >
            Ensembl Mouse Genomes portal ↗
          </a>
          <a
            class="portal-btn"
            href="https://hgdownload.soe.ucsc.edu/hubs/mouseStrains/hubIndex.html"
            target="_blank"
            rel="noreferrer"
          >
            UCSC Mouse Strains Hub ↗
          </a>
          <a
            class="portal-btn portal-btn-ghost"
            href="https://ftp.ebi.ac.uk/pub/databases/mousegenomes/REL-2112-v8-SNPs_Indels/"
            target="_blank"
            rel="noreferrer"
          >
            MGP strain variation (GRCm39) ↗
          </a>
        </div>
      </div>

      <h3>Ensembl Mouse Genomes Project</h3>
      <p>
        18 inbred mouse strain assemblies from the <a
          href="https://projects.ensembl.org/mouse_genomes/"
          >Ensembl Mouse Genomes Project</a
        >, including two T2T assemblies, with GENCODE M30 annotation.
      </p>
      <table>
        <thead>
          <tr>
            <th>Strain</th>
            <th>Year</th>
            <th>Accession</th>
            <th>JAX</th>
            <th>JBrowse</th>
          </tr>
        </thead>
        <tbody>
          {
            ensemblMouseStrains.map(strain => (
              <tr>
                <td>{strain.strain}</td>
                <td>{strain.assemblyYear}</td>
                <td>
                  <a href={`/accession/${strain.accession}/`}>
                    {strain.accession}
                  </a>
                </td>
                <td>
                  {strain.jaxUrl ? <a href={strain.jaxUrl}>JAX</a> : null}
                </td>
                <td>
                  <a href={retargetJbrowseUrl(strain.jbrowseLink)}>JBrowse</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h3>UCSC Mouse Strains Hub (2016)</h3>
      <p>
        16 inbred mouse strain assemblies from the <a
          href="https://hgdownload.soe.ucsc.edu/hubs/mouseStrains/hubIndex.html"
          >UCSC Mouse Strains Hub</a
        >, aligned to mm10 via Cactus with RNA-seq and cross-strain alignment
        tracks.
      </p>
      <table>
        <thead>
          <tr>
            <th>Strain</th>
            <th>Year</th>
            <th>Organism</th>
            <th>JAX</th>
            <th>JBrowse</th>
          </tr>
        </thead>
        <tbody>
          {
            mouseStrains.map(strain => (
              <tr>
                <td>{strain.genomeName.replaceAll('_', '/')}</td>
                <td>{strain.assemblyYear}</td>
                <td>{strain.organism}</td>
                <td>
                  {strain.jaxUrl ? <a href={strain.jaxUrl}>JAX</a> : null}
                </td>
                <td>
                  <a href={retargetJbrowseUrl(strain.jbrowseLink)}>JBrowse</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </Container>
</Layout>

<style is:global>
  .portal-contents {
    color: var(--muted);
    font-size: 14px;
  }
  .portal-hero-note {
    flex: 1 0 100%;
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
  .graph-launcher {
    margin: 1rem 0 1.5rem;
  }
  .graph-launcher-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .graph-launcher-form label {
    font-weight: 600;
  }
  .graph-launcher-form input {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 8px 10px;
    font: inherit;
    font-family: ui-monospace, monospace;
    border: 1px solid var(--border, #ccc);
    border-radius: 6px;
  }
  .graph-launcher-form button {
    font: inherit;
    cursor: pointer;
  }
  .graph-launcher-form button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .graph-launcher-note {
    margin: 0.5rem 0;
    font-size: 14px;
    color: var(--muted);
  }
  .graph-launcher-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .graph-launcher-presets .pg-filter {
    text-decoration: none;
    padding: 4px 10px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: #444;
    background: #f3f3f3;
    border: 1px solid #ddd;
    border-radius: 999px;
    cursor: pointer;
  }
  .graph-launcher-presets .pg-filter-active {
    color: white;
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
