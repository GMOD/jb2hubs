---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import ProteinMsaExplorer from '../components/ProteinMsaExplorer.tsx'
import { features } from '../config/features.ts'

if (!features.proteinMsa) {
  return Astro.redirect('/')
}
---

<Layout title="Protein alignment">
  <Container>
    <h1>Ortholog protein alignment & domains</h1>
    <p>
      Enter a gene and reference organism: this resolves the gene's NCBI
      orthologs, picks a representative protein per species, and draws each
      protein's NCBI CDD conserved domains as a domain-architecture cartoon —
      the quick view of whether the orthologs share the same domains. Open the
      full multiple sequence alignment to align the proteins residue-by-residue
      with EBI Clustal Omega and overlay the domains in react-msaview; that step
      runs at EBI and can take up to a minute. This is the residue-level
      complement to the
      <a href="/conserved-gene-order">conserved gene order</a> view.
    </p>
    <ProteinMsaExplorer client:only="react" />
  </Container>
</Layout>

<style is:global>
  .msv-form {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 1.25rem 0;
    flex-wrap: wrap;
  }
  .msv-form input,
  .msv-form select {
    padding: 7px 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }
  .msv-form input {
    min-width: 220px;
  }
  .msv-form button {
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 600;
    color: white;
    background: #0b69d4;
    border: 1px solid #0b69d4;
    border-radius: 4px;
    cursor: pointer;
  }
  .msv-form button:disabled {
    background: #f0f0f0;
    color: #999;
    border-color: #ddd;
    cursor: not-allowed;
  }
  .msv-hint {
    color: #666;
    font-size: 14px;
  }
  .msv-error {
    color: #b00020;
    font-size: 14px;
  }
  .msv-examples {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    font-size: 13px;
    color: #666;
  }
  .msv-example-chip {
    padding: 4px 12px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #0b69d4;
    border-radius: 999px;
    background: #0b69d4;
    color: white;
    cursor: pointer;
  }
  .msv-example-chip:hover:not(:disabled) {
    background: #0a5cba;
    border-color: #0a5cba;
  }
  .msv-example-chip:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .msv-scope {
    color: #666;
    font-size: 13px;
    margin: 0 0 1rem;
    max-width: 60ch;
  }
  .msv-note {
    color: #8a6d3b;
    font-size: 13px;
    margin: 0.25rem 0;
  }

  /* Domain-architecture cartoon (ProteinDomainCartoon) */
  .pdc {
    margin: 0.75rem 0 1rem;
  }
  .pdc-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pdc-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pdc-name {
    flex: 0 0 140px;
    font-size: 13px;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdc-track {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .pdc-bar {
    position: relative;
    height: 16px;
    background: #eef1f5;
    border: 1px solid #dce0e6;
    border-radius: 3px;
  }
  .pdc-domain {
    position: absolute;
    top: -1px;
    height: 16px;
    border-radius: 3px;
    opacity: 0.9;
  }
  .pdc-len {
    flex: 0 0 auto;
    font-size: 11px;
    color: #999;
    font-variant-numeric: tabular-nums;
  }
  .pdc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 12px;
    font-size: 12px;
    color: #444;
  }
  .pdc-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .pdc-swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }

  .msv-advanced {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 1.25rem 0;
  }
  .msv-advanced-btn {
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 600;
    color: #0b69d4;
    background: white;
    border: 1px solid #0b69d4;
    border-radius: 4px;
    cursor: pointer;
  }
  .msv-advanced-btn:hover:not(:disabled) {
    background: #eaf3fd;
  }
  .msv-advanced-btn:disabled {
    color: #999;
    background: #f0f0f0;
    border-color: #ddd;
    cursor: progress;
  }
  .msv-advanced-note {
    font-size: 12px;
    color: #999;
  }
</style>
