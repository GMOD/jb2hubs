---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import ProteinBrowser from '../components/ProteinBrowser.tsx'
import { features } from '../config/features.ts'

if (!features.proteinBrowser) {
  return Astro.redirect('/')
}
---

<Layout
  title="Protein browser"
  description="Open a gene in JBrowse 2 with its structure and a cross-species protein alignment beside it, one residue lit in all three views."
>
  <Container>
    <h1>Protein browser</h1>
    <ProteinBrowser client:only="react">
      <p
        slot="fallback"
        class="ui-hint"
      >
        Loading the protein browser…
      </p>
    </ProteinBrowser>
  </Container>
</Layout>

<style is:global>
  .msv-examples {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .msv-result {
    margin-top: 1.5rem;
  }

  .pm-section {
    margin: 1.25rem 0 1rem;
  }
  .pm-lanes {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .pm-lane {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pm-lane-name {
    flex: 0 0 140px;
    font-size: var(--text-xs);
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pm-partner {
    color: var(--text);
  }
  .pm-track {
    position: relative;
    flex: 1 1 auto;
    height: 14px;
    min-width: 0;
    background: var(--surface-alt);
    border-radius: 3px;
  }
  .pm-lane-thin .pm-track {
    height: 8px;
  }
  .pm-ruler .pm-track {
    background: none;
    border-bottom: 1px solid var(--field-border);
  }
  .pm-tick {
    position: absolute;
    top: 0;
    font-size: 0.625rem;
    line-height: 1.2;
    color: var(--faint);
    transform: translateX(-50%);
    font-variant-numeric: tabular-nums;
  }
  .pm-tick::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -5px;
    height: 4px;
    border-left: 1px solid var(--field-border);
  }
  .pm-tick-end {
    right: 0;
    transform: none;
    color: var(--muted);
  }
  .pm-tick-end::after {
    display: none;
  }
  .pm-block {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 2px;
    padding: 0 3px;
    border: 0;
    border-radius: 3px;
    color: var(--surface);
    font-size: var(--text-2xs);
    line-height: 14px;
    text-align: left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0.9;
    cursor: pointer;
  }
  /* Lanes sit 3 px apart, so the hover cue stays inside the block. */
  .pm-block:hover,
  .pm-interface:hover {
    opacity: 1;
    filter: brightness(0.8);
  }
  .pm-block:focus-visible,
  .pm-interface:focus-visible {
    opacity: 1;
    outline: 2px solid var(--text);
    outline-offset: 1px;
  }
  /* Selection rings the block from inside, for the same reason. */
  .pm-block.selected,
  .pm-interface.selected {
    opacity: 1;
    outline: 1px solid var(--text);
    outline-offset: 0;
    box-shadow: inset 0 0 0 2px var(--surface);
  }
  .pm-interface {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 3px;
    cursor: pointer;
  }
  .pm-run {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 2px;
    background: #d1495b;
    border-radius: 2px;
  }
  .pm-residue {
    position: absolute;
    top: -2px;
    width: 3px;
    height: calc(100% + 4px);
    margin-left: -1px;
    background: var(--text);
    border-radius: 1px;
  }
  /* A lane whose name asks for its rows: partners and ligands load on request. */
  .pm-lane-btn {
    padding: 0;
    font-family: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .pm-lane-btn:hover {
    text-decoration: underline;
  }
  .pm-lane-btn[aria-busy='true'] {
    color: var(--muted);
    cursor: progress;
  }
  .pm-track-note {
    position: absolute;
    left: 6px;
    font-size: var(--text-2xs);
    line-height: 14px;
    color: var(--faint);
    white-space: nowrap;
  }
  .pm-track-error {
    color: var(--danger);
  }
  @media (max-width: 767px) {
    .pm-lane-name {
      flex-basis: 80px;
    }
  }
  .msv-result h2 {
    margin: 0 0 0.6rem;
    font-size: 1.25rem;
  }
  .msv-result h2 > a {
    color: inherit;
    text-decoration: none;
  }
  .msv-result h2 > a:hover {
    text-decoration: underline;
  }
  .msv-sub {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--muted);
  }
  .msv-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .msv-open {
    padding: 8px 18px;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--surface);
    background: var(--accent);
    border-radius: 4px;
    text-decoration: none;
  }
  .msv-open:hover {
    background: var(--accent-hover);
  }
  .msv-open-desktop {
    font-size: var(--text-sm);
  }
  .msv-open-disabled,
  .msv-open-disabled:hover {
    background: var(--faint);
    cursor: default;
  }

  .msv-control {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    margin-bottom: 0.8rem;
    font-size: var(--text-sm);
  }
  .msv-residue {
    min-width: 0;
    width: 13rem;
  }
  .msv-control-label {
    flex: 0 0 5.5rem;
    font-weight: 600;
    color: var(--muted);
  }
  /* Advanced: the controls a first look does without, one block on the card. */
  .msv-advanced {
    margin: 0 0 0.8rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--field-border);
  }
  .msv-advanced .msv-control {
    margin-bottom: 0.4rem;
  }
  .msv-advanced-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    font-size: var(--text-sm);
    color: var(--muted);
    cursor: pointer;
  }
</style>
