---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import ProteinBrowser from '../components/ProteinBrowser.tsx'
import { features } from '../config/features.ts'

if (!features.proteinBrowser) {
  return Astro.redirect('/')
}
---

<Layout
  title="Protein browser"
  description="Enter a gene and open it in JBrowse 2 with its coding exons back to back, an AlphaFold or PDB structure and a cross-species protein alignment in one connected session — hover a residue and its codon lights up in every view."
>
  <Container>
    <h1>Protein browser</h1>
    <p class="ui-lede">
      Open a gene in JBrowse with its structure and a cross-species alignment,
      one residue lit in all three.
    </p>
    <ProteinBrowser client:only="react">
      <p
        slot="fallback"
        class="ui-hint"
      >
        Loading the protein browser…
      </p>
    </ProteinBrowser>
  </Container>
</Layout>

<style is:global>
  /* The gene box and its suggestion list; positioned so the listbox overlays
     what follows instead of pushing the examples row down as you type. */
  .msv-combobox {
    position: relative;
  }
  .msv-listbox {
    position: absolute;
    z-index: 20;
    top: calc(100% + 2px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 4px 0;
    list-style: none;
    max-height: 260px;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--field-border);
    border-radius: 4px;
    box-shadow: 0 4px 12px rgb(0 0 0 / 12%);
  }
  .msv-option {
    padding: 5px 10px;
    font-size: var(--text-md);
    cursor: pointer;
  }
  .msv-option.highlighted {
    background: var(--accent-wash);
  }

  /* Which of the two alignments to show, offered only where both exist. */
  .msv-source {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0.6rem 0;
    font-size: var(--text-sm);
  }
  .msv-source-label {
    font-weight: 600;
    color: var(--muted);
  }
  .msv-source-option {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text);
    cursor: pointer;
  }

  /* An alignment is a wide matrix, and the article measure (60rem) shows a
     sliver of it. Break out to the window width: the content box is centered in
     the viewport, so offsetting by half the difference recentres the wider box
     on the same axis. Capped so an ultrawide monitor does not stretch the tree
     gutter across a metre of desk. */
  .msv-align {
    --msv-align-width: min(96vw, 1800px);
    width: var(--msv-align-width);
    margin: 1rem 0 1rem calc(50% - var(--msv-align-width) / 2);
  }
  @media (max-width: 767px) {
    .msv-align {
      --msv-align-width: 100%;
      margin-left: 0;
    }
  }

  /* Expanded: the whole viewport, since that is the point of expanding. */
  .msv-align-dialog {
    width: 96vw;
    max-width: 96vw;
    height: 94vh;
    max-height: 94vh;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  .msv-align-dialog::backdrop {
    background: rgb(0 0 0 / 45%);
  }

  .msv-align-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .msv-align-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--muted);
  }

  .msv-dialog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
  .msv-code {
    margin: 0.5rem 0;
    padding: 0.6rem 0.75rem;
    font-size: var(--text-xs);
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow-x: auto;
    white-space: pre;
  }
  .msv-code-scroll {
    max-height: 280px;
    overflow-y: auto;
    font-size: var(--text-2xs);
  }
  .msv-examples {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* Domain-architecture cartoon (ProteinDomainCartoon) */
  .pdc {
    margin: 0.5rem 0 0.75rem;
  }
  .pdc-rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pdc-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pdc-name {
    flex: 0 0 140px;
    font-size: var(--text-2xs);
    line-height: 1.2;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdc-track {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .pdc-bar {
    position: relative;
    height: 10px;
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: 3px;
  }
  .pdc-domain {
    position: absolute;
    top: -1px;
    height: 10px;
    border: 0;
    padding: 0;
    border-radius: 3px;
    opacity: 0.9;
  }
  .pdc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 8px;
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .pdc-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  /* CDD names run from "P53" to a 128-character sentence, so the long ones are
     clipped rather than allowed to wrap the legend into a paragraph. The full
     name and the species count are on the item's title. */
  .pdc-legend-name {
    max-width: 22ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pdc-legend-count {
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .pdc-swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }

  .msv-result {
    margin-top: 1.5rem;
  }

  /* The protein map (ProteinMap): one protein end to end, lanes of InterPro
     domains and PDBe partner interfaces, every block a launch target. */
  .pm-section {
    margin: 1.25rem 0 1rem;
  }
  .pm-title {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .pm-lanes {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .pm-lane {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pm-lane-name {
    flex: 0 0 140px;
    font-size: var(--text-xs);
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pm-partner {
    color: var(--text);
  }
  .pm-track {
    position: relative;
    flex: 1 1 auto;
    height: 14px;
    min-width: 0;
    background: var(--surface-alt);
    border-radius: 3px;
  }
  .pm-lane-thin .pm-track {
    height: 8px;
  }
  .pm-ruler .pm-track {
    height: 14px;
    background: none;
    border-bottom: 1px solid var(--field-border);
  }
  .pm-tick {
    position: absolute;
    top: 0;
    font-size: 0.625rem;
    line-height: 1.2;
    color: var(--faint);
    transform: translateX(-50%);
    font-variant-numeric: tabular-nums;
  }
  .pm-tick::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -5px;
    height: 4px;
    border-left: 1px solid var(--field-border);
  }
  .pm-tick-end {
    right: 0;
    transform: none;
    color: var(--muted);
  }
  .pm-tick-end::after {
    display: none;
  }
  .pm-block {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 2px;
    padding: 0 3px;
    border: 0;
    border-radius: 3px;
    color: var(--surface);
    font-size: var(--text-2xs);
    line-height: 14px;
    text-align: left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0.9;
    cursor: pointer;
  }
  .pm-lane-thin .pm-block {
    line-height: 8px;
    font-size: 0;
  }
  /* Lanes sit 3 px apart, so the hover cue stays inside the block. */
  .pm-block:hover,
  .pm-interface:hover {
    opacity: 1;
    filter: brightness(0.8);
  }
  .pm-block:focus-visible,
  .pm-interface:focus-visible {
    opacity: 1;
    outline: 2px solid var(--text);
    outline-offset: 1px;
  }
  .pm-block.selected,
  .pm-interface.selected {
    opacity: 1;
    outline: 2px solid var(--text);
    outline-offset: 1px;
    box-shadow: 0 0 0 4px rgb(255 255 255 / 90%);
  }
  .pm-block-label {
    pointer-events: none;
  }
  .pm-interface {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 3px;
    cursor: pointer;
  }
  .pm-run {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 2px;
    background: #d1495b;
    border-radius: 2px;
  }
  .pm-residue {
    position: absolute;
    top: -2px;
    width: 3px;
    height: calc(100% + 4px);
    margin-left: -1px;
    background: var(--text);
    border-radius: 1px;
  }
  /* A lane whose name asks for its rows: sites and partners load on request. */
  .pm-lane-btn {
    padding: 0;
    font-family: inherit;
    text-align: right;
    color: var(--accent);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .pm-lane-btn:hover:not(:disabled) {
    text-decoration: underline;
  }
  .pm-lane-btn:disabled {
    color: var(--muted);
    cursor: default;
  }
  .pm-track-note {
    position: absolute;
    left: 6px;
    font-size: var(--text-2xs);
    line-height: 14px;
    color: var(--faint);
    white-space: nowrap;
  }
  .pm-track-error {
    color: var(--danger);
  }
  @media (max-width: 767px) {
    .pm-lane-name,
    .pdc-name {
      flex-basis: 80px;
    }
  }
  .msv-result h2 {
    margin: 0 0 0.15rem;
    font-size: 1.25rem;
  }
  .msv-sub {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--muted);
  }
  .msv-meta {
    margin: 0 0 0.6rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .msv-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  /* The view toggles, the session dump and a chip's story, folded: every
     default is on, and the story is for the reader who asks. */
  .msv-fold {
    margin: 0.4rem 0 0;
    font-size: var(--text-sm);
  }
  .msv-fold > summary {
    color: var(--muted);
    cursor: pointer;
  }
  .msv-fold[open] > summary {
    margin-bottom: 0.4rem;
  }
  .msv-fold .msv-collapse,
  .msv-fold .ui-linkbtn {
    display: flex;
    margin: 0.3rem 0;
  }
  .msv-fold > p {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
  }
  .msv-open {
    padding: 8px 18px;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--surface);
    background: var(--accent);
    border-radius: 4px;
    text-decoration: none;
  }
  .msv-open:hover {
    background: var(--accent-hover);
  }
  .msv-open-desktop {
    margin-left: 0.75rem;
    font-size: var(--text-sm);
  }
  .msv-open-disabled,
  .msv-open-disabled:hover {
    background: var(--faint);
    cursor: default;
  }

  /* What the session opens with: isoform, structure, superposed species, the
     domain to land on. Each row is a label and one control, so the card reads as
     a form rather than a paragraph of chips. */
  .msv-controls {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0.6rem 0 0.8rem;
    font-size: var(--text-sm);
  }
  .msv-control {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
  }
  .msv-control .ui-select {
    max-width: 100%;
  }
  .msv-residue {
    min-width: 0;
    width: 13rem;
  }
  .msv-control-label {
    flex: 0 0 5.5rem;
    font-weight: 600;
    color: var(--muted);
  }
  .msv-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .pdc-row-query .pdc-name {
    font-weight: 600;
  }
  .pdc-superpose-cell {
    flex: 0 0 26px;
    display: inline-flex;
    justify-content: center;
  }
  .pdc-superpose {
    padding: 0 3px;
    font-size: 0.5625rem;
    line-height: 11px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--field-border);
    border-radius: 3px;
    cursor: pointer;
  }
  .pdc-superpose:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pdc-superpose.on {
    color: var(--surface);
    background: var(--accent);
    border-color: var(--accent);
  }
  .pdc-domain.clickable {
    cursor: pointer;
  }
  .pdc-domain.clickable:hover {
    opacity: 1;
    filter: brightness(0.8);
  }
  .pdc-domain.clickable:focus-visible {
    opacity: 1;
    outline: 2px solid var(--text);
    outline-offset: 1px;
  }
  .pdc-domain.selected {
    opacity: 1;
    outline: 2px solid var(--text);
    outline-offset: 1px;
    box-shadow: 0 0 0 4px rgb(255 255 255 / 90%);
  }
  .msv-collapse {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .msv-advanced {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 1rem 0 0;
  }
</style>
