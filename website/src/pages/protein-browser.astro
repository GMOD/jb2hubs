---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import ProteinBrowser from '../components/ProteinBrowser.tsx'
import { features } from '../config/features.ts'

if (!features.proteinBrowser) {
  return Astro.redirect('/')
}
---

<Layout
  title="Protein browser"
  description="Enter a gene and compare its protein across model organisms: domain architecture, a residue-level alignment, the AlphaFold structure, and a connected JBrowse 2 session."
>
  <Container>
    <h1>Protein browser</h1>
    <p>
      Enter a gene and reference organism: this resolves the gene's orthologs
      live and draws each protein's NCBI CDD conserved domains as a
      domain-architecture cartoon — the quick view of whether the orthologs
      share the same domains — while in parallel building a connected JBrowse
      session with the gene on its <strong>genome</strong> (introns collapsed so the
      coding exons sit side by side, under that assembly's gene track) and its <strong
        >AlphaFold 3D structure</strong
      >. Add the cross-species protein <strong>alignment</strong>
      and it rides along in the session as a connected view: hover or select in any
      one and the others light up the matching residue. Human genes can take that
      alignment from the hosted <strong>100-vertebrate</strong> set instantly, or
      build a domain-annotated one across the model organisms at EBI Clustal Omega.
      Nothing is precomputed per gene.
    </p>
    <ProteinBrowser client:only="react" />
  </Container>
</Layout>

<style is:global>
  .msv-form {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 1.25rem 0;
    flex-wrap: wrap;
  }
  .msv-form input,
  .msv-form select {
    padding: 7px 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }
  .msv-form input {
    min-width: 240px;
  }
  /* The gene box and its suggestion list; positioned so the listbox overlays
     what follows instead of pushing the examples row down as you type. */
  .msv-combobox {
    position: relative;
  }
  .msv-listbox {
    position: absolute;
    z-index: 20;
    top: calc(100% + 2px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 4px 0;
    list-style: none;
    max-height: 260px;
    overflow-y: auto;
    background: white;
    border: 1px solid #ccc;
    border-radius: 4px;
    box-shadow: 0 4px 12px rgb(0 0 0 / 12%);
  }
  .msv-option {
    padding: 5px 10px;
    font-size: 14px;
    cursor: pointer;
  }
  .msv-option.highlighted {
    background: var(--accent-wash);
  }
  .msv-icon-btn {
    width: 30px;
    height: 30px;
    font-size: 15px;
    font-weight: 700;
    color: #666;
    background: white;
    border: 1px solid #ccc;
    border-radius: 50%;
    cursor: pointer;
  }
  .msv-icon-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Which of the two alignments to show, offered only where both exist. */
  .msv-source {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 1rem 0 0.5rem;
    font-size: 13px;
  }
  .msv-source-label {
    font-weight: 600;
    color: #444;
  }
  .msv-source-option {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #333;
    cursor: pointer;
  }
  .msv-source-note {
    color: #999;
    font-size: 12px;
  }

  /* An alignment is a wide matrix, and the article measure (60rem) shows a
     sliver of it. Break out to the window width: the content box is centered in
     the viewport, so offsetting by half the difference recentres the wider box
     on the same axis. Capped so an ultrawide monitor does not stretch the tree
     gutter across a metre of desk. */
  .msv-align {
    --msv-align-width: min(96vw, 1800px);
    width: var(--msv-align-width);
    margin: 1rem 0 1rem calc(50% - var(--msv-align-width) / 2);
  }
  @media (max-width: 767px) {
    .msv-align {
      --msv-align-width: 100%;
      margin-left: 0;
    }
  }

  /* Expanded: the whole viewport, since that is the point of expanding. */
  .msv-align-dialog {
    width: 96vw;
    max-width: 96vw;
    height: 94vh;
    max-height: 94vh;
    padding: 0.5rem 0.75rem;
    border: 1px solid #dce0e6;
    border-radius: 6px;
    overflow: hidden;
  }
  .msv-align-dialog::backdrop {
    background: rgb(0 0 0 / 45%);
  }

  .msv-align-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .msv-align-title {
    font-size: 13px;
    font-weight: 600;
    color: #444;
  }

  .msv-options {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.75rem;
  }
  .msv-dialog {
    max-width: 64ch;
    font-size: 14px;
    line-height: 1.5;
  }
  .msv-dialog h3 {
    margin: 1.25rem 0 0.35rem;
    font-size: 1rem;
  }
  .msv-dialog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
  .msv-code {
    margin: 0.5rem 0;
    padding: 0.6rem 0.75rem;
    font-size: 12px;
    background: #f6f7f9;
    border: 1px solid #e3e6ea;
    border-radius: 4px;
    overflow-x: auto;
    white-space: pre;
  }
  .msv-code-scroll {
    max-height: 280px;
    overflow-y: auto;
    font-size: 11px;
  }
  .msv-form button {
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 600;
    color: white;
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    cursor: pointer;
  }
  .msv-form button:disabled {
    background: #f0f0f0;
    color: #999;
    border-color: #ddd;
    cursor: not-allowed;
  }
  .msv-hint {
    color: #666;
    font-size: 14px;
  }
  .msv-error {
    color: #b00020;
    font-size: 14px;
  }
  .msv-examples {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    font-size: 13px;
    color: #666;
  }
  .msv-example-chip {
    padding: 4px 12px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent);
    color: white;
    cursor: pointer;
  }
  .msv-example-chip:hover:not(:disabled) {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }
  .msv-example-chip:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .msv-scope {
    color: #666;
    font-size: 13px;
    margin: 0 0 1rem;
    max-width: 60ch;
  }
  .msv-note {
    color: #8a6d3b;
    font-size: 13px;
    margin: 0.5rem 0;
  }

  /* Domain-architecture cartoon (ProteinDomainCartoon) */
  .pdc {
    margin: 0.75rem 0 1rem;
  }
  .pdc-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pdc-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pdc-name {
    flex: 0 0 140px;
    font-size: 13px;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdc-track {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .pdc-bar {
    position: relative;
    height: 16px;
    background: #eef1f5;
    border: 1px solid #dce0e6;
    border-radius: 3px;
  }
  .pdc-domain {
    position: absolute;
    top: -1px;
    height: 16px;
    border-radius: 3px;
    opacity: 0.9;
  }
  .pdc-len {
    flex: 0 0 auto;
    font-size: 11px;
    color: #999;
    font-variant-numeric: tabular-nums;
  }
  .pdc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 12px;
    font-size: 12px;
    color: #444;
  }
  .pdc-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .pdc-swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }

  .msv-result {
    border: 1px solid #dce0e6;
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-top: 1rem;
    max-width: 640px;
  }
  .msv-result h2 {
    margin: 0 0 0.15rem;
    font-size: 1.25rem;
  }
  .msv-sub {
    font-size: 0.85rem;
    font-weight: 400;
    color: #666;
  }
  .msv-meta {
    margin: 0 0 0.6rem;
    font-size: 13px;
    color: #666;
  }
  .msv-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 0.9rem;
  }
  .msv-chip {
    padding: 2px 10px;
    font-size: 12px;
    color: #33475b;
    background: #eef1f5;
    border: 1px solid #dce0e6;
    border-radius: 999px;
  }
  .msv-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .msv-open {
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 600;
    color: white;
    background: var(--accent);
    border-radius: 4px;
    text-decoration: none;
  }
  .msv-open:hover {
    background: var(--accent-hover);
  }
  .msv-collapse {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: #444;
  }
  .msv-advanced {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 1rem 0 0;
  }
  .msv-advanced-btn {
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    background: white;
    border: 1px solid var(--accent);
    border-radius: 4px;
    cursor: pointer;
  }
  .msv-advanced-btn:hover:not(:disabled) {
    background: var(--accent-wash);
  }
  .msv-advanced-btn:disabled {
    color: #999;
    background: #f0f0f0;
    border-color: #ddd;
    cursor: progress;
  }
  .msv-advanced-note {
    font-size: 12px;
    color: #999;
    max-width: 42ch;
  }
</style>
