---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import ProteinBrowser from '../components/ProteinBrowser.tsx'
import { features } from '../config/features.ts'

if (!features.proteinBrowser) {
  return Astro.redirect('/')
}
---

<Layout
  title="Protein browser"
  description="Enter a gene and open it in JBrowse 2 with its coding exons back to back, an AlphaFold or PDB structure and a cross-species protein alignment in one connected session — hover a residue and its codon lights up in every view."
>
  <Container>
    <h1>Protein browser</h1>
    <p class="ui-lede">
      Enter a gene and open it in JBrowse with its coding exons back to back, an
      AlphaFold or PDB structure and a cross-species alignment beside them.
      Hover a residue and its codon lights up in every view; mark other species
      to superpose their structures.
    </p>
    <ProteinBrowser client:only="react">
      <p
        slot="fallback"
        class="ui-hint"
      >
        Loading the protein browser…
      </p>
    </ProteinBrowser>
  </Container>
</Layout>

<style is:global>
  /* The gene box and its suggestion list; positioned so the listbox overlays
     what follows instead of pushing the examples row down as you type. */
  .msv-combobox {
    position: relative;
  }
  .msv-listbox {
    position: absolute;
    z-index: 20;
    top: calc(100% + 2px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 4px 0;
    list-style: none;
    max-height: 260px;
    overflow-y: auto;
    background: white;
    border: 1px solid #ccc;
    border-radius: 4px;
    box-shadow: 0 4px 12px rgb(0 0 0 / 12%);
  }
  .msv-option {
    padding: 5px 10px;
    font-size: 14px;
    cursor: pointer;
  }
  .msv-option.highlighted {
    background: var(--accent-wash);
  }

  /* Which of the two alignments to show, offered only where both exist. */
  .msv-source {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0.6rem 0;
    font-size: 13px;
  }
  .msv-source-label {
    font-weight: 600;
    color: #444;
  }
  .msv-source-option {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #333;
    cursor: pointer;
  }

  /* An alignment is a wide matrix, and the article measure (60rem) shows a
     sliver of it. Break out to the window width: the content box is centered in
     the viewport, so offsetting by half the difference recentres the wider box
     on the same axis. Capped so an ultrawide monitor does not stretch the tree
     gutter across a metre of desk. */
  .msv-align {
    --msv-align-width: min(96vw, 1800px);
    width: var(--msv-align-width);
    margin: 1rem 0 1rem calc(50% - var(--msv-align-width) / 2);
  }
  @media (max-width: 767px) {
    .msv-align {
      --msv-align-width: 100%;
      margin-left: 0;
    }
  }

  /* Expanded: the whole viewport, since that is the point of expanding. */
  .msv-align-dialog {
    width: 96vw;
    max-width: 96vw;
    height: 94vh;
    max-height: 94vh;
    padding: 0.5rem 0.75rem;
    border: 1px solid #dce0e6;
    border-radius: 6px;
    overflow: hidden;
  }
  .msv-align-dialog::backdrop {
    background: rgb(0 0 0 / 45%);
  }

  .msv-align-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .msv-align-title {
    font-size: 13px;
    font-weight: 600;
    color: #444;
  }

  .msv-dialog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
  .msv-code {
    margin: 0.5rem 0;
    padding: 0.6rem 0.75rem;
    font-size: 12px;
    background: #f6f7f9;
    border: 1px solid #e3e6ea;
    border-radius: 4px;
    overflow-x: auto;
    white-space: pre;
  }
  .msv-code-scroll {
    max-height: 280px;
    overflow-y: auto;
    font-size: 11px;
  }
  .msv-examples {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    font-size: 13px;
    color: #666;
  }

  /* Domain-architecture cartoon (ProteinDomainCartoon) */
  .pdc {
    margin: 0.75rem 0 1rem;
  }
  .pdc-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pdc-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pdc-name {
    flex: 0 0 140px;
    font-size: 13px;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdc-track {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .pdc-bar {
    position: relative;
    height: 16px;
    background: #eef1f5;
    border: 1px solid #dce0e6;
    border-radius: 3px;
  }
  .pdc-domain {
    position: absolute;
    top: -1px;
    height: 16px;
    border: 0;
    padding: 0;
    border-radius: 3px;
    opacity: 0.9;
  }
  .pdc-len {
    flex: 0 0 auto;
    font-size: 11px;
    color: #999;
    font-variant-numeric: tabular-nums;
  }
  .pdc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 12px;
    font-size: 12px;
    color: #444;
  }
  .pdc-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  /* CDD names run from "P53" to a 128-character sentence, so the long ones are
     clipped rather than allowed to wrap the legend into a paragraph. The full
     name and the species count are on the item's title. */
  .pdc-legend-name {
    max-width: 22ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pdc-legend-count {
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .pdc-swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    display: inline-block;
  }

  .msv-result {
    border: 1px solid #dce0e6;
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-top: 1rem;
    max-width: 640px;
  }
  .msv-story {
    margin: 0 0 0.75rem;
    padding: 0.5rem 0.75rem;
    font-size: 13px;
    line-height: 1.45;
    color: #333;
    background: var(--accent-wash);
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
  }

  /* The protein map (ProteinMap): one protein end to end, lanes of InterPro
     domains and PDBe partner interfaces, every block a launch target. */
  .pm-section {
    margin: 1.25rem 0 1rem;
  }
  .pm-title {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .pm-lanes {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pm-lane {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pm-lane-name {
    flex: 0 0 140px;
    font-size: 12px;
    color: #555;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pm-partner {
    color: #333;
  }
  .pm-track {
    position: relative;
    flex: 1 1 auto;
    height: 20px;
    min-width: 0;
    background: #f3f5f8;
    border-radius: 3px;
  }
  .pm-lane-thin .pm-track {
    height: 12px;
  }
  .pm-ruler .pm-track {
    height: 16px;
    background: none;
    border-bottom: 1px solid #c9ced6;
  }
  .pm-tick {
    position: absolute;
    top: 0;
    font-size: 10px;
    color: #888;
    transform: translateX(-50%);
    font-variant-numeric: tabular-nums;
  }
  .pm-tick::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    height: 3px;
    border-left: 1px solid #c9ced6;
  }
  .pm-tick-end {
    right: 0;
    transform: none;
    color: #666;
  }
  .pm-tick-end::after {
    display: none;
  }
  .pm-block {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 2px;
    padding: 0 3px;
    border: 0;
    border-radius: 3px;
    color: white;
    font-size: 11px;
    line-height: 20px;
    text-align: left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0.9;
    cursor: pointer;
  }
  .pm-lane-thin .pm-block {
    line-height: 12px;
    font-size: 0;
  }
  .pm-block:hover,
  .pm-block:focus-visible,
  .pm-interface:hover,
  .pm-interface:focus-visible {
    opacity: 1;
    outline: 2px solid #222;
    outline-offset: 1px;
  }
  .pm-block.selected,
  .pm-interface.selected {
    opacity: 1;
    outline: 2px solid #222;
    outline-offset: 1px;
    box-shadow: 0 0 0 4px rgb(255 255 255 / 90%);
  }
  .pm-block-label {
    pointer-events: none;
  }
  .pm-interface {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 3px;
    cursor: pointer;
  }
  .pm-run {
    position: absolute;
    top: 0;
    height: 100%;
    min-width: 2px;
    background: #d1495b;
    border-radius: 2px;
  }
  .pm-residue {
    position: absolute;
    top: -3px;
    width: 3px;
    height: 18px;
    margin-left: -1px;
    background: #222;
    border-radius: 1px;
  }
  .pm-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0.6rem 0 0 150px;
    font-size: 13px;
  }
  .pm-residue-form {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .pm-residue-input {
    width: 9rem;
  }
  @media (max-width: 767px) {
    .pm-lane-name,
    .pdc-name {
      flex-basis: 80px;
    }
    .pm-actions {
      margin-left: 0;
    }
  }
  .msv-result h2 {
    margin: 0 0 0.15rem;
    font-size: 1.25rem;
  }
  .msv-sub {
    font-size: 0.85rem;
    font-weight: 400;
    color: #666;
  }
  .msv-meta {
    margin: 0 0 0.6rem;
    font-size: 13px;
    color: #666;
  }
  .msv-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .msv-open {
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 600;
    color: white;
    background: var(--accent);
    border-radius: 4px;
    text-decoration: none;
  }
  .msv-open:hover {
    background: var(--accent-hover);
  }
  .msv-open-disabled,
  .msv-open-disabled:hover {
    background: #b8bec7;
    cursor: default;
  }

  /* What the session opens with: isoform, structure, superposed species, the
     domain to land on. Each row is a label and one control, so the card reads as
     a form rather than a paragraph of chips. */
  .msv-controls {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0.6rem 0 0.8rem;
    font-size: 13px;
  }
  .msv-control {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
  }
  .msv-control .ui-select {
    max-width: 100%;
  }
  .msv-control-label {
    flex: 0 0 5.5rem;
    font-weight: 600;
    color: #444;
  }
  .msv-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .pdc-howto {
    margin: 0 0 0.6rem;
  }
  .pdc-row-query .pdc-name {
    font-weight: 600;
  }
  .pdc-superpose-cell {
    flex: 0 0 26px;
    display: inline-flex;
    justify-content: center;
  }
  .pdc-superpose {
    padding: 0 4px;
    font-size: 10px;
    line-height: 16px;
    color: #555;
    background: white;
    border: 1px solid #c9ced6;
    border-radius: 3px;
    cursor: pointer;
  }
  .pdc-superpose:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pdc-superpose.on {
    color: white;
    background: var(--accent);
    border-color: var(--accent);
  }
  .pdc-domain.clickable {
    cursor: pointer;
  }
  .pdc-domain.clickable:hover,
  .pdc-domain.clickable:focus-visible {
    opacity: 1;
    outline: 2px solid #222;
    outline-offset: 1px;
  }
  .pdc-domain.selected {
    opacity: 1;
    outline: 2px solid #222;
    outline-offset: 1px;
    box-shadow: 0 0 0 4px rgb(255 255 255 / 90%);
  }
  .msv-collapse {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: #444;
  }
  .msv-advanced {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 1rem 0 0;
  }
</style>
