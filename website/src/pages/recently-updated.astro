---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import '../styles/common-table.css'
import { format } from 'date-fns'

// Import the recently updated data (generated at build time)
import recentlyUpdated from '../recentlyUpdated.json'

interface HubEntry {
  accession: string
  createdDate: string
  createdTimestamp: number
  scientificName: string
  commonName: string
  source: string
  jbrowseLink: string
  ncbiLink: string
  ucscBrowserLink: string
}

const data = recentlyUpdated as HubEntry[]

// Sort all data by created date
const sortedData = [...data].sort(
  (a, b) => b.createdTimestamp - a.createdTimestamp,
)

// Get unique sources
const sources = [...new Set(sortedData.map(h => h.source))].sort()

// Get top 500 for "All" view
const allRecent = sortedData.slice(0, 500)

// Pre-compute top 500 for each source
const dataBySource: Record<string, HubEntry[]> = {
  '': allRecent, // Empty string = "All"
}
for (const source of sources) {
  dataBySource[source] = sortedData
    .filter(h => h.source === source)
    .slice(0, 500)
}

function formatDate(isoString: string): string {
  return format(new Date(isoString), 'MMM d, yyyy')
}
---

<Layout title="Recently Added Genomes">
  <Container wide>
    <h1>Recently Added Genomes</h1>
    <p>
      This page shows the most recently added UCSC GenArk assemblies. Last scan: {
        formatDate(new Date().toISOString())
      }
    </p>

    <div>
      <div class="filter-row">
        <label for="source-filter">Filter by category:</label>
        <select id="source-filter">
          <option value="">All categories</option>
          {sources.map(source => <option value={source}>{source}</option>)}
        </select>
        <span id="count-display">Showing {allRecent.length} genomes</span>
      </div>
      <table id="genomes-table">
        <thead>
          <tr>
            <th>Accession</th>
            <th>Common Name</th>
            <th>Scientific Name</th>
            <th>Added</th>
            <th>Category</th>
            <th>Links</th>
          </tr>
        </thead>
        <tbody id="table-body">
          {
            allRecent.map(hub => (
              <tr>
                <td>
                  <a href={`/accession/${hub.accession}`}>{hub.accession}</a>
                </td>
                <td>{hub.commonName}</td>
                <td>
                  <em>{hub.scientificName}</em>
                </td>
                <td>{formatDate(hub.createdDate)}</td>
                <td>{hub.source}</td>
                <td>
                  {hub.jbrowseLink && (
                    <a
                      href={hub.jbrowseLink}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      JBrowse
                    </a>
                  )}
                  {hub.jbrowseLink && hub.ucscBrowserLink && ' | '}
                  {hub.ucscBrowserLink && (
                    <a
                      href={hub.ucscBrowserLink}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      UCSC
                    </a>
                  )}
                  {(hub.jbrowseLink || hub.ucscBrowserLink) &&
                    hub.ncbiLink &&
                    ' | '}
                  {hub.ncbiLink && (
                    <a
                      href={hub.ncbiLink}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      NCBI
                    </a>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <script define:vars={{ dataBySource }}>
        window.__DATA_BY_SOURCE__ = dataBySource
      </script>
    </div>
  </Container>
</Layout>

<style>
  .filter-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .filter-row select {
    padding: 6px 12px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  #count-display {
    color: #666;
    font-size: 14px;
  }

  table {
    width: 80%;
    border-collapse: collapse;
    font-size: 14px;
    white-space: nowrap;
  }

  th,
  td {
    padding: 8px 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }

  th {
    background: #f5f5f5;
    font-weight: 600;
  }

  tr:hover {
    background: #f9f9f9;
  }

  a {
    color: #2563eb;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { format } from 'date-fns'

  interface HubEntry {
    accession: string
    createdDate: string
    createdTimestamp: number
    scientificName: string
    commonName: string
    source: string
    jbrowseLink: string
    ncbiLink: string
    ucscBrowserLink: string
  }

  function formatDate(isoString: string): string {
    return format(new Date(isoString), 'MMM d, yyyy')
  }

  function makeLink(href: string, text: string): HTMLAnchorElement {
    const a = document.createElement('a')
    a.href = href
    a.textContent = text
    a.target = '_blank'
    a.rel = 'noopener noreferrer'
    return a
  }

  function buildLinksCell(hub: HubEntry): HTMLTableCellElement {
    const td = document.createElement('td')
    const entries: [string, string][] = []
    if (hub.jbrowseLink) {
      entries.push([hub.jbrowseLink, 'JBrowse'])
    }
    if (hub.ucscBrowserLink) {
      entries.push([hub.ucscBrowserLink, 'UCSC'])
    }
    if (hub.ncbiLink) {
      entries.push([hub.ncbiLink, 'NCBI'])
    }
    for (let i = 0; i < entries.length; i++) {
      if (i > 0) {
        td.append(' | ')
      }
      td.append(makeLink(entries[i][0], entries[i][1]))
    }
    return td
  }

  function renderTable(data: HubEntry[]) {
    const tbody = document.getElementById('table-body')
    if (!tbody) return

    const fragment = document.createDocumentFragment()
    for (const hub of data) {
      const tr = document.createElement('tr')

      const accessionTd = document.createElement('td')
      const accessionLink = document.createElement('a')
      accessionLink.href = `/accession/${hub.accession}`
      accessionLink.textContent = hub.accession
      accessionTd.append(accessionLink)

      const commonNameTd = document.createElement('td')
      commonNameTd.textContent = hub.commonName

      const sciNameTd = document.createElement('td')
      const em = document.createElement('em')
      em.textContent = hub.scientificName
      sciNameTd.append(em)

      const dateTd = document.createElement('td')
      dateTd.textContent = formatDate(hub.createdDate)

      const sourceTd = document.createElement('td')
      sourceTd.textContent = hub.source

      tr.append(
        accessionTd,
        commonNameTd,
        sciNameTd,
        dateTd,
        sourceTd,
        buildLinksCell(hub),
      )
      fragment.append(tr)
    }

    tbody.replaceChildren(fragment)
  }

  function updateURL(category: string) {
    const params = new URLSearchParams(window.location.search)
    if (category) {
      params.set('category', category)
    } else {
      params.delete('category')
    }
    const newUrl =
      params.toString() !== ''
        ? `${window.location.pathname}?${params.toString()}`
        : window.location.pathname
    window.history.replaceState({}, '', newUrl)
  }

  function applyFilter(category: string) {
    const data = dataBySource[category] || []
    renderTable(data)
    if (countDisplay) {
      countDisplay.textContent = `Showing ${data.length} genomes`
    }
  }

  const select = document.getElementById('source-filter') as HTMLSelectElement
  const countDisplay = document.getElementById('count-display')
  const dataBySource = (
    window as unknown as { __DATA_BY_SOURCE__: Record<string, HubEntry[]> }
  ).__DATA_BY_SOURCE__

  // Initialize from URL on page load
  const params = new URLSearchParams(window.location.search)
  const initialCategory = params.get('category') || ''
  if (initialCategory && select) {
    // Check if the category exists in the data
    if (dataBySource[initialCategory]) {
      select.value = initialCategory
      applyFilter(initialCategory)
    }
  }

  select?.addEventListener('change', () => {
    const selectedSource = select.value
    applyFilter(selectedSource)
    updateURL(selectedSource)
  })
</script>
