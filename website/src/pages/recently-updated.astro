---
import Layout from '../layouts/Layout.astro'
import Container2 from '../components/Container2.astro'
import '../styles/common-table.css'
import { format } from 'date-fns'

// Import the recently updated data
import recentlyUpdated from '../recentlyUpdated.json'

interface HubEntry {
  accession: string
  createdDate: string
  createdTimestamp: number
  scientificName: string
  commonName: string
  source: string
  jbrowseLink: string
  ncbiLink: string
  ucscBrowserLink: string
}

const data = recentlyUpdated as HubEntry[]

// Sort all data by created date
const sortedData = [...data].sort(
  (a, b) => b.createdTimestamp - a.createdTimestamp,
)

// Get unique sources
const sources = [...new Set(sortedData.map(h => h.source))].sort()

// Get top 500 for "All" view
const allRecent = sortedData.slice(0, 500)

// Pre-compute top 500 for each source
const dataBySource: Record<string, HubEntry[]> = {
  '': allRecent, // Empty string = "All"
}
for (const source of sources) {
  dataBySource[source] = sortedData
    .filter(h => h.source === source)
    .slice(0, 500)
}

function formatDate(isoString: string): string {
  return format(new Date(isoString), 'MMM d, yyyy')
}
---

<Layout title="Recently Added Genomes">
  <Container2>
    <h1>Recently Added Genomes</h1>
    <p>
      This page shows the most recently added UCSC GenArk assemblies. Last scan: {
        formatDate(new Date().toISOString())
      }
    </p>

    <div>
      <div class="filter-row">
        <label for="source-filter">Filter by category:</label>
        <select id="source-filter">
          <option value="">All categories</option>
          {sources.map(source => <option value={source}>{source}</option>)}
        </select>
        <span id="count-display">Showing {allRecent.length} genomes</span>
      </div>
      <table id="genomes-table">
        <thead>
          <tr>
            <th>Accession</th>
            <th>Common Name</th>
            <th>Scientific Name</th>
            <th>Added</th>
            <th>Category</th>
            <th>Links</th>
          </tr>
        </thead>
        <tbody id="table-body">
          {
            allRecent.map(hub => (
              <tr>
                <td>
                  <a href={`/accession/${hub.accession}`}>{hub.accession}</a>
                </td>
                <td>{hub.commonName}</td>
                <td>
                  <em>{hub.scientificName}</em>
                </td>
                <td>{formatDate(hub.createdDate)}</td>
                <td>{hub.source}</td>
                <td>
                  {hub.jbrowseLink && (
                    <a href={hub.jbrowseLink} target="_blank" rel="noopener">
                      JBrowse
                    </a>
                  )}
                  {hub.jbrowseLink && hub.ucscBrowserLink && ' | '}
                  {hub.ucscBrowserLink && (
                    <a
                      href={hub.ucscBrowserLink}
                      target="_blank"
                      rel="noopener"
                    >
                      UCSC
                    </a>
                  )}
                  {(hub.jbrowseLink || hub.ucscBrowserLink) &&
                    hub.ncbiLink &&
                    ' | '}
                  {hub.ncbiLink && (
                    <a href={hub.ncbiLink} target="_blank" rel="noopener">
                      NCBI
                    </a>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <script define:vars={{ dataBySource }}>
        window.__DATA_BY_SOURCE__ = dataBySource
      </script>
    </div>
  </Container2>
</Layout>

<style>
  .filter-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .filter-row select {
    padding: 6px 12px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  #count-display {
    color: #666;
    font-size: 14px;
  }

  table {
    width: 80%;
    border-collapse: collapse;
    font-size: 14px;
    white-space: nowrap;
  }

  th,
  td {
    padding: 8px 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }

  th {
    background: #f5f5f5;
    font-weight: 600;
  }

  tr:hover {
    background: #f9f9f9;
  }

  a {
    color: #2563eb;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { format } from 'date-fns'

  function formatDate(isoString: string): string {
    return format(new Date(isoString), 'MMM d, yyyy')
  }

  function buildLinks(hub: any): string {
    const links: string[] = []
    if (hub.jbrowseLink) {
      links.push(
        `<a href="${hub.jbrowseLink}" target="_blank" rel="noopener">JBrowse</a>`,
      )
    }
    if (hub.ucscBrowserLink) {
      links.push(
        `<a href="${hub.ucscBrowserLink}" target="_blank" rel="noopener">UCSC</a>`,
      )
    }
    if (hub.ncbiLink) {
      links.push(
        `<a href="${hub.ncbiLink}" target="_blank" rel="noopener">NCBI</a>`,
      )
    }
    return links.join(' | ')
  }

  function renderTable(data: any[]) {
    const tbody = document.getElementById('table-body')
    if (!tbody) return

    tbody.innerHTML = data
      .map(
        hub => `
      <tr>
        <td><a href="/accession/${hub.accession}">${hub.accession}</a></td>
        <td>${hub.commonName}</td>
        <td><em>${hub.scientificName}</em></td>
        <td>${formatDate(hub.createdDate)}</td>
        <td>${hub.source}</td>
        <td>${buildLinks(hub)}</td>
      </tr>
    `,
      )
      .join('')
  }

  const select = document.getElementById('source-filter') as HTMLSelectElement
  const countDisplay = document.getElementById('count-display')
  const dataBySource = (window as any).__DATA_BY_SOURCE__

  select?.addEventListener('change', () => {
    const selectedSource = select.value
    const data = dataBySource[selectedSource] || []
    renderTable(data)
    if (countDisplay) {
      countDisplay.textContent = `Showing ${data.length} genomes`
    }
  })
</script>
