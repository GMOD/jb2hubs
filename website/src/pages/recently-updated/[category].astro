---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import RecentlyUpdatedTable from '../../components/RecentlyUpdatedTable.astro'
import { categories } from '../../lib/recentlyUpdatedData.ts'

export function getStaticPaths() {
  return categories.map(category => ({ params: { category } }))
}

const { category } = Astro.params
---

<Layout
  title={`Recently Added Genomes - ${category}`}
  description={`The most recently added UCSC GenArk ${category} assemblies, newest first, with links into JBrowse 2, UCSC and NCBI.`}
>
  <Container wide>
    <RecentlyUpdatedTable category={category} />
  </Container>
</Layout>
