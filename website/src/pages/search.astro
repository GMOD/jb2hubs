---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import SearchPage from '../components/SearchPage.tsx'
import UcscStatusBanner from '../components/UcscStatusBanner.astro'
import '../styles/common-table.css'
---

<Layout
  title="Assembly search"
  description="Search over 50,000 genome assemblies by common name, scientific name or accession, filter by clade, and open any of them in JBrowse 2."
>
  <Container wide>
    <UcscStatusBanner />
    <h1>Assembly search</h1>
    {/* client:load, not client:only: the controls render on the server so the
        page has a search box before the bundle arrives, instead of a blank
        document. Everything below them is empty until a query is typed anyway. */}
    <SearchPage client:load />
  </Container>
</Layout>
