---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import syntenyTracks from '../syntenyTracks.json'
import list from '../list.json'
import '../styles/common-table.css'

// Build a mapping of assembly names to their display information
const assemblyInfo = new Map()
for (const [key, val] of Object.entries(list.ucscGenomes)) {
  assemblyInfo.set(key, {
    commonName: val.commonName || val.organism || key,
    scientificName: val.scientificName || '',
    organism: val.organism || key,
  })
}

// Get all unique assemblies
const allAssemblies = new Set()
for (const track of syntenyTracks) {
  for (const assembly of track.assemblyNames) {
    allAssemblies.add(assembly)
  }
}

// Build a map of which assemblies can be compared with which other assemblies
const assemblyPairs = new Map()
for (const track of syntenyTracks) {
  if (track.assemblyNames.length === 2) {
    const [first, second] = track.assemblyNames

    if (!assemblyPairs.has(first)) {
      assemblyPairs.set(first, new Set())
    }
    assemblyPairs.get(first).add(second)

    if (!assemblyPairs.has(second)) {
      assemblyPairs.set(second, new Set())
    }
    assemblyPairs.get(second).add(first)
  }
}

// Create sorted list of assemblies with their display names
const sortedAssemblies = Array.from(allAssemblies)
  .map(assembly => ({
    id: assembly,
    displayName: assemblyInfo.get(assembly)?.commonName || assembly,
    scientificName: assemblyInfo.get(assembly)?.scientificName || '',
  }))
  .sort((a, b) => a.displayName.localeCompare(b.displayName))
---

<Layout title="Synteny Browser">
  <Container>
    <h1>Synteny Comparison Browser</h1>
    <p>
      Compare synteny (conserved genomic regions) between two species using
      JBrowse 2.
    </p>

    <div class="synteny-selector">
      <div class="species-selection">
        <div class="species-group">
          <label for="species1">First Species:</label>
          <select id="species1" name="species1">
            <option value="">-- Select a species --</option>
            {
              sortedAssemblies.map(asm => (
                <option value={asm.id}>
                  {asm.displayName}
                  {asm.scientificName && ` (${asm.scientificName})`} [{asm.id}]
                </option>
              ))
            }
          </select>
        </div>

        <div class="species-group">
          <label for="species2">Second Species:</label>
          <select id="species2" name="species2" disabled>
            <option value="">-- Select first species first --</option>
          </select>
        </div>
      </div>

      <div class="button-group">
        <button id="launchButton" disabled>Launch Synteny View</button>
        <div id="status"></div>
      </div>

      <div id="trackInfo" class="track-info"></div>
    </div>

    <div class="info-section">
      <h2>About Synteny Tracks</h2>
      <p>
        Synteny tracks show regions of conserved gene order between different
        species. These comparisons are based on UCSC liftOver chain files that
        map genomic coordinates from one species to another.
      </p>
      <p>
        We have <strong>{syntenyTracks.length}</strong> synteny comparisons available
        across <strong>{allAssemblies.size}</strong> different species assemblies.
      </p>
    </div>
  </Container>
</Layout>

<style>
  .synteny-selector {
    margin: 2rem 0;
    padding: 1.5rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #f9f9f9;
  }

  .species-selection {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .species-group {
    display: flex;
    flex-direction: column;
  }

  .species-group label {
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .species-group select {
    padding: 0.5rem;
    font-size: 1rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: white;
  }

  .species-group select:disabled {
    background: #e9e9e9;
    cursor: not-allowed;
  }

  .button-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  button {
    padding: 0.75rem 2rem;
    font-size: 1.1rem;
    font-weight: bold;
    color: white;
    background: #0066cc;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s;
  }

  button:hover:not(:disabled) {
    background: #0052a3;
  }

  button:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  #status {
    font-size: 0.9rem;
    color: #666;
  }

  .track-info {
    margin-top: 1rem;
    padding: 1rem;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.9rem;
  }

  .track-info:empty {
    display: none;
  }

  .info-section {
    margin-top: 2rem;
    padding: 1.5rem;
    background: #f0f8ff;
    border-left: 4px solid #0066cc;
  }

  @media (max-width: 768px) {
    .species-selection {
      grid-template-columns: 1fr;
    }
  }
</style>

<script
  define:vars={{
    syntenyTracks,
    assemblyPairs: Object.fromEntries(assemblyPairs),
    assemblyInfo: Object.fromEntries(assemblyInfo),
  }}
>
  const species1Select = document.getElementById('species1')
  const species2Select = document.getElementById('species2')
  const launchButton = document.getElementById('launchButton')
  const statusDiv = document.getElementById('status')
  const trackInfoDiv = document.getElementById('trackInfo')

  let selectedSpecies1 = ''
  let selectedSpecies2 = ''

  // Convert assemblyPairs Sets to Arrays for JSON serialization
  const pairs = {}
  for (const [key, value] of Object.entries(assemblyPairs)) {
    pairs[key] = Array.isArray(value) ? value : Array.from(value)
  }

  species1Select.addEventListener('change', e => {
    selectedSpecies1 = e.target.value
    selectedSpecies2 = ''

    if (selectedSpecies1) {
      // Enable and populate species2 select
      species2Select.disabled = false
      species2Select.innerHTML =
        '<option value="">-- Select a species --</option>'

      const availableSpecies = pairs[selectedSpecies1] || []
      const sortedOptions = availableSpecies
        .map(assemblyId => ({
          id: assemblyId,
          displayName: assemblyInfo[assemblyId]?.commonName || assemblyId,
          scientificName: assemblyInfo[assemblyId]?.scientificName || '',
        }))
        .sort((a, b) => a.displayName.localeCompare(b.displayName))

      for (const asm of sortedOptions) {
        const option = document.createElement('option')
        option.value = asm.id
        option.textContent = `${asm.displayName}${asm.scientificName ? ` (${asm.scientificName})` : ''} [${asm.id}]`
        species2Select.appendChild(option)
      }

      statusDiv.textContent = `${availableSpecies.length} species available for comparison`
    } else {
      species2Select.disabled = true
      species2Select.innerHTML =
        '<option value="">-- Select first species first --</option>'
      statusDiv.textContent = ''
      trackInfoDiv.innerHTML = ''
    }

    launchButton.disabled = true
  })

  species2Select.addEventListener('change', e => {
    selectedSpecies2 = e.target.value

    if (selectedSpecies1 && selectedSpecies2) {
      launchButton.disabled = false

      // Find and display track information
      const matchingTracks = syntenyTracks.filter(
        track =>
          track.assemblyNames.includes(selectedSpecies1) &&
          track.assemblyNames.includes(selectedSpecies2),
      )

      if (matchingTracks.length > 0) {
        trackInfoDiv.innerHTML = `
          <strong>Found ${matchingTracks.length} synteny track(s):</strong><br>
          ${matchingTracks.map(track => `• ${track.name}`).join('<br>')}
        `
      }
    } else {
      launchButton.disabled = true
      trackInfoDiv.innerHTML = ''
    }
  })

  launchButton.addEventListener('click', () => {
    if (selectedSpecies1 && selectedSpecies2) {
      const matchingTracks = syntenyTracks.filter(
        track =>
          track.assemblyNames.includes(selectedSpecies1) &&
          track.assemblyNames.includes(selectedSpecies2),
      )

      if (matchingTracks.length === 0) {
        statusDiv.textContent = 'No synteny tracks found for this pair'
        return
      }

      const track = matchingTracks[0]
      const trackId = track.trackId

      const mergeApiUrl = `https://0hifvzakej.execute-api.us-east-1.amazonaws.com/merge/?hubIds=${selectedSpecies1},${selectedSpecies2}`

      const sessionSpec = {
        views: [
          {
            type: 'LinearSyntenyView',
            tracks: [trackId],
            views: [
              { assembly: selectedSpecies1 },
              { assembly: selectedSpecies2 },
            ],
          },
        ],
      }

      const jbrowseUrl = `https://jbrowse.org/code/jb2/latest/?config=${encodeURIComponent(mergeApiUrl)}&session=spec-${encodeURIComponent(JSON.stringify(sessionSpec))}`

      statusDiv.textContent = 'Launching JBrowse Linear Synteny View...'
      window.open(jbrowseUrl, '_blank')
    }
  })
</script>
