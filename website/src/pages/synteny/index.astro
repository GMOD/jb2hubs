---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import SyntenySelector from '../../components/SyntenySelector.tsx'
import { features } from '../../config/features.ts'

if (!features.synteny) {
  return Astro.redirect('/')
}
---

<Layout
  title="Synteny browser"
  description="Pick two assemblies and open a JBrowse 2 synteny view of the alignment between them, optionally centered on an orthologous gene."
>
  <Container>
    <h1>Synteny browser</h1>
    <p>
      Pick two assemblies to open a JBrowse 2 linear synteny view of the
      conserved regions between them.
    </p>

    <SyntenySelector client:load />

    <p>
      <a href="/synteny/info">About synteny tracks &rarr;</a>
    </p>
  </Container>
</Layout>

<style is:global>
  .synteny-selector {
    margin: 1.5rem 0;
  }

  .synteny-pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.75rem;
    align-items: end;
  }

  .synteny-field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .synteny-field label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .synteny-swap {
    align-self: end;
    height: 34px;
    width: 34px;
    padding: 0;
    font-size: 1rem;
    line-height: 1;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--field-border);
    border-radius: 4px;
    cursor: pointer;
  }

  .synteny-swap:hover:not(:disabled) {
    border-color: var(--faint);
    color: var(--text);
  }

  .synteny-swap:disabled {
    color: var(--field-border);
    cursor: default;
  }

  .synteny-hint {
    min-height: 1.25rem;
    margin: 0.75rem 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .synteny-examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }

  .synteny-gene {
    margin: 0.5rem 0 1rem;
  }

  .synteny-gene-note {
    min-height: 1.25rem;
    margin-top: 4px;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .synteny-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .synteny-options {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
  }

  .synteny-options > summary {
    cursor: pointer;
    color: var(--muted);
    width: fit-content;
  }

  .synteny-options-body {
    margin-top: 0.75rem;
    padding-left: 1rem;
    border-left: 2px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .synteny-option {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .synteny-option > label:first-child,
  .synteny-option > span:first-child {
    font-weight: 600;
    color: var(--muted);
  }

  .synteny-option select {
    flex: 1;
    min-width: 0;
    max-width: 100%;
    padding: 5px 8px;
    font-size: var(--text-sm);
    border: 1px solid var(--field-border);
    border-radius: 3px;
    background: var(--surface);
  }

  .synteny-option-help {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  .synteny-source {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .synteny-pair {
      grid-template-columns: 1fr;
    }

    .synteny-swap {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
</style>
