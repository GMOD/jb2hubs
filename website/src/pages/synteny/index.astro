---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import SyntenySelector from '../../components/SyntenySelector.tsx'
import { features } from '../../config/features.ts'

if (!features.synteny) {
  return Astro.redirect('/')
}
---

<Layout
  title="Synteny browser"
  description="Pick two assemblies and open a JBrowse 2 synteny view of the alignment between them, optionally centered on an orthologous gene."
>
  <Container>
    <h1>Synteny browser</h1>
    <p>View the whole-genome alignment between two assemblies.</p>

    <SyntenySelector client:load />
  </Container>
</Layout>

<style is:global>
  .synteny-selector {
    margin: 1.5rem 0;
  }

  .synteny-pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.75rem;
    align-items: end;
  }

  .synteny-field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .synteny-field label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .synteny-swap {
    align-self: end;
    height: 34px;
    width: 34px;
    padding: 0;
    font-size: 1rem;
    line-height: 1;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--field-border);
    border-radius: 4px;
    cursor: pointer;
  }

  .synteny-swap:hover {
    border-color: var(--faint);
    color: var(--text);
  }

  .synteny-swap-slot {
    width: 34px;
  }

  .synteny-hint {
    margin: 0.75rem 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .synteny-examples {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    margin: 0 0 1rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .synteny-gene {
    margin: 1rem 0;
  }

  .synteny-gene-note {
    min-height: 1.25rem;
    margin-top: 4px;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .synteny-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .synteny-pair {
      grid-template-columns: 1fr;
    }

    .synteny-swap {
      justify-self: center;
      transform: rotate(90deg);
    }

    .synteny-swap-slot {
      display: none;
    }
  }
</style>
