---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import SyntenySelector from '../../components/SyntenySelector.tsx'
import syntenyData from '../../syntenyTracks.json'
import orthologManifest from '../../orthologManifest.json'
import '../../styles/common-table.css'
---

<Layout title="Synteny Browser">
  <Container>
    <h1>Synteny Comparison Browser</h1>
    <p>
      Pick two assemblies to open a JBrowse 2 linear synteny view of the
      conserved regions between them.
    </p>

    <SyntenySelector
      client:load
      data={syntenyData}
      orthologPairs={orthologManifest.pairs}
    />

    <p><a href="/synteny/info">About synteny tracks &rarr;</a></p>
  </Container>
</Layout>

<style is:global>
  .synteny-selector {
    margin: 1.5rem 0;
  }

  .synteny-pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.75rem;
    align-items: end;
  }

  .synteny-field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .synteny-field label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #666;
    margin-bottom: 4px;
  }

  .synteny-swap {
    align-self: end;
    height: 34px;
    width: 34px;
    padding: 0;
    font-size: 16px;
    line-height: 1;
    color: #555;
    background: white;
    border: 1px solid #ccc;
    border-radius: 4px;
    cursor: pointer;
  }

  .synteny-swap:hover:not(:disabled) {
    border-color: #888;
    color: #222;
  }

  .synteny-swap:disabled {
    color: #ccc;
    cursor: default;
  }

  .synteny-hint {
    min-height: 1.25rem;
    margin: 0.75rem 0;
    font-size: 13px;
    color: #666;
  }

  .synteny-gene {
    margin: 0.5rem 0 1rem;
  }

  .synteny-actions {
    margin-top: 0.25rem;
  }

  .synteny-launch {
    display: inline-block;
    padding: 9px 18px;
    font-size: 14px;
    font-weight: 600;
    color: white;
    background: #0b69d4;
    border: 1px solid #0b69d4;
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
  }

  .synteny-launch:hover:not(:disabled) {
    background: #0a5cba;
  }

  .synteny-launch:disabled {
    color: #999;
    background: #f0f0f0;
    border-color: #ddd;
    cursor: not-allowed;
  }

  .synteny-options {
    margin-top: 1.25rem;
    font-size: 13px;
  }

  .synteny-options > summary {
    cursor: pointer;
    color: #666;
    width: fit-content;
  }

  .synteny-options-body {
    margin-top: 0.75rem;
    padding-left: 1rem;
    border-left: 2px solid #eee;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .synteny-option {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .synteny-option > label:first-child,
  .synteny-option > span:first-child {
    font-weight: 600;
    color: #444;
  }

  .synteny-option select {
    flex: 1;
    min-width: 0;
    max-width: 100%;
    padding: 5px 8px;
    font-size: 13px;
    border: 1px solid #ccc;
    border-radius: 3px;
    background: white;
  }

  .synteny-source {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
  }

  .autocomplete {
    position: relative;
  }

  .autocomplete-input-wrapper {
    display: flex;
    align-items: center;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: white;
  }

  .autocomplete-input-wrapper:focus-within {
    border-color: #0b69d4;
  }

  .autocomplete-input-wrapper.disabled {
    background: #f5f5f5;
  }

  .autocomplete-input {
    flex: 1;
    min-width: 0;
    padding: 7px 8px;
    font-size: 14px;
    border: none;
    background: transparent;
    outline: none;
  }

  .autocomplete-input:disabled {
    color: #999;
  }

  .autocomplete-clear {
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0 8px;
    cursor: pointer;
    color: #999;
    display: flex;
    align-items: center;
    align-self: stretch;
  }

  .autocomplete-clear:hover {
    color: #666;
  }

  .autocomplete-list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: 280px;
    overflow-y: auto;
    background: white;
    border: 1px solid #ccc;
    border-top: none;
    list-style: none;
    margin: 0;
    padding: 0;
    z-index: 100;
  }

  .autocomplete-option {
    padding: 6px 8px;
    cursor: pointer;
    font-size: 13px;
  }

  .autocomplete-option.highlighted {
    background: #eaf3fd;
  }

  .autocomplete-option.selected {
    font-weight: 600;
  }

  .autocomplete-no-results {
    padding: 6px 8px;
    color: #999;
    font-size: 13px;
  }

  @media (max-width: 768px) {
    .synteny-pair {
      grid-template-columns: 1fr;
    }

    .synteny-swap {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
</style>
