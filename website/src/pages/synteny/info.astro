---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import syntenyData from '../../syntenyTracks.json'
import { features } from '../../config/features.ts'
import { ALL_SOURCES, createStaticCatalog } from '../../lib/syntenyCatalog.ts'

// Staging-only alongside the synteny browser; see synteny/index.astro.
if (!features.synteny) {
  return Astro.redirect('/')
}

// The same queries the selector runs, so the numbers here are what the
// selector offers: launchable tracks only, one comparison per assembly pair
// whichever liftOver direction or chain variant it comes in.
const catalog = createStaticCatalog(syntenyData)
const assemblyCount = catalog.listAssemblies(ALL_SOURCES).length
const comparisonCount = catalog.countComparisons(ALL_SOURCES)
---

<Layout
  title="About Synteny Tracks"
  description="Where the synteny and liftover tracks on this site come from, how UCSC chain files are converted, and what the alignments do and do not mean."
>
  <Container>
    <h1>About Synteny Tracks</h1>
    <p>
      Synteny tracks show regions of conserved gene order between different
      species. These comparisons are based on UCSC liftOver chain files that map
      genomic coordinates from one species to another.
    </p>
    <p>
      Please note that UCSC liftOver chain files are for non-commercial use
      only, following the UCSC licensing.
    </p>
    <p>
      We have <strong>{comparisonCount}</strong> synteny comparisons available across
      <strong>{assemblyCount}</strong> assemblies.
    </p>
    <p>
      <a href="/synteny">&larr; Back to Synteny Browser</a>
    </p>
  </Container>
</Layout>
