---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import TaxonomyTree from '../../components/TaxonomyTree.astro'
import TaxonomyViewToggle from '../../components/TaxonomyViewToggle.tsx'
import UcscStatusBanner from '../../components/UcscStatusBanner.tsx'
import {
  TREE_NODE_BUDGET,
  budgetTree,
  getCachedTree,
  getTaxonomyIndex,
  collectAccessions,
  taxonIdsIn,
} from '../../utils/taxonomyCache'
import type { TaxonomyNode } from '../../utils/taxonomyCache'
import {
  categoryTable,
  subtreeTable,
  taxonAccessionsUrl,
} from '../../components/DataTable/hubRow.ts'
import type {
  HubSource,
  HubTableData,
} from '../../components/DataTable/hubRow.ts'
import { notEmpty } from '../../components/DataTable/utils.ts'
import { ncbiTaxonomyUrl } from '../../lib/externalLinks.ts'
import fs from 'fs'
import path from 'path'

interface Props {
  table: HubTableData
  rowCount: number
  speciesData: HubSource[]
  isCategory: boolean
  taxonId?: string
  // Already cut to the render budget: the whole subtree is what the accession
  // list and table were built from, and is not what the tree draws.
  precomputedSubtree: TaxonomyNode | null
  precomputedLineage?: TaxonomyNode[]
}

export async function getStaticPaths() {
  // One page per GenArk category, from the processed listing it is named after.
  // all.json is the union of the others, and has its own handling below.
  const modules = import.meta.glob('../../../processedHubJson/*.json')
  const categories = await Promise.all(
    Object.entries(modules).map(async ([filepath, resolver]) => {
      const { default: data } = (await resolver()) as { default: HubSource[] }
      return { slug: filepath.split('/').pop()!.replace('.json', ''), data }
    }),
  )

  const paths: { params: { slug: string }; props: Props }[] = []
  for (const { slug, data } of categories) {
    if (slug !== 'all') {
      const tree = getCachedTree(slug)
      paths.push({
        params: { slug },
        props: {
          table: categoryTable(slug, data),
          rowCount: data.length,
          speciesData: data,
          isCategory: true,
          precomputedSubtree: tree && budgetTree(tree, TREE_NODE_BUDGET),
        },
      })
    }
  }
  // A category page wins a slug collision, so the taxon pass below skips these.
  const categorySlugs = new Set(paths.map(p => p.params.slug))

  try {
    const newick = fs.readFileSync(
      path.join(process.cwd(), 'public', 'taxonomy', 'all.newick'),
      'utf-8',
    )
    const { default: allHubs } =
      (await import('../../../processedHubJson/all.json')) as {
        default: HubSource[]
      }

    // Parsed and indexed once here rather than per page: a from-the-root search
    // for each of the 74K taxa cost ~6ms apiece, ~7 minutes of every build.
    const taxonomy = getTaxonomyIndex('all')
    const hubsByAccession = new Map(allHubs.map(hub => [hub.accession, hub]))
    // generateHubData.ts writes a list file for every subtree too large to
    // inline; the page names it only when it is really there to fetch.
    const hasListFile = (taxonId: string) =>
      fs.existsSync(
        path.join(process.cwd(), 'public', taxonAccessionsUrl(taxonId)),
      )

    for (const taxonId of taxonIdsIn(newick)) {
      if (categorySlugs.has(taxonId)) {
        console.warn(`Skipping taxonId ${taxonId} - conflicts with a category`)
        continue
      }
      const subtree = taxonomy?.subtree(taxonId) ?? null
      const speciesData = collectAccessions(subtree)
        .map(accession => hubsByAccession.get(accession))
        .filter(notEmpty)

      paths.push({
        params: { slug: taxonId },
        props: {
          table: subtreeTable(
            speciesData,
            hasListFile(taxonId) ? taxonAccessionsUrl(taxonId) : undefined,
          ),
          rowCount: speciesData.length,
          speciesData,
          isCategory: false,
          taxonId,
          precomputedSubtree: subtree && budgetTree(subtree, TREE_NODE_BUDGET),
          precomputedLineage: taxonomy?.lineage(taxonId) ?? [],
        },
      })
    }
  } catch (err) {
    console.error('Failed to read taxonomy file for generating paths:', err)
  }

  return paths
}

const { slug } = Astro.params
const {
  table,
  rowCount,
  speciesData,
  isCategory,
  taxonId,
  precomputedSubtree,
  precomputedLineage,
} = Astro.props

let title: string
let description: string
const category = isCategory ? slug : 'all'

if (isCategory) {
  title = slug.charAt(0).toUpperCase() + slug.slice(1)
  description = `Browse ${title} genome assemblies from the GenArk collection`
} else {
  // For taxonomy pages, use precomputed subtree data
  title = precomputedSubtree?.name || `Taxonomy ID: ${taxonId}`
  description = `Browse genome assemblies for ${title} (NCBI Taxonomy ID: ${taxonId})`
}
---

<Layout
  title={`Taxonomy - ${title}`}
  description={description}
>
  <Container wide>
    <UcscStatusBanner client:idle />
    {
      isCategory && (
        <div class="page-header">
          <h1 class="page-title">GenArk taxonomy - {title}</h1>
          <a
            href={`/hubs/${slug}`}
            class="hubs-link"
          >
            View list of species as table for {title}
          </a>
        </div>
      )
    }

    {
      precomputedLineage && precomputedLineage.length > 0 && (
        <div class="lineage-container">
          <div class="lineage-label">Taxonomy:</div>
          <div class="lineage-breadcrumbs">
            {precomputedLineage.slice(0, -1).map(node => (
              <>
                <a
                  href={`/taxonomy/${node.taxonId}`}
                  class="lineage-link"
                >
                  {node.name || 'Unnamed'}
                </a>
                <span class="lineage-separator">›</span>
              </>
            ))}
            <span class="lineage-current">
              {precomputedLineage[precomputedLineage.length - 1]?.name ||
                'Unnamed'}
            </span>
          </div>
        </div>
      )
    }

    {
      taxonId && (
        <div class="taxonomy-info-container">
          <div class="taxonomy-info-label">Taxonomy information:</div>
          <a
            href={ncbiTaxonomyUrl(taxonId)}
            target="_blank"
            rel="noopener noreferrer"
            class="taxonomy-info-link"
          >
            View on NCBI (taxonomy ID: {taxonId})
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              style="display: inline-block; vertical-align: middle; margin-left: 4px;"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line
                x1="10"
                y1="14"
                x2="21"
                y2="3"
              />
            </svg>
          </a>
        </div>
      )
    }

    <TaxonomyViewToggle
      table={table}
      treeContainerId="taxonomy-tree-container"
      accessionCount={rowCount}
      client:load
    />
    <TaxonomyTree
      category={category}
      speciesData={speciesData}
      filterTaxonId={isCategory ? undefined : taxonId}
      precomputedSubtree={precomputedSubtree}
      containerId="taxonomy-tree-container"
    />
    {
      /* The toggle island reads ?view= after it hydrates, so a ?view=table link
        would paint the whole tree and then hide it. This runs while the parser
        is still on this element, before the tree has been painted once. */
    }
    <script is:inline>
      if (new URLSearchParams(location.search).get('view') === 'table') {
        var tree = document.getElementById('taxonomy-tree-container')
        if (tree) {
          tree.style.display = 'none'
        }
      }
    </script>
  </Container>
</Layout>

<style>
  .lineage-container {
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .lineage-label {
    font-weight: 600;
    color: #374151;
    font-size: 14px;
  }

  .lineage-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .lineage-link {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  .lineage-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .lineage-separator {
    color: #9ca3af;
    user-select: none;
  }

  .lineage-current {
    color: #1f2937;
    font-weight: 600;
  }

  .taxonomy-info-container {
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .taxonomy-info-label {
    font-weight: 600;
    color: #1e40af;
    font-size: 14px;
  }

  .taxonomy-info-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .taxonomy-info-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .page-header {
    margin-bottom: 16px;
    display: flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .page-title {
    margin: 0;
  }

  .hubs-link {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
