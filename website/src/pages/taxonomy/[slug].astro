---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import TaxonomyTree from '../../components/TaxonomyTree.astro'
import TaxonomyViewToggle from '../../components/TaxonomyViewToggle.tsx'
import UcscCladeList from '../../components/UcscCladeList.astro'
import UcscStatusBanner from '../../components/UcscStatusBanner.astro'
import { taxonomyPaths } from '../../lib/hubPages.ts'
import type { TaxonomyPageProps } from '../../lib/hubPages.ts'
import { ncbiTaxonomyUrl } from '../../lib/externalLinks.ts'

type Props = TaxonomyPageProps

export function getStaticPaths() {
  return taxonomyPaths()
}

const { slug } = Astro.params
const {
  table,
  rowCount,
  speciesData,
  isCategory,
  taxonId,
  precomputedSubtree,
  precomputedLineage,
  ucscDbs,
} = Astro.props

let title: string
let description: string

if (isCategory) {
  title = slug.charAt(0).toUpperCase() + slug.slice(1)
  description = `Browse ${title} genome assemblies from the GenArk collection`
} else {
  // For taxonomy pages, use precomputed subtree data
  title = precomputedSubtree?.name || `Taxonomy ID: ${taxonId}`
  description = `Browse genome assemblies for ${title} (NCBI Taxonomy ID: ${taxonId})`
}
---

<Layout
  title={`Taxonomy - ${title}`}
  description={description}
>
  <Container wide>
    <UcscStatusBanner />
    {isCategory ? (
      <div class="page-header">
        <h1 class="page-title">GenArk taxonomy - {title}</h1>
        <a
          href={`/hubs/${slug}/`}
          class="hubs-link"
        >
          View list of species as table for {title}
        </a>
      </div>
    ) : (
      <div class="page-header">
        <h1 class="page-title">{title}</h1>
      </div>
    )}

    {precomputedLineage && precomputedLineage.length > 0 && (
      <div class="lineage-container">
        <div class="lineage-label">Taxonomy:</div>
        <div class="lineage-breadcrumbs">
          {precomputedLineage.slice(0, -1).map(node => (
            <>
              <a
                href={`/taxonomy/${node.taxonId}/`}
                class="lineage-link"
              >
                {node.name || 'Unnamed'}
              </a>
              <span class="lineage-separator">›</span>
            </>
          ))}
          <span class="lineage-current">
            {precomputedLineage[precomputedLineage.length - 1]?.name ||
              'Unnamed'}
          </span>
        </div>
      </div>
    )}

    {taxonId && (
      <div class="taxonomy-info-container">
        <div class="taxonomy-info-label">Taxonomy information:</div>
        <a
          href={ncbiTaxonomyUrl(taxonId)}
          target="_blank"
          rel="noopener noreferrer"
          class="taxonomy-info-link"
        >
          View on NCBI (taxonomy ID: {taxonId})
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            style="display: inline-block; vertical-align: middle; margin-left: 4px;"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line
              x1="10"
              y1="14"
              x2="21"
              y2="3"
            />
          </svg>
        </a>
      </div>
    )}

    <UcscCladeList rows={ucscDbs} />

    <TaxonomyViewToggle
      table={table}
      treeContainerId="taxonomy-tree-container"
      accessionCount={rowCount}
      client:idle
    />
    <TaxonomyTree
      speciesData={speciesData}
      subtree={precomputedSubtree}
    />
    {/* The toggle island reads ?view= after it hydrates, so a ?view=table link
        would paint the whole tree and then hide it. This runs while the parser
        is still on this element, before the tree has been painted once. */}
    <script is:inline>
      if (new URLSearchParams(location.search).get('view') === 'table') {
        var tree = document.getElementById('taxonomy-tree-container')
        if (tree) {
          tree.style.display = 'none'
        }
      }
    </script>
  </Container>
</Layout>

<style>
  .lineage-container {
    background-color: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .lineage-label {
    font-weight: 600;
    color: var(--text);
    font-size: var(--text-md);
  }

  .lineage-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--text-md);
  }

  .lineage-link {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  .lineage-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .lineage-separator {
    color: var(--faint);
    user-select: none;
  }

  .lineage-current {
    color: var(--text);
    font-weight: 600;
  }

  .taxonomy-info-container {
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .taxonomy-info-label {
    font-weight: 600;
    color: #1e40af;
    font-size: var(--text-md);
  }

  .taxonomy-info-link {
    color: var(--accent);
    text-decoration: none;
    font-size: var(--text-md);
    display: inline-flex;
    align-items: center;
    transition: color 0.2s;
  }

  .taxonomy-info-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .page-header {
    margin-bottom: 16px;
    display: flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .page-title {
    margin: 0;
  }

  .hubs-link {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
