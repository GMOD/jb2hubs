---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import TaxonomyPage from '../../components/TaxonomyPage.tsx'

export async function getStaticPaths() {
  // Only generate category pages (archaea, bacteria, birds, etc.).
  // Individual taxon ID pages (numeric slugs) are served by taxonomy/index.astro
  // via nginx try_files, and load their data from /taxonomy-data/{id}.json.
  const modules = import.meta.glob('../../../processedHubJson/*.json')
  const paths = (
    await Promise.all(
      Object.entries(modules).map(async ([filepath]) => {
        const slug = filepath.split('/').pop()!.replace('.json', '')
        if (slug === 'all') return undefined
        return { params: { slug }, props: { slug } }
      }),
    )
  ).filter(Boolean)
  return paths
}

const { slug } = Astro.params
const title = slug.charAt(0).toUpperCase() + slug.slice(1)
---

<Layout
  title={`Taxonomy - ${title}`}
  description={`Browse ${title} genome assemblies from the GenArk collection`}
>
  <Container wide>
    <div style="margin-bottom: 0.5rem">
      <a href={`/hubs/${slug}`} style="font-size: 0.9rem; color: #2563eb">
        View {title} species as table →
      </a>
    </div>
    <TaxonomyPage slug={slug} client:only="react" />
  </Container>
</Layout>
