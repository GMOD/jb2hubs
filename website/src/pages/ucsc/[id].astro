---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import UcscStatusBanner from '../../components/UcscStatusBanner.tsx'
import { jbrowseUrl, ucscConfigPath } from '../../config/jbrowse.ts'
import { ucscBrowserUrl, ucscGatewayUrl } from '../../lib/externalLinks.ts'
import { ucscPageLinks } from '../../utils/accessionData.ts'
import type { UcscGenomeEntry } from '../../utils/accessionData.ts'

interface Props {
  ret: UcscGenomeEntry
  // The GenArk accession pages and the taxonomy page this db can link to —
  // only ones that exist, so nothing here is a link to a 404.
  accessions: string[]
  taxonomyPage: boolean
}

export function getStaticPaths() {
  return Object.entries(ucscPageLinks()).map(
    ([id, { genome, accessions, taxonomyPage }]) => ({
      params: { id },
      props: { ret: genome, accessions, taxonomyPage } satisfies Props,
    }),
  )
}

const { id } = Astro.params
const { ret, accessions, taxonomyPage } = Astro.props

// These ~250 pages carried the bare db name as their whole <title> and no
// description at all, so a search result for "hg38" read as just "hg38" with
// whatever text the crawler scraped. Same treatment the accession pages got:
// name the organism and the assembly, and say what the page offers.
const pageTitle = `${ret.scientificName} — UCSC ${id}`
const pageDescription = [
  `${ret.scientificName}${ret.organism ? ` (${ret.organism})` : ''}, UCSC genome`,
  `browser assembly ${id}${ret.description ? ` — ${ret.description}` : ''}.`,
  'Open it in the JBrowse 2 genome browser, or follow through to UCSC.',
].join(' ')
---

<Layout
  title={pageTitle}
  description={pageDescription}
>
  <Container>
    <UcscStatusBanner client:idle />
    <div class="relative">
      <h1>{ret.scientificName}</h1>

      <div>
        <b>Description:</b>
        {ret.description}
      </div>
      <div>
        <b>Assembly name:</b>
        {id}
      </div>
      <div>
        <b>Common name:</b>
        {ret.organism}
      </div>
      <div>
        <b>Taxonomy ID:</b>
        {
          taxonomyPage ? (
            <a href={`/taxonomy/${ret.taxId}`}>{ret.taxId}</a>
          ) : (
            ret.taxId
          )
        }
      </div>
      {
        accessions.length > 0 && (
          <div>
            <b>NCBI accession:</b>
            {accessions.map((accession, i) => (
              <>
                {i > 0 ? ', ' : ''}
                <a href={`/accession/${accession}`}>{accession}</a>
              </>
            ))}
          </div>
        )
      }
    </div>

    <div>
      <h2>Genome browsers</h2>
      <ul>
        <li>
          <a href={jbrowseUrl(ucscConfigPath(id))}> JBrowse </a>
        </li>
        <li>
          <a href={ucscBrowserUrl(id)}>UCSC</a>
        </li>
      </ul>
    </div>

    <div>
      <h2>Portals/data downloads</h2>
      <ul>
        <li>
          <a href={ucscGatewayUrl(id)}>UCSC assembly info</a>
        </li>
        {
          taxonomyPage && (
            <li>
              <a href={`/taxonomy/${ret.taxId}`}>
                Other assemblies of this species (GenArk taxonomy)
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </Container>
</Layout>
