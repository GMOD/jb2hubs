---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import UcscStatusBanner from '../../components/UcscStatusBanner.tsx'
import list from '../../list.json'
import { jbrowseUrl, ucscConfigPath } from '../../config/jbrowse.ts'
import { ucscBrowserUrl, ucscGatewayUrl } from '../../lib/externalLinks.ts'

export async function getStaticPaths() {
  const genomes = list.ucscGenomes
  return (Object.keys(genomes) as Array<keyof typeof genomes>).map(id => ({
    params: { id },
    props: { ret: genomes[id] },
  }))
}

const { id } = Astro.params
const { ret } = Astro.props

// These ~250 pages carried the bare db name as their whole <title> and no
// description at all, so a search result for "hg38" read as just "hg38" with
// whatever text the crawler scraped. Same treatment the accession pages got:
// name the organism and the assembly, and say what the page offers.
const pageTitle = `${ret.scientificName} — UCSC ${id}`
const pageDescription = [
  `${ret.scientificName}${ret.organism ? ` (${ret.organism})` : ''}, UCSC genome`,
  `browser assembly ${id}${ret.description ? ` — ${ret.description}` : ''}.`,
  'Open it in the JBrowse 2 genome browser, or follow through to UCSC.',
].join(' ')
---

<Layout
  title={pageTitle}
  description={pageDescription}
>
  <Container>
    <UcscStatusBanner client:idle />
    <div class="relative">
      <h1>{ret.scientificName}</h1>

      <div>
        <b>Description:</b>
        {ret.description}
      </div>
      <div>
        <b>Assembly name:</b>
        {id}
      </div>
      <div>
        <b>Common name:</b>
        {ret.organism}
      </div>
    </div>

    <div>
      <h2>Genome browsers</h2>
      <ul>
        <li>
          <a href={jbrowseUrl(ucscConfigPath(id))}> JBrowse </a>
        </li>
        <li>
          <a href={ucscBrowserUrl(id)}>UCSC</a>
        </li>
      </ul>
    </div>

    <div>
      <h2>Portals/data downloads</h2>
      <ul>
        <li>
          <a href={ucscGatewayUrl(id)}>UCSC assembly info</a>
        </li>
      </ul>
    </div>
  </Container>
</Layout>
