---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import list from '../../list.json'
import { jbrowseUrl, ucscConfigPath } from '../../config/jbrowse.ts'

export async function getStaticPaths() {
  const genomes = list.ucscGenomes
  return (Object.keys(genomes) as Array<keyof typeof genomes>).map(id => ({
    params: { id },
    props: { ret: genomes[id] },
  }))
}

const { id } = Astro.params
const { ret } = Astro.props

const title = id
---

<Layout title={title}>
  <Container>
    <div class="relative">
      <h1>{ret.scientificName}</h1>

      <div>
        <b>Description:</b>
        {ret.description}
      </div>
      <div>
        <b>Assembly name:</b>
        {id}
      </div>
      <div>
        <b>Common name:</b>
        {ret.organism}
      </div>
    </div>

    <div>
      <h2>Genome browsers</h2>
      <ul>
        <li>
          <a href={jbrowseUrl(ucscConfigPath(id))}> JBrowse </a>
        </li>
        <li>
          <a href={`https://genome.ucsc.edu/cgi-bin/hgTracks?db=${id}`}>
            UCSC
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2>Portals/data downloads</h2>
      <ul>
        <li>
          <a href={`https://genome.ucsc.edu/cgi-bin/hgGateway?db=${id}`}>
            UCSC assembly info
          </a>
        </li>
      </ul>
    </div>
  </Container>
</Layout>
