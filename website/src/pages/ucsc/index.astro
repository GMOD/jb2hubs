---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import UCSCTable from '../../components/UCSCTable.tsx'
import type { UcscRow } from '../../components/UCSCTable.tsx'
import UcscStatusBanner from '../../components/UcscStatusBanner.tsx'
import { jbrowseUrl, ucscConfigPath } from '../../config/jbrowse.ts'
import { ucscBrowserUrl } from '../../lib/externalLinks.ts'
import list from '../../list.json'

const rows: UcscRow[] = Object.entries(list.ucscGenomes)
  .sort(([, a], [, b]) => a.orderKey - b.orderKey)
  .map(([key, val]) => ({
    name: key,
    scientificName: val.scientificName,
    organism: val.organism,
    description: val.description,
    year: Number(/\b(?:19|20)\d{2}\b/.exec(val.description)?.[0] ?? 0),
    jbrowseLink: jbrowseUrl(ucscConfigPath(key)),
    ucscLink: ucscBrowserUrl(key),
  }))
---

<Layout
  title="UCSC genome browsers in JBrowse 2"
  description="Every main assembly from the UCSC genome browser, converted to a JBrowse 2 config — search by db name, species or description, or open all of them in one instance."
>
  <Container wide>
    <UcscStatusBanner client:idle />
    <UCSCTable
      rows={rows}
      client:load
    />
  </Container>
</Layout>
