---
import Layout from '../../layouts/Layout.astro'
import Container from '../../components/Container.astro'
import UCSCTable from '../../components/UCSCTable.tsx'
import UcscStatusBanner from '../../components/UcscStatusBanner.astro'
import { ucscRows } from '../../lib/ucscRows.ts'

const rows = ucscRows()
---

<Layout
  title="UCSC genome browsers in JBrowse 2"
  description="Every main assembly from the UCSC genome browser, converted to a JBrowse 2 config — search by db name, species or description, or open all of them in one instance."
>
  <Container wide>
    <UcscStatusBanner />
    <UCSCTable
      rows={rows}
      client:load
    />
  </Container>
</Layout>
