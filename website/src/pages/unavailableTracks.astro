---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import { readFile } from 'fs/promises'
import { join } from 'path'
import '../styles/common-table.css'

// Read blockedFiles.json from project root
const blockedFilesPath = join(process.cwd(), 'blockedFiles.json')
const blockedData = JSON.parse(
  await readFile(blockedFilesPath, 'utf-8'),
) as Record<
  string,
  { blocked: boolean; lastChecked: number; trackName?: string }
>

// Filter only blocked files and include timestamp and trackName
const files = Object.entries(blockedData)
  .filter(([_, value]) => value.blocked)
  .map(([url, value]) => ({
    url,
    lastChecked: value.lastChecked,
    trackName: value.trackName,
  }))
  .sort((a, b) => b.lastChecked - a.lastChecked)

// Read removedTracks.json from project root
const removedTracksPath = join(process.cwd(), 'removedTracks.json')

const removedTracks = JSON.parse(
  await readFile(removedTracksPath, 'utf-8'),
) as Array<{
  trackId: string
  name: string
  reason: string
  assembly: string
}>

// Format timestamp for display
function formatDate(timestamp: number): string {
  return new Date(timestamp).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

<Layout>
  <Container>
    <h3>Unavailable tracks</h3>
    <p>
      This is a list of tracks that are available at UCSC, but which we were not
      able to download, generally due to licensing restrictions. See <a
        href="https://genome.ucsc.edu/license/"
      >
        https://genome.ucsc.edu/license/
      </a> for more info. Please get in touch if you are interested in seeing these
      tracks and maybe something can be done.
    </p>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>File Path</th>
          <th>Track Name</th>
          <th>Last Checked</th>
        </tr>
      </thead>
      <tbody>
        {
          files.map((file, index) => (
            <tr>
              <td>{index + 1}</td>
              <td>{file.url}</td>
              <td>{file.trackName ?? '-'}</td>
              <td>{formatDate(file.lastChecked)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h3 style="margin-top: 3rem;">Filtered tracks</h3>
    <p>
      Some tracks were intentionally excluded because they require specialized
      handling or because they would 'bloat' the config. If you would like to
      see any of these tracks added, please{' '}
      <a href="https://jbrowse.org/jb2/contact/">contact us</a>{' '}
      or{' '}
      <a href="https://github.com/GMOD/jb2hubs">open an issue here</a>.
    </p>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Assembly</th>
          <th>Track ID</th>
          <th>Track Name</th>
          <th>Reason</th>
        </tr>
      </thead>
      <tbody>
        {
          removedTracks.map((track, index) => (
            <tr>
              <td>{index + 1}</td>
              <td>{track.assembly}</td>
              <td>{track.trackId}</td>
              <td>{track.name}</td>
              <td>{track.reason}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Container>
</Layout>
