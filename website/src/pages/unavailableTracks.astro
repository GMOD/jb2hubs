---
import Layout from '../layouts/Layout.astro'
import Container from '../components/Container.astro'
import { readFile } from 'fs/promises'
import { join } from 'path'
import '../styles/common-table.css'

// Both files are symlinks into ucsc2jbrowse/, where make.sh deletes them at the
// start of a run and mergeFileAccessCache.ts / mergeRemovedTracks.ts rewrite
// them at the end. A build that lands inside that window must not fail on
// ENOENT; it renders the page with a note instead.
async function readJsonIfPresent(name: string) {
  const path = join(process.cwd(), name)
  return readFile(path, 'utf-8').then(
    text => JSON.parse(text) as unknown,
    () => undefined,
  )
}

// blockedFiles.json holds the blocked entries only — the accessible ones stay
// in ucsc2jbrowse/fileAccessCache/
const blockedJson = await readJsonIfPresent('blockedFiles.json')
const blockedData = (blockedJson ?? {}) as Record<
  string,
  { blocked: boolean; lastChecked: number; trackName?: string }
>

// The blocked filter is redundant against a freshly merged file, but a checkout
// whose blockedFiles.json predates the split still holds accessible entries
const files = Object.entries(blockedData)
  .filter(([_, value]) => value.blocked)
  .map(([url, value]) => ({
    url,
    lastChecked: value.lastChecked,
    trackName: value.trackName,
  }))
  .sort((a, b) => b.lastChecked - a.lastChecked)

const removedJson = await readJsonIfPresent('removedTracks.json')
const removedTracks = (removedJson ?? []) as Array<{
  trackId: string
  name: string
  reason: string
  assembly: string
}>
const dataBeingRegenerated =
  blockedJson === undefined || removedJson === undefined

// 41K individual filtered tracks made this a 7.9MB document, and an
// undifferentiated list of them answers nobody's question. What a visitor wants to
// know is which kinds of track are missing and from which assembly, so aggregate
// on both. The per-track detail stays in the repo.
const byReason = new Map<string, { tracks: number; assemblies: Set<string> }>()
const byAssembly = new Map<string, number>()
for (const track of removedTracks) {
  const reason = byReason.get(track.reason) ?? {
    tracks: 0,
    assemblies: new Set<string>(),
  }
  reason.tracks += 1
  reason.assemblies.add(track.assembly)
  byReason.set(track.reason, reason)
  byAssembly.set(track.assembly, (byAssembly.get(track.assembly) ?? 0) + 1)
}

const reasonRows = [...byReason.entries()].sort(
  (a, b) => b[1].tracks - a[1].tracks,
)
const assemblyRows = [...byAssembly.entries()].sort((a, b) => b[1] - a[1])

// Format timestamp for display
function formatDate(timestamp: number): string {
  return new Date(timestamp).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

<Layout
  title="Tracks not available here"
  description="UCSC genome browser tracks that are not mirrored on this site, and why — most are files UCSC does not redistribute under its own license."
>
  <Container>
    <h3>Unavailable tracks</h3>
    {
      dataBeingRegenerated && (
        <p>
          The pipeline is regenerating this list; it is incomplete until the
          next site build.
        </p>
      )
    }
    <p>
      This is a list of tracks that are available at UCSC, but which we were not
      able to download, generally due to licensing restrictions. See <a
        href="https://genome.ucsc.edu/license/"
      >
        https://genome.ucsc.edu/license/
      </a> for more info. Please get in touch if you are interested in seeing these
      tracks and maybe something can be done.
    </p>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>File Path</th>
          <th>Track Name</th>
          <th>Last Checked</th>
        </tr>
      </thead>
      <tbody>
        {
          files.map((file, index) => (
            <tr>
              <td>{index + 1}</td>
              <td>{file.url}</td>
              <td>{file.trackName ?? '-'}</td>
              <td>{formatDate(file.lastChecked)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h3 style="margin-top: 3rem;">Filtered tracks</h3>
    <p>
      Some tracks were intentionally excluded because they require specialized
      handling or because they would 'bloat' the config. {
        removedTracks.length.toLocaleString()
      } tracks are filtered across {assemblyRows.length} assemblies, for {
        reasonRows.length
      } reasons. If you would like to see any of these tracks added, please{' '}
      <a href="https://jbrowse.org/jb2/contact/">contact us</a>{' '}
      or{' '}
      <a href="https://github.com/GMOD/jb2hubs">open an issue here</a>.
    </p>

    <h4>By reason</h4>
    <table>
      <thead>
        <tr>
          <th scope="col">Reason</th>
          <th scope="col">Tracks</th>
          <th scope="col">Assemblies</th>
        </tr>
      </thead>
      <tbody>
        {
          reasonRows.map(([reason, { tracks, assemblies }]) => (
            <tr>
              <td>{reason}</td>
              <td>{tracks.toLocaleString()}</td>
              <td>{assemblies.size}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h4>By assembly</h4>
    <table>
      <thead>
        <tr>
          <th scope="col">Assembly</th>
          <th scope="col">Tracks filtered</th>
        </tr>
      </thead>
      <tbody>
        {
          assemblyRows.map(([assembly, tracks]) => (
            <tr>
              <td>
                <a href={`/ucsc/${assembly}`}>{assembly}</a>
              </td>
              <td>{tracks.toLocaleString()}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p>
      The full per-track list lives in{' '}
      <a
        href="https://github.com/GMOD/jb2hubs/blob/main/ucsc2jbrowse/removedTracks.json"
        >removedTracks.json</a
      >.
    </p>
  </Container>
</Layout>
